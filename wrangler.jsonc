{
  // Must match the real Cloudflare Pages project name, or wrangler CLI
  // commands (secrets, deploys) fail with "Project does not exist".
  "name": "montessori",
  "compatibility_date": "2026-04-11",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "montessori-db",
      "database_id": "0e13fe96-9ad7-476d-9023-c6e340962065"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "montessori-media"
    }
  ]
}
