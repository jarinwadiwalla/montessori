---
import Card from '../shared/Card.astro';

const features = [
  {
    tag: 'Guidance',
    title: 'Side-by-Side Guidance',
    description: 'Practical virtual and on-site guidance to help you build your Montessori adolescent program, we walk alongside you every step of the way.',
    href: '/support/',
  },
  {
    tag: 'Access',
    title: 'Access & Equity',
    description: 'Bringing Montessori adolescent programming to communities that have never had access, because this work belongs to everyone.',
    href: '/access/',
  },
  {
    tag: 'Approach',
    title: 'Whole-Human Development',
    description: 'Integrating Montessori philosophy with mindfulness, social/emotional learning, and holistic traditions for complete adolescent development.',
    href: '/whole-human/',
  },
];
---

<section class="featured section">
  <div class="container">
    <div class="featured-badges">
      <span class="featured-badge">AMI 12–18 Trained</span>
      <span class="featured-badge">Global Support</span>
    </div>
    <div class="featured-header">
      <p class="featured-eyebrow">What We Do</p>
    </div>
    <div class="featured-grid">
      {features.map((feature) => (
        <Card
          tag={feature.tag}
          title={feature.title}
          description={feature.description}
          href={feature.href}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .featured-badges {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 0.5px solid rgba(208, 144, 91, 0.5);
    border-radius: 2px;
    background: rgba(208, 144, 91, 0.06);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .featured-header {
    margin-bottom: var(--space-2xl);
  }

  .featured-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.85);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .featured-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }
</style>
