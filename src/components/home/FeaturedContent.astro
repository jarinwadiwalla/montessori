---
import Card from '../shared/Card.astro';

const features = [
  {
    tag: 'Community',
    title: 'You Are Not Doing This Alone',
    description: 'The Montessori Adolescent Collective is a collaborative online community for Third Plane Practitioners to connect worldwide. We support one another through a shared resource library, community, and partnerships between our schools.',
    href: '/collective/',
  },
  {
    tag: 'Guidance',
    title: 'Build It With People Who Have Done It',
    description: 'We offer Montessori Adolescent guidance through live webinars, downloadable resources, and 1:1 consulting partnerships.',
    href: '/guidance/',
  },
  {
    tag: 'Access',
    title: 'No Adolescent Should Miss Out',
    description: 'Through fundraising, we provide resources and support to adults working with adolescents worldwide. Our goal is to support teachers in creating environments where adolescents can thrive.',
    href: '/access/',
  },
];
---

<section class="featured section">
  <div class="container">
    <div class="featured-badges">
      <span class="featured-badge">AMI 12–18 Trained</span>
      <span class="featured-badge">Global Support</span>
    </div>
    <div class="featured-header">
      <p class="featured-eyebrow">What We Do</p>
    </div>
    <div class="featured-grid">
      {features.map((feature) => (
        <Card
          tag={feature.tag}
          title={feature.title}
          description={feature.description}
          href={feature.href}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .featured-badges {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 0.5px solid rgba(208, 144, 91, 0.5);
    border-radius: 2px;
    background: rgba(208, 144, 91, 0.06);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .featured-header {
    margin-bottom: var(--space-2xl);
  }

  .featured-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.85);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .featured-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }
</style>
