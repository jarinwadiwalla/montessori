---
interface Props {
  formspreeId?: string;
}

const { formspreeId = 'xpqjyzba' } = Astro.props;
---

<form
  id="contact-form"
  data-formspree={`https://formspree.io/f/${formspreeId}`}
  class="contact-form"
>
  <div class="form-row">
    <div class="form-group">
      <label for="name" class="form-label">Name</label>
      <input type="text" id="name" name="name" required class="form-input" />
    </div>
    <div class="form-group">
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" name="email" required class="form-input" />
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="phone" class="form-label">Phone <span class="form-optional">(optional)</span></label>
      <input type="tel" id="phone" name="phone" class="form-input" />
    </div>
    <div class="form-group">
      <label for="organization" class="form-label">Organization <span class="form-optional">(optional)</span></label>
      <input type="text" id="organization" name="organization" class="form-input" />
    </div>
  </div>

  <div class="form-group">
    <label for="message" class="form-label">Message</label>
    <textarea id="message" name="message" rows="6" required class="form-input form-textarea"></textarea>
  </div>

  <div class="form-submit-wrapper">
    <button type="submit" class="form-submit">
      Send Message
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/>
        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </div>
  <p class="form-status" id="form-status"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const button = form.querySelector('.form-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    button.textContent = 'Sending...';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const response = await fetch(form.dataset.formspree!, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        status.textContent = 'Thank you! Your message has been sent.';
        status.classList.add('form-status--success');
      } else {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('form-status--error');
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.classList.add('form-status--error');
    }

    button.disabled = false;
    button.textContent = 'Send Message';
  });
</script>

<style>
  .contact-form {
    width: 100%;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .form-group {
    margin-bottom: var(--space-2xl);
  }

  .form-label {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-sm);
  }

  .form-optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-text-light);
    font-size: 10px;
  }

  .form-input {
    width: 100%;
    padding: var(--space-sm) 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    transition: border-color 0.2s;
    appearance: none;
  }

  .form-input:focus {
    outline: none;
    border-bottom-color: #d0905b;
  }

  .form-textarea {
    resize: none;
    min-height: 120px;
    padding: var(--space-md) var(--space-sm);
    border: 1px solid #ffffff;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.7);
  }

  .form-textarea:focus {
    border-color: rgba(208, 144, 91, 0.5);
    outline: none;
    border-bottom-color: rgba(208, 144, 91, 0.5);
  }

  .form-submit-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 2.5rem;
    background: var(--color-earth-dark);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .form-submit:hover {
    opacity: 0.85;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-status {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    text-align: center;
  }

  .form-status--success { color: var(--color-sage); }
  .form-status--error   { color: var(--color-terracotta); }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
