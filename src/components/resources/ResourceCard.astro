---
interface Props {
  title: string;
  description: string;
  category: string;
  downloadUrl: string;
  publishDate: Date;
  buttonLabel?: string;
  featured?: boolean;
}

const { title, description, category, downloadUrl, publishDate, buttonLabel = 'Download', featured = false } = Astro.props;

const categoryLabels: Record<string, string> = {
  guide: 'Guide',
  worksheet: 'Worksheet',
  research: 'Research',
  toolkit: 'Toolkit',
};

const isAvailable = downloadUrl.startsWith('http') || downloadUrl.startsWith('/');
---

<article class={`resource-card ${featured ? 'resource-card--featured' : ''}`}>
  <div class="resource-top">
    <span class="resource-category">{categoryLabels[category] || category}</span>
  </div>
  <h3 class="resource-title">{title}</h3>
  <p class="resource-description">{description}</p>
  <div class="resource-footer">
    {isAvailable ? (
      <a href={downloadUrl} target="_blank" rel="noopener noreferrer" class="download-btn">
        {buttonLabel}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </a>
    ) : (
      <span class="coming-soon">Coming Soon</span>
    )}
  </div>
</article>

<style>
  .resource-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 3px solid #d0905b;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .resource-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .resource-card--featured {
    border-top-color: var(--color-purple);
    background: var(--color-cream);
  }

  .resource-top {
    margin-bottom: var(--space-md);
  }

  .resource-category {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.9);
  }

  .resource-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-xl);
    font-weight: 300;
    color: var(--color-earth-dark);
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }

  .resource-description {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin-bottom: var(--space-xl);
  }

  .resource-footer {
    margin-top: auto;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(75, 55, 55, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s, color 0.2s;
  }

  .download-btn:hover {
    color: #d0905b;
    border-color: #d0905b;
  }

  .coming-soon {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-light);
    opacity: 0.5;
  }
</style>
