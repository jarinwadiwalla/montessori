---
// Shared top bar for the signed-in areas of the Collective.
// The member name/avatar are filled in by each page's script once
// /api/community/me returns.
interface Props {
  active: 'board' | 'events' | 'members' | 'alerts';
}
const { active } = Astro.props;
---

<header class="portal-bar">
  <div class="portal-me">
    <img class="me-avatar" id="me-avatar" alt="" hidden />
    <span id="me-name"></span>
  </div>

  <nav class="portal-nav" aria-label="Collective">
    <a href="/collective/portal/" class={active === 'board' ? 'is-active' : ''}>Board</a>
    <a href="/collective/events/" class={active === 'events' ? 'is-active' : ''}>Events</a>
    <a href="/collective/members/" class={active === 'members' ? 'is-active' : ''}>Members</a>
    <a
      href="/collective/alerts/"
      class:list={['alerts-link', { 'is-active': active === 'alerts' }]}
    >
      Alerts<span class="alert-count" id="alert-count" hidden></span>
    </a>
    <a href="/collective/guidelines/">Guidelines</a>
    <a href="/collective/portal/?edit=1">Edit profile</a>
    <button id="billing-btn" class="link-btn" type="button" hidden>Billing</button>
    <button id="signout-btn" class="link-btn" type="button">Sign out</button>
  </nav>
</header>

<script>
  // Unread alert badge. The count rides along on /api/community/me, which
  // this component already calls, so it costs no extra request.
  function showAlertCount(n: number) {
    const badge = document.getElementById('alert-count');
    if (!badge) return;
    if (n > 0) {
      badge.textContent = String(n > 99 ? '99+' : n);
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  // Shown only to members who actually pay dues — comped members have no
  // Stripe customer and nothing to manage.
  const billingBtn = document.getElementById('billing-btn') as HTMLButtonElement | null;

  // One call feeds both the badge and the billing button.
  fetch('/api/community/me')
    .then((r) => r.json())
    .then((me) => {
      showAlertCount(me?.unread || 0);
      if (billingBtn && me?.membership?.has_billing) billingBtn.hidden = false;
    })
    .catch(() => {});

  if (billingBtn) {
    billingBtn.addEventListener('click', async () => {
      billingBtn.disabled = true;
      try {
        const res = await fetch('/api/community/billing', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.url) {
          window.location.href = data.url;
          return;
        }
        window.alert(data.error || 'Could not open the billing page.');
      } catch {
        window.alert('Could not reach the server. Please try again.');
      } finally {
        billingBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .portal-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .portal-me {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 500;
    color: var(--color-purple);
  }

  .me-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .portal-nav {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    flex-wrap: wrap;
  }

  .portal-nav a,
  .link-btn {
    background: none;
    border: none;
    color: var(--color-text-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: none;
    padding: 0;
  }

  .portal-nav a:hover,
  .link-btn:hover {
    color: var(--color-purple);
  }

  .alerts-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .alert-count {
    background: var(--color-terracotta);
    color: var(--color-white);
    font-size: 0.65rem;
    line-height: 1;
    min-width: 1.1rem;
    padding: 0.2rem 0.3rem;
    border-radius: 999px;
    text-align: center;
    font-weight: 600;
  }

  .portal-nav a.is-active {
    color: var(--color-purple);
    font-weight: 500;
    border-bottom: 2px solid var(--color-terracotta);
  }
</style>
