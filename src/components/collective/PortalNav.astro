---
// Left-hand sidebar for the signed-in areas of the Collective — the
// Circle-style layout: spaces and pages down the left, content on the
// right, no top tab bar. On phones it collapses to a horizontal strip.
//
// The member name/avatar are filled in by each page's script once
// /api/community/me returns.
interface Props {
  active:
    | 'board'
    | 'start-here'
    | 'say-hello'
    | 'announcements'
    | 'events'
    | 'resources'
    | 'blog'
    | 'members'
    | 'alerts';
}
const { active } = Astro.props;

const cls = (name: string) => (active === name ? 'is-active' : '');
---

<aside class="portal-side">
  <div class="portal-me">
    <img class="me-avatar" id="me-avatar" alt="" hidden />
    <span id="me-name"></span>
  </div>

  <nav class="portal-nav" aria-label="Collective">
    <a href="/collective/portal/" class={cls('board')}>Feed</a>

    <p class="side-heading">The Collective</p>
    <a href="/collective/start-here/" class={cls('start-here')}>Start here</a>
    <a href="/collective/portal/?space=say-hello" class={cls('say-hello')} data-keep-space>Say hello</a>
    <a href="/collective/portal/?space=announcements" class={cls('announcements')} data-keep-space>Announcements</a>
    <a href="/collective/events/" class={cls('events')}>Events</a>

    <p class="side-heading">Library</p>
    <a href="/collective/resources/" class={cls('resources')}>Shared Resources</a>
    <a href="/collective/blog/" class={cls('blog')}>MFA Blog</a>

    <p class="side-heading">People</p>
    <!-- Direct messages live inside Members rather than as a destination of
         their own: the board is the point of this place, and a Messages tab
         in the main nav quietly competes with it. The badge still rides here
         so an unread message can't go unnoticed. -->
    <a href="/collective/members/" class:list={['alerts-link', cls('members')]}>
      Members<span class="alert-count" id="message-count" hidden></span>
    </a>
    <a href="/collective/alerts/" class:list={['alerts-link', cls('alerts')]}>
      Notifications<span class="alert-count" id="alert-count" hidden></span>
    </a>

    <div class="side-footer">
      <a href="/collective/guidelines/">Guidelines</a>
      <a href="/collective/portal/" data-edit-profile>Edit profile</a>
      <button id="billing-btn" class="link-btn" type="button" hidden>Billing</button>
      <button id="signout-btn" class="link-btn" type="button">Sign out</button>
    </div>
  </nav>
</aside>

<script>
  // "Edit profile" used to be /collective/portal/?edit=1. A URL that opens
  // the editor is sticky: refresh it, or let the browser autocomplete it
  // later, and you land back in the editor looking trapped. The intent is
  // now recorded for one navigation only and cannot be bookmarked.
  //
  // Delegated from the document so it also catches the link on the members
  // page, not just the one in this nav.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element)?.closest?.('[data-edit-profile]');
    if (link) sessionStorage.setItem('apc_edit_profile', '1');
  });

  // Unread alert badge. The count rides along on /api/community/me, which
  // this component already calls, so it costs no extra request.
  function showCount(id: string, n: number) {
    const badge = document.getElementById(id);
    if (!badge) return;
    if (n > 0) {
      badge.textContent = String(n > 99 ? '99+' : n);
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  // Shown only to members who actually pay dues — comped members have no
  // Stripe customer and nothing to manage.
  const billingBtn = document.getElementById('billing-btn') as HTMLButtonElement | null;

  // One call feeds both the badge and the billing button.
  fetch('/api/community/me')
    .then((r) => r.json())
    .then((me) => {
      showCount('alert-count', me?.unread || 0);
      showCount('message-count', me?.unreadMessages || 0);
      if (billingBtn && me?.membership?.has_billing) billingBtn.hidden = false;
    })
    .catch(() => {});

  if (billingBtn) {
    billingBtn.addEventListener('click', async () => {
      billingBtn.disabled = true;
      try {
        const res = await fetch('/api/community/billing', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.url) {
          window.location.href = data.url;
          return;
        }
        window.alert(data.error || 'Could not open the billing page.');
      } catch {
        window.alert('Could not reach the server. Please try again.');
      } finally {
        billingBtn.disabled = false;
      }
    });
  }

  // Highlight the space links when the board is filtered to their space.
  // Astro renders this nav statically, so the query string has to be
  // matched here rather than at build time.
  const params = new URLSearchParams(window.location.search);
  const activeSpace = params.get('space');
  if (activeSpace && window.location.pathname.startsWith('/collective/portal')) {
    document.querySelectorAll('.portal-nav a').forEach((a) => {
      const href = a.getAttribute('href') || '';
      a.classList.toggle('is-active', href.endsWith(`space=${activeSpace}`));
    });
  }
</script>

<style is:global>
  /* The hidden attribute must always win. Without this, any element whose
     class sets a display (flex, grid…) stays visible despite hidden="" —
     which is exactly how the profile editor haunted every sign-in. */
  [hidden] {
    display: none !important;
  }

  /* The sidebar's parent (whatever wrapper each page puts it in) becomes
     a two-column grid: sidebar left, everything else right. */
  :where(div, section):has(> .portal-side) {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    column-gap: var(--space-3xl);
    align-items: start;
  }

  /* Compact page heading used instead of the old full-width hero. */
  .portal-page-head {
    margin-bottom: var(--space-xl);
  }

  .portal-page-head h1 {
    margin: 0 0 0.25rem;
    font-size: var(--text-2xl);
  }

  .portal-page-head p {
    margin: 0;
    color: var(--color-text-light);
  }

  :where(div, section):has(> .portal-side) > :not(.portal-side) {
    grid-column: 2;
  }

  .portal-side {
    grid-column: 1;
    grid-row: 1 / span 100;
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
  }

  @media (max-width: 820px) {
    :where(div, section):has(> .portal-side) {
      display: block;
    }
    .portal-side {
      position: static;
      margin-bottom: var(--space-lg);
    }
  }
</style>

<style>
  .portal-me {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 500;
    color: var(--color-purple);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-md);
    overflow-wrap: anywhere;
  }

  .me-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .portal-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .side-heading {
    margin: var(--space-lg) 0 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .portal-nav a,
  .link-btn {
    background: none;
    border: none;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    cursor: pointer;
    text-decoration: none;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
  }

  .portal-nav a:hover,
  .link-btn:hover {
    color: var(--color-purple);
    background: rgba(63, 38, 91, 0.06);
  }

  .portal-nav a.is-active {
    color: var(--color-purple);
    font-weight: 600;
    background: rgba(63, 38, 91, 0.08);
  }

  .alerts-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .alert-count {
    background: var(--color-terracotta);
    color: var(--color-white);
    font-size: 0.65rem;
    line-height: 1;
    min-width: 1.1rem;
    padding: 0.2rem 0.3rem;
    border-radius: 999px;
    text-align: center;
    font-weight: 600;
  }

  .side-footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .side-footer a,
  .side-footer .link-btn {
    color: var(--color-text-light);
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .portal-nav {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-xs);
    }
    .side-heading {
      display: none;
    }
    .side-footer {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-md);
      margin-top: var(--space-xs);
      border-top: none;
      padding-top: 0;
      width: 100%;
    }
  }
</style>
