---
// The full Collective landing page, kept intact while the public page shows
// "Coming soon". Nothing here is live yet — flip OPEN in
// src/pages/collective/index.astro to put it back, and this returns exactly
// as it was.
const monthlyPrice = 5;
const annualPrice = 50; // 12 months for the price of 10
const monthlyLink = 'https://buy.stripe.com/00wbJ11MO0lsdwc7kf4sE09';
const annualLink = 'https://buy.stripe.com/8x2aEX2QS2tAeAg4834sE0b';

const annualFull = monthlyPrice * 12;
const annualSaving = annualFull - annualPrice;

const donateLink = 'https://buy.stripe.com/fZuaEXcrsgkq77OcEz4sE05';

// Three fixed tiers, each its own fixed-price Payment Link. Smaller gifts
// go through the ghost pill below them, which uses donateLink.
const sponsorOne = 'https://buy.stripe.com/6oU6oH2QSd8edwcdID4sE0f';
const sponsorThree = 'https://buy.stripe.com/9B6eVd778c4afEkeMH4sE0e';
const sponsorTen = 'https://buy.stripe.com/8x28wP634gkqeAg9sn4sE0g';

// donateLink is a $10 item whose quantity the giver can raise at checkout,
// so it doubles as the small-gift option.
const smallAmount = 10;
---

<div class="container collective">
  <section class="intro">
    <img
      src="/images/collective/logo-chocolate.png"
      alt="The Montessori Adolescent Collective"
      class="collective-logo"
      width="996"
      height="172"
    />
    <p class="tagline">
      A collaborative online community to connect with Third Plane Practitioners worldwide.
    </p>
    <p class="est">Est. 2026</p>
  </section>

  <section class="what">
    <h2>What's inside</h2>
    <div class="what-grid">
      <div class="what-item">
        <h3>Communication board</h3>
        <p>
          Post a question, a plan, a photograph of your space, or a document
          you're working on, and get responses from your fellow practitioners!
        </p>
      </div>
      <div class="what-item">
        <h3>Monthly gatherings</h3>
        <p>
          We meet as a group each month to think out loud together, so bring
          the thing you're stuck on. Dates and joining links live in the Events
          section, with times given for the timezones our members are in.
        </p>
      </div>
      <div class="what-item">
        <h3>Guest presentations</h3>
        <p>
          Sessions will be organized twice a year with relevant topics:
          neuroscience, tech guidelines, philosophy.
        </p>
      </div>
      <div class="what-item">
        <h3>Resource sharing</h3>
        <p>
          A full resource library for collaborative sharing. Members have the
          ability to create new subject folders.
        </p>
      </div>
      <div class="what-item">
        <h3>Exchange &amp; pen pal programmes</h3>
        <p>
          Find the members open to connecting their community with yours, from
          student pen pals to guide-to-guide exchanges. Say you're open to it on
          your profile and you'll appear in the directory.
        </p>
      </div>
      <div class="what-item">
        <h3>In-person retreats</h3>
        <p>
          Time together away from screens. How amazing to meet one another in
          real life and build lifelong relationships!
        </p>
      </div>
    </div>

    <p class="what-note">
      Everything here is members-only. Nothing posted is visible to the public
      web or to search engines, and your email address is never shown to other
      members.
    </p>
  </section>

  <section class="join">
    <p class="join-eyebrow">Membership dues</p>

    <div class="plans">
      <div class="plan">
        <p class="plan-name">Monthly</p>
        <p class="plan-price">${monthlyPrice}<span>/month</span></p>
        <p class="plan-note">Cancel any time, from inside the Collective.</p>
        {monthlyLink ? (
          <a href={monthlyLink} class="btn-join">Join monthly</a>
        ) : (
          <p class="join-pending">Opening shortly</p>
        )}
      </div>

      <div class="plan plan--featured">
        <p class="plan-badge">Save ${annualSaving}</p>
        <p class="plan-name">Yearly</p>
        <p class="plan-price">${annualPrice}<span>/year</span></p>
        <p class="plan-note">
          Twelve months for the price of ten, paid once a year.
        </p>
        {annualLink ? (
          <a href={annualLink} class="btn-join">Join yearly</a>
        ) : (
          <p class="join-pending">Opening shortly</p>
        )}
      </div>
    </div>

    <p class="join-fine">
      Dues are as low as possible and keep the Collective running: from daily
      management to software upkeep. You can switch between monthly and yearly,
      or cancel, at any time. Cancelling leaves your access running until the
      period you've paid for ends.
    </p>
    <p class="join-fine">
      By joining you agree to our <a href="/collective/guidelines/">community guidelines</a>.
    </p>
  </section>

  <section class="sponsor">
    <h2>Sponsor a membership</h2>

    <p class="sponsor-lede">
      Montessori education is revolutionary for adolescents, but support and
      resources are hard to come by. The Montessori Adolescent Collective is a
      community of adolescent guides that support one another with resources,
      problem solving, and building school connections.
    </p>

    <p class="sponsor-lede">
      Monthly dues are purposefully low, but they are not low everywhere.
      Sponsoring a membership opens the Collective to a teacher working in an
      under-resourced community.
    </p>

    <div class="sponsor-pills">
      <a class="sponsor-pill" href={sponsorOne} target="_blank" rel="noopener noreferrer">
        <span class="sponsor-amount">${annualPrice}</span>
        <span class="sponsor-what">One teacher, one year</span>
      </a>
      <a class="sponsor-pill" href={sponsorThree} target="_blank" rel="noopener noreferrer">
        <span class="sponsor-amount">${annualPrice * 3}</span>
        <span class="sponsor-what">Three teachers, one year</span>
      </a>
      <a class="sponsor-pill" href={sponsorTen} target="_blank" rel="noopener noreferrer">
        <span class="sponsor-amount">${annualPrice * 10}</span>
        <span class="sponsor-what">Ten teachers, one year</span>
      </a>
    </div>

    <div class="sponsor-more">
      <a class="sponsor-pill sponsor-pill--ghost" href={donateLink} target="_blank" rel="noopener noreferrer">
        <span class="sponsor-amount">${smallAmount}</span>
        <span class="sponsor-what">Give a smaller amount</span>
      </a>
      <p class="sponsor-note">
        Change the quantity at checkout to give more. It all goes to the same
        place: the Collective and the teachers it reaches.
      </p>
    </div>
  </section>

  <section class="already">
    <p>
      Already a member? <a href="/collective/login/">Sign in</a>. There's no
      password, we'll email you a link.
    </p>
  </section>
</div>

<style>
  .collective {
    max-width: 820px;
  }

  .collective-logo {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto var(--space-lg);
  }

  .tagline {
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-earth-dark);
    line-height: var(--leading-relaxed);
  }

  .est {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--text-xs);
    color: var(--color-earth);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .what-note {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-white);
    border-left: 3px solid var(--color-terracotta);
    border-radius: var(--radius-md);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    font-size: var(--text-sm);
  }

  .what {
    margin-top: var(--space-3xl);
  }

  .what h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    text-align: center;
    margin-bottom: var(--space-sm);
  }

  /* Hairline under the heading, echoing the rules used elsewhere. */
  .what h2::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto var(--space-2xl);
    background: var(--color-terracotta);
  }

  .what-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
    /* Numbers come from a counter rather than the markup, so the six
       blocks stay plain HTML and renumber themselves if any are added. */
    counter-reset: what;
  }

  .what-item {
    counter-increment: what;
    position: relative;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    transition: border-color 0.2s, transform 0.2s;
  }

  .what-item::before {
    content: counter(what, decimal-leading-zero);
    position: absolute;
    top: var(--space-md);
    right: var(--space-lg);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-terracotta);
    opacity: 0.55;
  }

  .what-item:hover {
    border-color: var(--color-terracotta);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .what-item { transition: border-color 0.2s; }
    .what-item:hover { transform: none; }
  }

  .what-item h3 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-earth-dark);
    line-height: var(--leading-tight);
    /* Room for the numeral in the corner. */
    padding-right: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .what-item p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    margin: 0;
  }

  .join {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl);
    background: rgba(208, 144, 91, 0.16);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .join-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-xs);
    color: var(--color-earth);
    margin-bottom: var(--space-lg);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    text-align: center;
  }

  .plan {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan--featured {
    outline: 2px solid var(--color-earth-dark);
  }

  .plan-badge {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-terracotta);
    color: var(--color-earth-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .plan-name {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .plan-price {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    color: var(--color-earth-dark);
    margin: var(--space-xs) 0;
  }

  .plan-price span {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-earth);
  }

  .plan-note {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .btn-join {
    display: inline-block;
    background: var(--color-lavender);
    color: var(--color-earth-dark);
    padding: 1rem 2.5rem;
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-sm);
  }

  .join-pending {
    display: inline-block;
    padding: 1rem 2rem;
    border: 1px dashed var(--color-earth);
    border-radius: 999px;
    color: var(--color-earth);
  }

  .join-fine {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-earth);
  }

  /* --- sponsorship --- */

  /* White where the dues block is washed terracotta, so the two asks read
     as separate moments rather than one long price list. */
  .sponsor {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl) var(--space-xl) var(--space-xl);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .sponsor h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-sm);
  }

  .sponsor h2::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto var(--space-lg);
    background: var(--color-terracotta);
  }

  .sponsor-lede {
    max-width: 58ch;
    margin: 0 auto;
    color: var(--color-earth);
    line-height: var(--leading-relaxed);
  }

  .sponsor-lede + .sponsor-lede {
    margin-top: var(--space-md);
  }

  /* A grid, not a wrapping flex row: three equal pills that drop straight
     to one column, rather than stranding the third on a line of its own. */
  .sponsor-pills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  @media (max-width: 620px) {
    .sponsor-pills { grid-template-columns: minmax(0, 1fr); }
  }

  .sponsor-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 1.05rem 1.4rem;
    border: 1px solid var(--color-terracotta);
    border-radius: 999px;
    background: var(--color-white);
    text-decoration: none;
    transition: background-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }

  .sponsor-pill:hover {
    background: rgba(208, 144, 91, 0.14);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .sponsor-amount {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    line-height: 1.1;
  }

  .sponsor-what {
    font-size: var(--text-xs);
    color: var(--color-earth);
  }

  .sponsor-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* Softer edge and a smaller figure: this is the modest option, and it
     should not compete with the three tiers above it. */
  .sponsor-pill--ghost {
    border-color: var(--color-cream-dark);
    padding: 0.8rem 1.5rem;
  }

  .sponsor-pill--ghost:hover {
    border-color: var(--color-terracotta);
  }

  .sponsor-pill--ghost .sponsor-amount {
    font-size: var(--text-lg);
  }

  .sponsor-note {
    max-width: 44ch;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-earth);
    line-height: var(--leading-relaxed);
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-pill:hover { transform: none; }
  }

  .sponsor-or a,
  .join-fine a,
  .already a {
    color: var(--color-earth-dark);
  }

  .already {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--color-text-light);
  }
</style>
