---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/support/', label: 'Guidance' },
  { href: '/access/', label: 'Access' },
  { href: '/whole-human/', label: 'Whole Human' },
  { href: '/resources/', label: 'Resources' },
  { href: '/blog/', label: 'Blog' },
  { href: '/our-team/', label: 'Our Team' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<nav class="site-nav" aria-label="Main navigation">
  <ul class="nav-list">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={['nav-link', { 'is-active': isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
    <li>
      <a
        href="/collective/"
        id="collective-link"
        class:list={['nav-link', 'nav-link--cta', { 'is-active': isActive('/collective/') }]}
      >
        Collective
      </a>
    </li>
  </ul>
</nav>

<script>
  // Members who are already signed in should land in the portal rather than
  // on the sales page. The session cookie is HttpOnly so it can't be read
  // here — we have to ask the server.
  //
  // Progressive enhancement: the link already works as /collective/, and
  // this only upgrades it. If the request is slow or fails, nothing breaks.
  const link = document.getElementById('collective-link') as HTMLAnchorElement | null;

  if (link && !window.location.pathname.startsWith('/collective/')) {
    fetch('/api/community/me')
      .then((r) => r.json())
      .then((me) => {
        if (me?.signedIn) {
          // The portal handles the lapsed-dues case itself.
          link.href = '/collective/portal/';
          link.textContent = 'My Collective';
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-terracotta);
    background-color: rgba(184, 117, 93, 0.06);
  }

  .nav-link.is-active {
    color: var(--color-terracotta);
    font-weight: 600;
  }

  /* Set the Collective apart from the content pages */
  .nav-link--cta {
    margin-left: var(--space-xs);
    border: 1px solid var(--color-purple);
    border-radius: 999px;
    color: var(--color-purple);
    white-space: nowrap;
  }

  .nav-link--cta:hover {
    background-color: var(--color-purple);
    color: var(--color-white);
  }

  .nav-link--cta.is-active {
    background-color: var(--color-purple);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .site-nav {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: var(--color-cream);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-md);
      box-shadow: var(--shadow-md);
    }

    .site-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-link {
      padding: var(--space-md);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-link:last-child {
      border-bottom: none;
    }
  }
</style>
