---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /* 'article' for blog posts, so shares render as an article rather than a
     generic page. Anything else stays a plain website page. */
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  author?: string;
}

const {
  title,
  description,
  image = '/images/4.png',
  canonicalUrl,
  noindex = false,
  type = 'website',
  publishedTime,
  author,
} = Astro.props;

const siteName = 'Montessori for Adolescents';
const siteUrl = 'https://montessoriforadolescents.com';
/* Pages whose own title already contains the brand keep it as written,
   so we never ship "Montessori for Adolescents | Montessori for Adolescents". */
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const resolvedUrl = canonicalUrl || Astro.url.href;
const resolvedImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const publishedISO =
  publishedTime instanceof Date
    ? publishedTime.toISOString()
    : publishedTime || undefined;

/* One @graph rather than separate blocks, so the Organization and the
   WebSite are linked by @id instead of being two unrelated entities.
   The WebSite node is what lets Google show the site name in results. */
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": siteName,
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/4.png`,
      },
      "description": "Empowering educators and parents to nurture the adolescent spirit through Montessori philosophy, community, and shared wisdom.",
      "sameAs": [
        "https://www.instagram.com/montessoriforadolescents",
        "https://buymeacoffee.com/montessoriforadolescents",
      ],
      "founder": {
        "@type": "Person",
        "@id": `${siteUrl}/#jarin`,
        "name": "Jarin Wadiwalla",
        "jobTitle": "Montessori Adolescent Consultant",
        "url": `${siteUrl}/our-team/`,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": siteName,
      "inLanguage": "en",
      "publisher": { "@id": `${siteUrl}/#organization` },
    },
  ],
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={resolvedUrl} />

<link rel="icon" type="image/png" href="/images/favicon-brown.png" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={resolvedUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
{type === 'article' && publishedISO && (
  <meta property="article:published_time" content={publishedISO} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={jsonLd} />
