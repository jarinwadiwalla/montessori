---
interface Props {
  title: string;
  description: string;
  price: number;
  href: string;
  dateDisplay?: string;
  timeDisplay?: string;
  presenter?: string;
  image?: string;
  isRecording?: boolean;
}

const { title, description, price, href, dateDisplay, timeDisplay, presenter, image, isRecording = false } = Astro.props;
---

<article class="webinar-card">
  {image && (
    <a href={href} class="webinar-image-link">
      <img src={image} alt={title} class="webinar-image" loading="lazy" />
    </a>
  )}
  <div class="webinar-top">
    <span class="webinar-badge">{isRecording ? 'Recording' : 'Live Webinar'}</span>
    <span class="webinar-price">${price} USD</span>
  </div>
  {dateDisplay && (
    <p class="webinar-date">
      {dateDisplay}
      {timeDisplay && <span class="webinar-time"> · {timeDisplay}</span>}
    </p>
  )}
  <h3 class="webinar-title">
    <a href={href}>{title}</a>
  </h3>
  {presenter && <p class="webinar-presenter">with {presenter}</p>}
  <p class="webinar-description">{description}</p>
  <div class="webinar-footer">
    <a href={href} class="webinar-cta">
      {isRecording ? 'Watch the Recording' : 'Details & Registration'}
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .webinar-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-purple);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .webinar-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .webinar-image-link {
    display: block;
    margin-bottom: var(--space-lg);
  }

  .webinar-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .webinar-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .webinar-badge {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-purple);
    background-color: var(--color-lavender);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .webinar-price {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-earth-dark);
    white-space: nowrap;
  }

  .webinar-date {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-terracotta-dark);
    margin-bottom: var(--space-sm);
  }

  .webinar-time {
    font-weight: 400;
    color: var(--color-text-light);
  }

  .webinar-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-xl);
    font-weight: 300;
    line-height: 1.3;
    margin-bottom: var(--space-xs);
  }

  .webinar-title a {
    color: var(--color-earth-dark);
    text-decoration: none;
  }

  .webinar-title a:hover {
    color: var(--color-purple);
  }

  .webinar-presenter {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-light);
    margin-bottom: var(--space-sm);
  }

  .webinar-description {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin-bottom: var(--space-xl);
  }

  .webinar-footer {
    margin-top: auto;
  }

  .webinar-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(75, 55, 55, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s, color 0.2s;
  }

  .webinar-cta:hover {
    color: var(--color-purple);
    border-color: var(--color-purple);
  }
</style>
