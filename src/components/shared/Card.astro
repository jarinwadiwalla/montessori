---
interface Props {
  title: string;
  description: string;
  href?: string;
  tag?: string;
}

const { title, description, href, tag } = Astro.props;
const Element = href ? 'a' : 'div';
---

<Element class="card" href={href}>
  {tag && <span class="card-tag">{tag}</span>}
  <h3 class="card-title">{title}</h3>
  <p class="card-description">{description}</p>
  {href && <span class="card-arrow">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>
  </span>}
  <slot />
</Element>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-top: 2px solid #d0905b;
    border-radius: 2px 2px var(--radius-lg) var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
    transition: transform 0.25s, box-shadow 0.25s;
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    a.card:hover { transform: none; }
  }

  .card-tag {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-tag::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .card-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-earth-dark);
    line-height: 1.25;
    margin-bottom: var(--space-md);
  }

  .card-description {
    font-size: var(--text-base);
    color: var(--color-earth);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin-bottom: var(--space-lg);
  }

  .card-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-earth);
    border-bottom: 1px solid rgba(208, 144, 91, 0.3);
    padding-bottom: 2px;
    width: fit-content;
    transition: color 0.2s, border-color 0.2s;
    margin-top: auto;
  }

  a.card:hover .card-arrow {
    color: #d0905b;
    border-color: #d0905b;
  }
</style>
