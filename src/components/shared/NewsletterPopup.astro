<!-- Newsletter Popup -->
<div id="newsletter-popup-overlay" class="popup-overlay" aria-hidden="true">
  <div class="popup" role="dialog" aria-modal="true" aria-labelledby="popup-heading">
    <button class="popup-close" id="popup-close-btn" aria-label="Close">&#x2715;</button>
    <p class="popup-eyebrow">Stay Connected</p>
    <h2 class="popup-heading" id="popup-heading">Get reflections and resources in your inbox.</h2>
    <p class="popup-subtext">Practical insights rooted in Montessori philosophy, delivered occasionally.</p>
    <form id="popup-subscribe-form" class="popup-form">
      <input type="text" name="firstName" placeholder="First name" required class="popup-input" autocomplete="given-name" />
      <input type="email" name="email" placeholder="Email address" required class="popup-input" autocomplete="email" />
      <button type="submit" class="popup-btn">Subscribe</button>
    </form>
    <p class="popup-status" id="popup-status"></p>
    <button class="popup-dismiss" id="popup-dismiss-btn">No thanks</button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'newsletter_popup_dismissed';

  function shouldShow(): boolean {
    try {
      return !localStorage.getItem(STORAGE_KEY);
    } catch {
      return false;
    }
  }

  function dismiss() {
    try {
      localStorage.setItem(STORAGE_KEY, '1');
    } catch {}
    hide();
  }

  function show() {
    const overlay = document.getElementById('newsletter-popup-overlay');
    if (!overlay) return;
    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden', 'false');
  }

  function hide() {
    const overlay = document.getElementById('newsletter-popup-overlay');
    if (!overlay) return;
    overlay.classList.remove('active');
    overlay.setAttribute('aria-hidden', 'true');
  }

  if (shouldShow()) {
    // Trigger on 8s timer or 40% scroll, whichever first
    let triggered = false;
    function trigger() {
      if (triggered) return;
      triggered = true;
      show();
      window.removeEventListener('scroll', onScroll);
    }

    const timer = setTimeout(trigger, 8000);

    function onScroll() {
      const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (scrolled >= 0.4) trigger();
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Close on overlay click
    document.getElementById('newsletter-popup-overlay')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) dismiss();
    });

    document.getElementById('popup-close-btn')?.addEventListener('click', dismiss);
    document.getElementById('popup-dismiss-btn')?.addEventListener('click', dismiss);

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') dismiss();
    });

    // Form submit
    const form = document.getElementById('popup-subscribe-form') as HTMLFormElement;
    const status = document.getElementById('popup-status')!;
    const btn = form?.querySelector('.popup-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      status.textContent = '';
      status.className = 'popup-status';

      const formData = new FormData(form);
      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: formData.get('firstName'),
            email: formData.get('email'),
          }),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          status.textContent = result.message || 'Thank you for subscribing!';
          status.classList.add('popup-status--success');
          try { localStorage.setItem(STORAGE_KEY, '1'); } catch {}
          setTimeout(hide, 2500);
        } else {
          status.textContent = result.error || 'Something went wrong. Please try again.';
          status.classList.add('popup-status--error');
          btn.disabled = false;
          btn.textContent = 'Subscribe';
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('popup-status--error');
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    });
  }
</script>

<style>
  .popup-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(62, 49, 42, 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: var(--space-md);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .popup-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  .popup {
    background-color: var(--color-earth-dark);
    color: var(--color-cream);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl) var(--space-xl);
    max-width: 420px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    transform: translateY(12px);
    transition: transform 300ms ease;
  }

  .popup-overlay.active .popup {
    transform: translateY(0);
  }

  .popup-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: none;
    border: none;
    color: rgba(250, 247, 242, 0.5);
    font-size: var(--text-lg);
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    transition: color var(--transition-fast);
  }

  .popup-close:hover {
    color: var(--color-cream);
  }

  .popup-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-terracotta-light);
    margin-bottom: var(--space-sm);
  }

  .popup-heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--color-cream);
    margin-bottom: var(--space-sm);
  }

  .popup-subtext {
    font-size: var(--text-sm);
    color: rgba(250, 247, 242, 0.6);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }

  .popup-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .popup-input {
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-cream);
    background-color: rgba(250, 247, 242, 0.1);
    border: 1px solid rgba(250, 247, 242, 0.2);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
    text-align: center;
  }

  .popup-input::placeholder {
    color: rgba(250, 247, 242, 0.4);
  }

  .popup-input:focus {
    outline: none;
    border-color: rgba(250, 247, 242, 0.5);
  }

  .popup-btn {
    padding: var(--space-sm) var(--space-lg);
    background-color: var(--color-terracotta);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: opacity var(--transition-fast);
    margin-top: var(--space-xs);
  }

  .popup-btn:hover {
    opacity: 0.9;
  }

  .popup-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .popup-status {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    min-height: 1.2em;
  }

  .popup-status--success {
    color: var(--color-sage-light);
  }

  .popup-status--error {
    color: var(--color-terracotta-light);
  }

  .popup-dismiss {
    background: none;
    border: none;
    color: rgba(250, 247, 242, 0.35);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    cursor: pointer;
    margin-top: var(--space-md);
    text-decoration: underline;
    transition: color var(--transition-fast);
  }

  .popup-dismiss:hover {
    color: rgba(250, 247, 242, 0.6);
  }

  @media (max-width: 480px) {
    .popup {
      padding: var(--space-xl) var(--space-md);
    }

    .popup-heading {
      font-size: var(--text-xl);
    }
  }
</style>
