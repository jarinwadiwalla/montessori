---
// Arch panels. An item is either a plain label, which renders as something
// to read, or a label with an href, which renders as a link. Where both
// appear together the linked ones carry an arrow, since nothing else about
// an arch tells you it can be clicked.
type Item = string | { label: string; href: string };

interface Props {
  items: Item[];
  /** How many across on a wide screen. Four needs a wider grid than three,
      and drops to 2x2 before it collapses to a column. */
  columns?: 3 | 4;
}
const { items, columns = 3 } = Astro.props;

const norm = items.map((i) =>
  typeof i === 'string' ? { label: i, href: undefined } : i
);
---

<div class:list={['stage-grid', `stage-grid--${columns}`]}>
  {norm.map((item) =>
    item.href ? (
      <a class="stage stage--link" href={item.href}>
        <p class="stage-name">{item.label}</p>
        <span class="stage-arrow" aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <div class="stage">
        <p class="stage-name">{item.label}</p>
      </div>
    )
  )}
</div>

<style>
  .stage-grid {
    display: grid;
    gap: var(--space-xl);
    margin: 0 auto var(--space-3xl);
  }

  .stage-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 900px;
  }

  /* Four arches need more room than three: at 900px each one is narrow
     enough that the 150px dome eats the words. */
  .stage-grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    max-width: 1140px;
  }

  @media (max-width: 1040px) {
    .stage-grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 900px;
    }
  }

  @media (max-width: 780px) {
    .stage-grid { grid-template-columns: minmax(0, 1fr); }
  }

  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 220px;
    background: var(--color-white);
    /* A gentler arch than a full semicircle, which left a large empty dome
       above the text once the ages came out. */
    border-radius: 150px 150px var(--radius-lg) var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .stage-name::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    margin: 0 auto var(--space-lg);
    background: var(--color-terracotta);
  }
  .stage--link {
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .stage--link:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .stage--link:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage--link:hover { transform: none; }
  }

  .stage-arrow {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-terracotta-dark);
  }

  .stage-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-earth-dark);
    margin: 0;
  }
</style>
