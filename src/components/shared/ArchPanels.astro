---
// Informational arch panels. Not links — the shape is doing the work of
// saying so, which is why they are not built on Card.
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="stage-grid">
  {items.map((label) => (
    <div class="stage">
      <p class="stage-name">{label}</p>
    </div>
  ))}
</div>

<style>
  .stage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    max-width: 900px;
    margin: 0 auto var(--space-3xl);
  }

  @media (max-width: 780px) {
    .stage-grid { grid-template-columns: minmax(0, 1fr); }
  }

  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 220px;
    background: var(--color-white);
    /* A gentler arch than a full semicircle, which left a large empty dome
       above the text once the ages came out. */
    border-radius: 150px 150px var(--radius-lg) var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .stage-name::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    margin: 0 auto var(--space-lg);
    background: var(--color-terracotta);
  }
  .stage-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-earth-dark);
    margin: 0;
  }
</style>
