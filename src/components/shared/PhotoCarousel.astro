---
interface Props {
  photos: { src: string; alt: string }[];
  autoplay?: boolean;
}
const { photos, autoplay = false } = Astro.props;
---

<div class="photo-carousel" data-autoplay={autoplay ? "true" : "false"}>
  <button class="carousel-btn carousel-prev" aria-label="Previous photos">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>

  <div class="carousel-viewport">
    <div class="carousel-track">
      {photos.map((photo) => (
        <div class="carousel-slide">
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <button class="carousel-btn carousel-next" aria-label="Next photos">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
</div>

<style>
  .photo-carousel {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .carousel-viewport {
    overflow: hidden;
    width: 100%;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.8s ease-in-out;
    will-change: transform;
  }

  .carousel-slide {
    flex: 0 0 33.333%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0 2px;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-btn {
    position: absolute;
    z-index: 10;
    background-color: rgba(255, 255, 255, 0.92);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-purple);
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    transition: background-color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .carousel-btn:hover {
    background-color: var(--color-lavender);
    transform: scale(1.05);
  }

  .carousel-btn:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
  }

  .carousel-prev {
    left: 12px;
  }

  .carousel-next {
    right: 12px;
  }

  @media (max-width: 640px) {
    .carousel-slide {
      flex: 0 0 100%;
    }

    .carousel-btn {
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  document.querySelectorAll('.photo-carousel').forEach((carousel) => {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const prevBtn = carousel.querySelector('.carousel-prev') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('.carousel-next') as HTMLButtonElement;

    let current = 0;

    function visibleCount() {
      return window.innerWidth <= 640 ? 1 : 3;
    }

    function update() {
      const v = visibleCount();
      const max = Math.max(0, slides.length - v);
      current = Math.min(current, max);
      const pct = (100 / v) * current;
      track.style.transform = `translateX(-${pct}%)`;
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current >= max;
    }

    prevBtn.addEventListener('click', () => { current--; update(); });
    nextBtn.addEventListener('click', () => { current++; update(); });
    window.addEventListener('resize', update);
    update();

    if (carousel.dataset.autoplay === 'true') {
      setInterval(() => {
        const v = visibleCount();
        const max = Math.max(0, slides.length - v);
        current = current >= max ? 0 : current + 1;
        update();
      }, 4000);
    }
  });
</script>
