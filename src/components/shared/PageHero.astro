---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imagePosition?: string;
}

const {
  title,
  subtitle,
  eyebrow = 'Montessori for Adolescents',
  ctaLabel,
  ctaHref = '#content',
  image = '/images/banner-lavender.jpg',
  imagePosition = 'center',
} = Astro.props;
---

<section class="page-hero">
  <div class="hero-bg" style={`background-image: url('${image}'); background-position: ${imagePosition};`}></div>
  <div class="hero-overlay"></div>

  <div class="container hero-inner">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="page-hero-title">{title}</h1>
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
    {ctaLabel && <a href={ctaHref} class="hero-cta">{ctaLabel}</a>}
  </div>

  <div class="hero-rule-bottom"></div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Background image with slow zoom */
  .hero-bg {
    position: absolute;
    inset: -8%;
    background-size: cover;
    background-position: center;
    z-index: 0;
    animation: heroZoom 12s ease-out forwards;
    will-change: transform;
  }

  @keyframes heroZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }

  /* Diagonal dark overlay — heavier bottom-left, fades toward top-right */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(25, 12, 40, 0.88) 0%,
      rgba(25, 12, 40, 0.55) 55%,
      rgba(25, 12, 40, 0.2) 100%
    );
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
    animation: fadeUp 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Eyebrow with hairline rule before it */
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.6);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 0.5px;
    background: rgba(201, 169, 110, 0.7);
    flex-shrink: 0;
  }

  .page-hero-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 300;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
    max-width: 680px;
  }

  .page-hero-subtitle {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.6);
    font-weight: 300;
    font-style: italic;
    max-width: 480px;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
    letter-spacing: 0.02em;
  }

  /* Ghost CTA button */
  .hero-cta {
    display: inline-block;
    padding: 0.6rem 1.8rem;
    border: 0.5px solid rgba(255, 255, 255, 0.45);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background-color 0.25s, border-color 0.25s;
  }

  .hero-cta:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* Hairline gold rule at bottom of banner */
  .hero-rule-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(201, 169, 110, 0.8) 0%,
      rgba(201, 169, 110, 0.4) 40%,
      transparent 80%
    );
    z-index: 3;
  }

  @media (max-width: 640px) {
    .page-hero {
      min-height: 240px;
    }

    .page-hero-title {
      font-size: clamp(1.4rem, 6vw, 1.8rem);
    }

    .page-hero-subtitle {
      font-size: var(--text-sm);
      max-width: 100%;
    }
  }
</style>
