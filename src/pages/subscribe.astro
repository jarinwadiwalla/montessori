---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscribe"
  description="Get reflections, resources, and updates about Montessori adolescent education delivered to your inbox."
>
  <div class="subscribe-page">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <h1 class="hero-title">Join Our Community!</h1>
      </div>
    </section>

    <!-- Form card -->
    <section class="form-section">
      <div class="form-card">
        <h2 class="form-heading">
          <span class="form-heading-inner">
            <svg class="form-heart" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Subscribe to Montessori Mail
          </span>
        </h2>

        <form id="sub-page-form" class="sub-form">
          <div class="sub-form-fields">
            <input type="text" name="firstName" placeholder="First name" required class="sub-input" autocomplete="given-name" />
            <input type="email" name="email" placeholder="Email address" required class="sub-input" autocomplete="email" />
          </div>
          <button type="submit" class="sub-btn">Subscribe</button>
          <p class="sub-status" id="sub-page-status"></p>
        </form>

        <p class="form-note">Unsubscribe any time. Your information is never shared.</p>
      </div>

      <!-- Decorative wave repeat -->
      <div class="wave-strip"></div>
    </section>

    <!-- Fact section -->
    <section class="quote-section">
      <div class="fact-block">
        <p class="fact-text">Maria Montessori was nominated for the Nobel Peace Prize three consecutive years: 1949, 1950, and 1951. She was honored for her vision of peace through education.</p>
        <p class="fact-tagline">We strive to continue this vision.</p>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const form = document.getElementById('sub-page-form') as HTMLFormElement;
  const status = document.getElementById('sub-page-status')!;
  const btn = form.querySelector('.sub-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Subscribing...';
    status.textContent = '';
    status.className = 'sub-status';

    const fd = new FormData(form);
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName: fd.get('firstName'), email: fd.get('email') }),
      });
      const result = await res.json();

      if (res.ok && result.success) {
        form.reset();
        status.textContent = result.message || 'Thank you! You\'re subscribed.';
        status.classList.add('sub-status--success');
        btn.textContent = 'Subscribed!';
      } else {
        status.textContent = result.error || 'Something went wrong. Please try again.';
        status.classList.add('sub-status--error');
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.classList.add('sub-status--error');
      btn.disabled = false;
      btn.textContent = 'Subscribe';
    }
  });
</script>

<style>
  .subscribe-page {
    margin-top: 0;
  }

  /* ── Hero ── */
  .hero {
    background-image: url('/images/banner-lavender.jpg');
    background-size: cover;
    background-position: center;
    min-height: 55vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-5xl) var(--space-md);
    position: relative;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(228, 210, 248, 0.15) 0%, rgba(228, 210, 248, 0.45) 100%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .hero-logo {
    width: 220px;
    height: auto;
    display: block;
    margin: 0 auto var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    color: var(--color-purple);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-lg);
    letter-spacing: var(--tracking-tight);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-earth);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── Form section ── */
  .form-section {
    background-color: var(--color-cream);
    padding: var(--space-5xl) var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-3xl) var(--space-3xl);
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .form-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-terracotta);
    margin-bottom: var(--space-sm);
  }

  .form-heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-purple);
    font-weight: 600;
    margin-bottom: var(--space-md);
    line-height: var(--leading-tight);
    text-align: center;
  }

  .form-heading-inner {
    position: relative;
    display: inline-block;
  }

  .form-heart {
    color: var(--color-terracotta);
    position: absolute;
    top: -8px;
    left: -4px;
  }

  .form-text {
    font-size: var(--text-base);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
  }

  .sub-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sub-form-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sub-input {
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-sizing: border-box;
  }

  .sub-input::placeholder {
    color: var(--color-text-light);
    opacity: 0.7;
  }

  .sub-input:focus {
    outline: none;
    border-color: var(--color-purple);
    box-shadow: 0 0 0 3px rgba(63, 38, 91, 0.08);
  }

  .sub-btn {
    width: 100%;
    padding: var(--space-md) var(--space-xl);
    background-color: var(--color-purple);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    margin-top: var(--space-xs);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .sub-btn:hover {
    background-color: var(--color-purple-light);
    transform: translateY(-1px);
  }

  .sub-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .sub-status {
    font-size: var(--text-sm);
    min-height: 1.4em;
    margin-top: var(--space-xs);
  }

  .sub-status--success {
    color: var(--color-sage);
    font-weight: 500;
  }

  .sub-status--error {
    color: var(--color-terracotta);
  }

  .form-note {
    margin-top: var(--space-lg);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    opacity: 0.7;
  }

  /* ── Wave strip ── */
  .wave-strip {
    width: 100%;
    max-width: 520px;
    height: 40px;
    margin-top: var(--space-2xl);
    background-image: url('/images/banner-lavender.jpg');
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-xl);
    opacity: 0.6;
  }

  /* ── Quote ── */
  .quote-section {
    background-color: var(--color-lavender);
    padding: var(--space-4xl) var(--space-md);
    text-align: center;
  }

  .fact-block {
    max-width: 580px;
    margin-inline: auto;
  }

  .fact-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-purple);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .fact-tagline {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-terracotta);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: var(--text-4xl);
    }

    .hero-logo {
      width: 180px;
    }

    .form-card {
      padding: var(--space-xl) var(--space-lg);
    }

    .pull-quote p {
      font-size: var(--text-xl);
    }
  }
</style>
