---
import PageLayout from '../layouts/PageLayout.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';
import PhotoCarousel from '../components/shared/PhotoCarousel.astro';
---

<PageLayout
  title="Whole-Human Approach"
  description="A unique integration of Montessori philosophy with mindfulness, social/emotional learning, and holistic traditions, whole-human adolescent development beyond pedagogy."
  heroTitle="Beyond Pedagogy"
  heroSubtitle="Weaving Montessori with Whole-Human Development"
  heroImage="/images/whole-human-hero.jpg"
>
  <div class="container container--narrow">
    <section class="page-section">
      <p>
        Imagine a community where each young person is given room to breathe, unfold, and grow into their most authentic self.
      </p>
      <p>
        Montessori pedagogy offers a profound understanding of adolescent development and we have found that it weaves beautifully with wellness practices that nurture the whole-person. Our work draws on authentic Montessori philosophy alongside practices like mindfulness, social/emotional learning, and yoga.
      </p>
      <p>
        By weaving these practices together, we create a richer, more complete framework for supporting adolescents through one of the most transformative periods of their lives.
      </p>
    </section>

  </div>

  <div class="carousel-section">
    <PhotoCarousel photos={[
      { src: '/images/whole-human-photo-1.jpg', alt: 'Whole human development' },
      { src: '/images/whole-human-photo-2.jpg', alt: 'Whole human development' },
      { src: '/images/whole-human-photo-3.jpg', alt: 'Whole human development' },
      { src: '/images/whole-human-photo-4.jpg', alt: 'Whole human development' },
      { src: '/images/whole-human-photo-5.jpg', alt: 'Whole human development' },
      { src: '/images/whole-human-photo-6.jpg', alt: 'Whole human development' },
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <div class="dimensions">
        <div class="dimension">
          <h3>Intellectual</h3>
          <p>Critical thinking, curiosity, and the capacity for abstract reasoning that emerges in the third plane.</p>
        </div>
        <div class="dimension">
          <h3>Emotional</h3>
          <p>Self-awareness, resilience, and the ability to navigate the intense emotional landscape of adolescence.</p>
        </div>
        <div class="dimension">
          <h3>Social</h3>
          <p>Belonging, collaboration, and understanding one's role within the community and the wider world.</p>
        </div>
        <div class="dimension">
          <h3>Physical</h3>
          <p>Connection to the body, meaningful physical work, and practices that honor the adolescent's changing form.</p>
        </div>
        <div class="dimension">
          <h3>Moral</h3>
          <p>A developing sense of justice, responsibility, and the courage to act on one's values.</p>
        </div>
      </div>
    </section>

  </div>

  <QuoteBanner
    text="The greatest sign of success for a teacher is to be able to say, 'The children are now working as if I did not exist.'"
    author="Maria Montessori"
  />
</PageLayout>

<style>
  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
    color: var(--color-earth);
  }

  .page-section p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .dimensions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .dimension {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    flex: 0 1 calc(33.333% - var(--space-lg));
    min-width: 220px;
    box-sizing: border-box;
  }

  @media (max-width: 600px) {
    .dimension {
      flex: 0 1 100%;
    }
  }

  .dimension h3 {
    font-size: var(--text-xl);
    color: var(--color-terracotta);
    margin-bottom: var(--space-sm);
  }

  .dimension p {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .carousel-section {
    margin-block: var(--space-3xl);
  }
</style>
