---
import PageLayout from '../layouts/PageLayout.astro';
import DonateButton from '../components/shared/DonateButton.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';
import PhotoCarousel from '../components/shared/PhotoCarousel.astro';
---

<PageLayout
  title={"Access & Equity"}
  description="Bringing Montessori adolescent programming to communities that have never had access, equity is not a value statement, it's our core mission."
  heroTitle="Expanding Access to Centers of Study and Work"
  heroSubtitle="We need the help of our community!"
  heroImage="/images/access-hero.jpg"
  heroImagePosition="center 40%"
>
  <div class="container container--narrow">
    <section class="page-section message-section">
      <p>
        We live in a moment of profound disconnection. Young people are spending more time online than ever, and yet many report feeling more isolated, more anxious, more lost than any generation before them.
      </p>
      <p>
        Montessori education offers something different: real autonomy, real community, and real work that adolescents can believe in. It meets young people where they are, with respect for who they're becoming, not just who they've been told to be.
      </p>

      <div class="stats-strip">
        <div class="stat-item">
          <span class="stat-number">73%</span>
          <span class="stat-desc">of teens say social media makes them feel worse about themselves</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">5hrs</span>
          <span class="stat-desc">average daily screen time for adolescents, displacing face-to-face connection</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">Most</span>
          <span class="stat-desc">families in underserved communities have no access to this alternative</span>
        </div>
      </div>

      <p>
        This is where we need community support. We aim to bring Montessori to communities where access is limited, giving adolescents the chance to learn with their hands, think for themselves, and connect with one another in ways that matter.
      </p>

      <p>
        Every contribution moves this vision forward, for the adolescent who's drowning in notifications, and for the one who's never had a learning environment that believed in them.
      </p>
      <p>
        We're just getting started, and we're so grateful that you found us.
      </p>
    </section>
  </div>

  <div class="carousel-section">
    <PhotoCarousel autoplay={true} photos={[
      { src: '/images/access-photo-1.jpg', alt: 'Montessori access' },
      { src: '/images/access-photo-2.jpg', alt: 'Montessori access' },
      { src: '/images/access-photo-3.jpg', alt: 'Montessori access' },
      { src: '/images/access-photo-4.jpg', alt: 'Montessori access' },
      { src: '/images/access-photo-5.jpg', alt: 'Montessori access' },
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <p class="section-eyebrow">How Your Support Helps</p>
      <div class="impact-grid">
        <div class="impact-card">
          <h3>Training</h3>
          <p>Funding Montessori adolescent training for educators in communities where the cost would otherwise be a barrier.</p>
        </div>
        <div class="impact-card">
          <h3>Programs</h3>
          <p>Helping communities create their own spaces for adolescents to learn, work, and grow together.</p>
        </div>
        <div class="impact-card">
          <h3>On-Site Support</h3>
          <p>Being there in person, side by side, to help turn a vision into something real.</p>
        </div>
      </div>
    </section>

    <section class="page-section">
      <p class="section-eyebrow">Roadmap</p>
      <div class="phases-grid">
        <div class="phase-card">
          <span class="phase-label">Phase 1</span>
          <h3>Foundation</h3>
          <span class="phase-goal">$5,000</span>
          <p>Cover core operations, registration and fees, maintain website, and launch initial content and marketing.</p>
          <p class="phase-outcome">Outcome: The project is officially established and ready to grow.</p>
        </div>
        <div class="phase-card">
          <span class="phase-label">Phase 2</span>
          <h3>Access Expansion</h3>
          <span class="phase-goal">$10,000</span>
          <p>Identify an under-served community, build local relationships, assess need, and develop a launch plan.</p>
          <p class="phase-outcome">Outcome: A community is selected, relationships are built, and the launch plan is in place.</p>
        </div>
        <div class="phase-card">
          <span class="phase-label">Phase 3</span>
          <h3>Direct Community Support</h3>
          <span class="phase-goal">$15,000</span>
          <p>Partner with local organizations, fund programming and licensing, source a Center for Study and Work location, and train and pay local teachers.</p>
          <p class="phase-outcome">Outcome: A pilot program is launched.</p>
        </div>
        <div class="phase-card">
          <span class="phase-label">Phase 4</span>
          <h3>Scale Impact</h3>
          <p>Expand to multiple communities, hire a program coordinator, and develop long-term sustainability.</p>
          <p class="phase-outcome">Outcome: Montessori adolescent programming reaches more communities around the world.</p>
        </div>
      </div>
    </section>

    <section class="page-section">
      <p class="section-eyebrow">Progress</p>
      <div class="progress-tracker">
        <div class="progress-bar">
          <div class="progress-fill" style="width: 5.1%;"></div>
        </div>
        <div class="progress-milestones">
          <div class="milestone" style="left: 5%;">
            <span class="milestone-amount">$1k</span>
            <span class="milestone-label">Registration</span>
          </div>
          <div class="milestone" style="left: 25%;">
            <span class="milestone-amount">$5k</span>
            <span class="milestone-label">Foundation</span>
          </div>
          <div class="milestone" style="left: 50%;">
            <span class="milestone-amount">$10k</span>
            <span class="milestone-label">Access</span>
          </div>
          <div class="milestone" style="left: 90%;">
            <span class="milestone-amount">$15k+</span>
            <span class="milestone-label">Pilot</span>
          </div>
        </div>
        <p class="progress-message">
          <strong>$1,120 raised</strong>. Contributions to Montessori for Adolescents are not yet tax-deductible.
        </p>
      </div>
    </section>

    <section class="page-section text-center">
      <div class="donate-action">
        <DonateButton label="Support the Vision" />
      </div>
    </section>

  </div>

  <section class="gratitude-banner">
    <div class="container gratitude-inner">
      <p class="gratitude-eyebrow">With Gratitude</p>
      <h2 class="gratitude-title">This work is made possible by the generosity of people who believe in it.</h2>
      <div class="donor-grid">
        <span class="donor-chip">Shaukat Wadiwalla</span>
        <span class="donor-chip">Deborah Wadiwalla</span>
        <span class="donor-chip">Antony Chiang</span>
        <span class="donor-chip">William Lovett</span>
        <span class="donor-chip">Janna Moreau-Carrera</span>
        <span class="donor-chip">Armine Olivas</span>
        <span class="donor-chip">Dr. Julia Martz</span>
        <span class="donor-chip">Ajay Ahuja</span>
        <span class="donor-chip">Dr. Daniel Vo</span>
        <span class="donor-chip">Wagas Kurjee</span>
        <span class="donor-chip">Dr. Nam Nguyen</span>
        <span class="donor-chip">Ayan Goswami</span>
        <span class="donor-chip">Pavla Guggenheim</span>
        <span class="donor-chip">Farhana Kurjee</span>
      </div>
    </div>
  </section>

  <QuoteBanner
    text="Education is the most powerful weapon which you can use to change the world."
    author="Nelson Mandela"
  />
</PageLayout>

<style>
  .carousel-section {
    margin-block: var(--space-3xl);
  }

  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  /* Section eyebrow headings */
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.85);
    margin-bottom: var(--space-xl);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  /* Stats strip */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stat-item {
    padding: var(--space-xl) var(--space-lg) var(--space-xl) 0;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .stat-item:first-child { padding-left: 0; }
  .stat-item:last-child { border-right: none; padding-left: var(--space-lg); padding-right: 0; }
  .stat-item:not(:first-child):not(:last-child) { padding-left: var(--space-lg); }

  .stat-number {
    font-family: 'Georgia Pro', Georgia, serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    color: #d0905b;
    line-height: 1;
  }

  .stat-desc {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin-bottom: 0;
  }

  /* Impact cards */
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .impact-card {
    background: var(--color-white);
    border-top: 2px solid #d0905b;
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
  }

  .impact-card h3 {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-xl);
    font-weight: 300;
    color: var(--color-earth-dark);
    margin-bottom: var(--space-sm);
  }

  .impact-card p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: 0;
  }

  /* Phase cards */
  .phases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .phase-card {
    background: var(--color-white);
    border-top: 2px solid #d0905b;
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .phase-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.8);
  }

  .phase-card h3 {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-xl);
    font-weight: 300;
    color: var(--color-earth-dark);
    margin-bottom: var(--space-xs);
  }

  .phase-goal {
    font-family: 'Georgia Pro', Georgia, serif;
    font-size: var(--text-2xl);
    font-weight: 300;
    color: #d0905b;
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .phase-card p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: 0;
  }

  .phase-outcome {
    font-size: var(--text-xs) !important;
    color: var(--color-text-light);
    font-style: italic;
    margin-top: auto !important;
    padding-top: var(--space-sm);
    border-top: 0.5px solid var(--color-border);
  }

  /* Progress Tracker */
  .progress-tracker {
    margin-top: var(--space-xl);
  }

  .progress-bar {
    height: 3px;
    background: var(--color-border);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: #d0905b;
    min-width: 4px;
  }

  .progress-milestones {
    position: relative;
    height: 3rem;
    margin-top: var(--space-sm);
  }

  .milestone {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .milestone-amount {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-earth);
  }

  .milestone-label {
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .progress-message {
    font-size: var(--text-sm) !important;
    color: var(--color-text-light) !important;
    margin-top: var(--space-md);
    border-top: 0.5px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .donate-action {
    margin-top: var(--space-lg);
    display: flex;
    justify-content: center;
  }

  /* With Gratitude banner */
  .gratitude-banner {
    background: linear-gradient(
      135deg,
      #190c28 0%,
      #2e1445 45%,
      #3d1f5a 100%
    );
    padding-block: var(--space-4xl);
  }

  .gratitude-inner {
    animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .gratitude-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.55);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gratitude-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .gratitude-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 300;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2xl);
    max-width: 600px;
  }

  .donor-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .donor-chip {
    display: inline-block;
    background: rgba(250, 247, 242, 0.07);
    border: 0.5px solid rgba(250, 247, 242, 0.2);
    border-radius: 100px;
    padding: var(--space-xs) var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(250, 247, 242, 0.75);
    font-weight: 300;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .stats-strip {
      grid-template-columns: 1fr 1fr;
    }

    .stat-item:nth-child(2) { border-right: none; }
    .stat-item:last-child { border-right: none; grid-column: 1 / -1; padding-left: 0; border-top: 1px solid var(--color-border); }

    .impact-grid {
      grid-template-columns: 1fr;
    }

    .phases-grid {
      grid-template-columns: 1fr;
    }

    .milestone-label {
      display: none;
    }
  }
</style>
