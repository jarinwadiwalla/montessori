---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PortalNav from '../../components/collective/PortalNav.astro';

// Members watch the webinar recordings free — they're included in dues.
// Any webinar content entry with a recordingEmbedUrl shows up here.
const webinars = (await getCollection('webinars'))
  .filter((w) => w.data.recordingEmbedUrl)
  .sort((a, b) => (a.data.eventDate < b.data.eventDate ? 1 : -1));
---

<PageLayout
  title="Webinar"
  description="Webinar recordings for Collective members."
  heroTitle="Webinar"
  heroSubtitle="Recordings of our sessions — included with your membership."
  noindex
>
  <div class="container webinar-page">
    <p class="loading" id="loading">Loading…</p>

    <div id="main" hidden>
      <PortalNav active="webinar" />

      {webinars.length === 0 ? (
        <p class="webinar-empty">No recordings yet — the next session's recording will appear here.</p>
      ) : (
        webinars.map((w) => (
          <article class="webinar-item">
            <h2>{w.data.title}</h2>
            <p class="webinar-meta">
              Presented by {w.data.presenter} · {w.data.duration}
            </p>
            <div class="video-frame">
              <iframe
                src={w.data.recordingEmbedUrl}
                title={w.data.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </article>
        ))
      )}
    </div>
  </div>
</PageLayout>

<script>
  async function boot() {
    const me = await (await fetch('/api/community/me')).json();
    if (!me.signedIn) {
      window.location.href = '/collective/login/';
      return;
    }
    if (me.lapsed) {
      window.location.href = '/collective/portal/';
      return;
    }
    document.getElementById('loading')!.hidden = true;
    document.getElementById('main')!.hidden = false;
    document.getElementById('me-name')!.textContent = me.member.name || 'Member';
    const av = document.getElementById('me-avatar') as HTMLImageElement;
    if (me.member.avatar_url) {
      av.src = me.member.avatar_url;
      av.hidden = false;
    }
  }
  boot();

  document.getElementById('signout-btn')?.addEventListener('click', async () => {
    await fetch('/api/community/logout', { method: 'POST' });
    window.location.href = '/collective/';
  });
</script>

<style>
  .webinar-item {
    max-width: 760px;
    margin-bottom: var(--space-2xl);
  }

  .webinar-item h2 {
    margin: 0 0 0.2rem;
    font-size: var(--text-lg);
  }

  .webinar-meta {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-md);
  }

  .video-frame {
    position: relative;
    padding-top: 56.25%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .webinar-empty,
  .loading {
    color: var(--color-text-light);
  }
</style>
