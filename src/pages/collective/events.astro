---
import PageLayout from '../../layouts/PageLayout.astro';
import PortalNav from '../../components/collective/PortalNav.astro';
---

<PageLayout
  title="Events"
  description="Monthly gatherings, guest presentations and in-person retreats for the Montessori Adolescent Collective."
  heroTitle="Events"
  heroSubtitle="Gatherings, guest presentations, and retreats."
  noindex
>
  <div class="container events-page">
    <p class="loading" id="loading">Loading…</p>

    <div id="main" hidden>
      <PortalNav active="events" />

      <!-- Organiser-only: add an event -->
      <section class="event-form" id="event-form" hidden>
        <h2 id="form-heading">Add an event</h2>
        <div class="form-row">
          <label>
            Type
            <select id="f-kind">
              <option value="gathering">Monthly gathering</option>
              <option value="presentation">Guest presentation</option>
              <option value="retreat">In-person retreat</option>
            </select>
          </label>
          <label class="grow">
            Title
            <input type="text" id="f-title" maxlength="140" placeholder="October gathering" />
          </label>
        </div>

        <div class="form-row">
          <label>
            Starts
            <input type="datetime-local" id="f-starts" />
          </label>
          <label>
            Ends <span>(optional)</span>
            <input type="datetime-local" id="f-ends" />
          </label>
          <label class="grow">
            Time note <span>(optional)</span>
            <input type="text" id="f-tz" maxlength="120" placeholder="9am SGT / 6pm PDT" />
          </label>
        </div>

        <div class="form-row">
          <label class="grow">
            Where
            <input type="text" id="f-location" maxlength="160" placeholder="Online, or a place" />
          </label>
          <label class="grow">
            Link <span>(optional)</span>
            <input type="url" id="f-link" maxlength="500" placeholder="https://…" />
          </label>
        </div>

        <div class="form-row">
          <label class="grow">
            Guest / host <span>(optional)</span>
            <input type="text" id="f-host" maxlength="120" />
          </label>
          <label>
            Capacity <span>(0 = no limit)</span>
            <input type="number" id="f-capacity" min="0" value="0" />
          </label>
        </div>

        <label class="block">
          Description
          <textarea id="f-description" rows="3" maxlength="3000"></textarea>
        </label>

        <div class="form-actions">
          <button id="f-save" type="button">Add event</button>
          <button id="f-cancel" type="button" class="ghost" hidden>Cancel</button>
        </div>
        <p class="form-error" id="f-error" role="alert"></p>
      </section>

      <div class="tabs">
        <button class="tab is-active" id="tab-upcoming" type="button">Upcoming</button>
        <button class="tab" id="tab-past" type="button">Past</button>
      </div>

      <div id="list"></div>
      <p class="events-empty" id="empty" hidden>Nothing scheduled yet.</p>
    </div>
  </div>
</PageLayout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  let canManage = false;
  let when: 'upcoming' | 'past' = 'upcoming';
  let editingId: string | null = null;

  const KIND_LABEL: Record<string, string> = {
    gathering: 'Monthly gathering',
    presentation: 'Guest presentation',
    retreat: 'In-person retreat',
  };

  function el(tag: string, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text; // never innerHTML
    return n;
  }

  function formatWhen(iso: string, note: string) {
    const d = new Date(iso);
    const base = d.toLocaleString(undefined, {
      weekday: 'short', day: 'numeric', month: 'long', year: 'numeric',
      hour: 'numeric', minute: '2-digit',
    });
    return note ? `${base} · ${note}` : base;
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      headers: { 'Content-Type': 'application/json' },
      ...options,
    });
    let data: any = {};
    try { data = await res.json(); } catch {}
    return { ok: res.ok, data };
  }

  async function boot() {
    const me = await (await fetch('/api/community/me')).json();
    if (!me.signedIn) {
      window.location.href = '/collective/login/';
      return;
    }
    if (me.lapsed) {
      // The portal shows the "update your payment details" panel.
      window.location.href = '/collective/portal/';
      return;
    }

    $('loading').hidden = true;
    $('main').hidden = false;
    $('me-name').textContent = me.member.name || 'Member';
    const av = document.getElementById('me-avatar') as HTMLImageElement;
    if (me.member.avatar_url) {
      av.src = me.member.avatar_url;
      av.hidden = false;
    }

    $('signout-btn').addEventListener('click', async () => {
      await fetch('/api/community/logout', { method: 'POST' });
      window.location.href = '/collective/';
    });

    $('tab-upcoming').addEventListener('click', () => switchTab('upcoming'));
    $('tab-past').addEventListener('click', () => switchTab('past'));
    $('f-save').addEventListener('click', save);
    $('f-cancel').addEventListener('click', resetForm);

    load();
  }

  function switchTab(next: 'upcoming' | 'past') {
    when = next;
    $('tab-upcoming').classList.toggle('is-active', next === 'upcoming');
    $('tab-past').classList.toggle('is-active', next === 'past');
    load();
  }

  async function load() {
    const { ok, data } = await api(`/api/community/events?when=${when}`);
    if (!ok) return;

    canManage = data.can_manage;
    $('event-form').hidden = !canManage;

    const list = $('list');
    list.textContent = '';

    for (const e of data.events) {
      list.appendChild(renderEvent(e));
    }
    $('empty').hidden = data.events.length > 0;
  }

  function renderEvent(e: any) {
    const card = el('article', 'event-card' + (e.status === 'cancelled' ? ' is-cancelled' : ''));

    const top = el('div', 'e-top');
    top.appendChild(el('span', `e-kind e-kind--${e.kind}`, KIND_LABEL[e.kind] || e.kind));
    if (e.status === 'cancelled') top.appendChild(el('span', 'e-cancelled', 'Cancelled'));
    card.appendChild(top);

    card.appendChild(el('h3', 'e-title', e.title));
    card.appendChild(el('p', 'e-when', formatWhen(e.starts_at, e.timezone_note)));

    const meta = el('div', 'e-meta');
    if (e.location) meta.appendChild(el('span', '', e.location));
    if (e.host_name) meta.appendChild(el('span', '', `With ${e.host_name}`));
    if (e.capacity > 0) {
      meta.appendChild(el('span', '', `${e.rsvp_count}/${e.capacity} going`));
    } else if (e.rsvp_count > 0) {
      meta.appendChild(el('span', '', `${e.rsvp_count} going`));
    }
    if (meta.children.length) card.appendChild(meta);

    if (e.description) card.appendChild(el('p', 'e-description', e.description));

    const actions = el('div', 'e-actions');

    if (e.status !== 'cancelled' && when === 'upcoming') {
      const rsvp = el('button', 'e-btn' + (e.going ? ' e-btn--going' : ''),
        e.going ? "You're going" : "I'll be there");
      rsvp.addEventListener('click', async () => {
        (rsvp as HTMLButtonElement).disabled = true;
        const { ok, data } = await api('/api/community/rsvp', {
          method: e.going ? 'DELETE' : 'POST',
          body: JSON.stringify({ event_id: e.id }),
        });
        (rsvp as HTMLButtonElement).disabled = false;
        if (!ok) { window.alert(data.error || 'Could not update your RSVP.'); return; }
        e.going = data.going;
        e.rsvp_count = data.rsvp_count;
        load();
      });
      actions.appendChild(rsvp);

      if (e.link) {
        const link = document.createElement('a');
        link.className = 'e-btn e-btn--ghost';
        link.href = e.link;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = e.kind === 'retreat' ? 'Details & booking' : 'Join link';
        actions.appendChild(link);
      }
    }

    if (canManage) {
      const edit = el('button', 'e-link', 'Edit');
      edit.addEventListener('click', () => startEdit(e));
      actions.appendChild(edit);

      if (e.status !== 'cancelled') {
        const cancel = el('button', 'e-link e-link--danger', 'Cancel');
        cancel.addEventListener('click', async () => {
          if (!window.confirm(`Cancel "${e.title}"? Members who RSVP'd will see it as cancelled.`)) return;
          const { ok } = await api('/api/community/events', {
            method: 'DELETE',
            body: JSON.stringify({ id: e.id }),
          });
          if (ok) load();
        });
        actions.appendChild(cancel);
      }
    }

    if (actions.children.length) card.appendChild(actions);
    return card;
  }

  // ---- organiser form ----------------------------------------

  function localValue(iso: string) {
    if (!iso) return '';
    const d = new Date(iso);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function startEdit(e: any) {
    editingId = e.id;
    $('form-heading').textContent = 'Edit event';
    ($('f-save') as HTMLButtonElement).textContent = 'Save changes';
    $('f-cancel').hidden = false;
    (document.getElementById('f-kind') as HTMLSelectElement).value = e.kind;
    (document.getElementById('f-title') as HTMLInputElement).value = e.title;
    (document.getElementById('f-starts') as HTMLInputElement).value = localValue(e.starts_at);
    (document.getElementById('f-ends') as HTMLInputElement).value = localValue(e.ends_at);
    (document.getElementById('f-tz') as HTMLInputElement).value = e.timezone_note || '';
    (document.getElementById('f-location') as HTMLInputElement).value = e.location || '';
    (document.getElementById('f-link') as HTMLInputElement).value = e.link || '';
    (document.getElementById('f-host') as HTMLInputElement).value = e.host_name || '';
    (document.getElementById('f-capacity') as HTMLInputElement).value = String(e.capacity || 0);
    (document.getElementById('f-description') as HTMLTextAreaElement).value = e.description || '';
    $('event-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetForm() {
    editingId = null;
    $('form-heading').textContent = 'Add an event';
    ($('f-save') as HTMLButtonElement).textContent = 'Add event';
    $('f-cancel').hidden = true;
    for (const id of ['f-title', 'f-starts', 'f-ends', 'f-tz', 'f-location', 'f-link', 'f-host', 'f-description']) {
      (document.getElementById(id) as HTMLInputElement).value = '';
    }
    (document.getElementById('f-capacity') as HTMLInputElement).value = '0';
    $('f-error').textContent = '';
  }

  async function save() {
    const error = $('f-error');
    error.textContent = '';

    const starts = (document.getElementById('f-starts') as HTMLInputElement).value;
    const ends = (document.getElementById('f-ends') as HTMLInputElement).value;

    const body: any = {
      kind: (document.getElementById('f-kind') as HTMLSelectElement).value,
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      // datetime-local is local time; toISOString converts to UTC for storage
      starts_at: starts ? new Date(starts).toISOString() : '',
      ends_at: ends ? new Date(ends).toISOString() : '',
      timezone_note: (document.getElementById('f-tz') as HTMLInputElement).value,
      location: (document.getElementById('f-location') as HTMLInputElement).value,
      link: (document.getElementById('f-link') as HTMLInputElement).value,
      host_name: (document.getElementById('f-host') as HTMLInputElement).value,
      capacity: Number((document.getElementById('f-capacity') as HTMLInputElement).value) || 0,
      description: (document.getElementById('f-description') as HTMLTextAreaElement).value,
    };
    if (editingId) body.id = editingId;

    const { ok, data } = await api('/api/community/events', {
      method: editingId ? 'PUT' : 'POST',
      body: JSON.stringify(body),
    });

    if (!ok) {
      error.textContent = data.error || 'Could not save that event.';
      return;
    }
    resetForm();
    load();
  }

  boot();
</script>

<style>
  .events-page {
    max-width: 760px;
  }

  .loading,
  .events-empty {
    text-align: center;
    color: var(--color-text-light);
    padding: var(--space-2xl) 0;
  }

  /* Organiser form */
  .event-form {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .event-form h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-purple);
    margin-bottom: var(--space-md);
  }

  .form-row {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .event-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .event-form label span {
    opacity: 0.7;
  }

  .event-form label.grow {
    flex: 1 1 200px;
  }

  .event-form label.block {
    display: block;
    margin-top: var(--space-sm);
  }

  .event-form input,
  .event-form select,
  .event-form textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    width: 100%;
    color: var(--color-text);
  }

  .form-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .form-actions button {
    background: var(--color-purple);
    color: var(--color-white);
    border: none;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .form-actions .ghost {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
  }

  .form-error {
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }

  /* Tabs */
  .tabs {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 0 0.35rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-light);
    cursor: pointer;
  }

  .tab.is-active {
    color: var(--color-purple);
    border-bottom-color: var(--color-terracotta);
  }

  /* Event cards */
  #list :global(.event-card) {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  #list :global(.event-card.is-cancelled) {
    opacity: 0.6;
  }

  #list :global(.e-top) {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  #list :global(.e-kind) {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--color-lavender);
    color: var(--color-purple);
  }

  #list :global(.e-kind--presentation) {
    background: var(--color-cream-dark);
    color: var(--color-earth);
  }

  #list :global(.e-kind--retreat) {
    background: #e8efe3;
    color: var(--color-sage-dark);
  }

  #list :global(.e-cancelled) {
    font-size: var(--text-xs);
    color: var(--color-terracotta-dark);
  }

  #list :global(.e-title) {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-purple);
    margin-bottom: 0.15rem;
  }

  #list :global(.e-when) {
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
  }

  #list :global(.e-meta) {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  #list :global(.e-description) {
    margin-top: var(--space-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  #list :global(.e-actions) {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  #list :global(.e-btn) {
    background: var(--color-purple);
    color: var(--color-white);
    border: none;
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  #list :global(.e-btn--going) {
    background: var(--color-sage-dark);
  }

  #list :global(.e-btn--ghost) {
    background: none;
    border: 1px solid var(--color-purple);
    color: var(--color-purple);
  }

  #list :global(.e-link) {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text-light);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  #list :global(.e-link:hover) {
    color: var(--color-purple);
  }

  #list :global(.e-link--danger:hover) {
    color: var(--color-terracotta-dark);
  }
</style>
