---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Sign in to the Collective"
  description="Sign in to the Montessori Adolescent Collective."
  heroTitle="Sign in"
  heroSubtitle="With your password, or an emailed link."
  noindex
>
  <div class="container login-wrap">
    <form id="login-form" class="login-card">
      <label for="email">Your email address</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <label for="password">Password <span class="label-hint">(if you've set one)</span></label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        placeholder="Your password"
      />
      <button type="submit" id="submit-btn">Sign in</button>

      <div class="login-divider" role="presentation"><span>or</span></div>

      <button type="button" id="link-btn" class="btn-secondary">Email me a sign-in link</button>
      <p class="login-hint">
        No password, or forgotten it? The emailed link signs you in without one —
        it works once and expires in 20 minutes. You can set or change your
        password afterwards from Edit profile.
      </p>
      <p class="login-message" id="message" role="status" aria-live="polite"></p>
    </form>

    <p class="login-alt">
      Not a member yet? <a href="/collective/">Read about the Collective</a>.
    </p>
  </div>
</PageLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const signinBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const linkBtn = document.getElementById('link-btn') as HTMLButtonElement;
  const message = document.getElementById('message') as HTMLParagraphElement;

  function setMessage(text: string, ok = false) {
    message.textContent = text;
    message.className = `login-message${text ? (ok ? ' login-message--ok' : ' login-message--error') : ''}`;
  }

  // Password sign-in.
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setMessage('');

    if (!passwordInput.value) {
      setMessage('Type your password, or use the emailed link below.');
      return;
    }

    signinBtn.disabled = true;
    signinBtn.textContent = 'Signing in…';

    try {
      const res = await fetch('/api/community/auth-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value, password: passwordInput.value }),
      });
      const data = await res.json();

      if (res.ok) {
        window.location.href = data.needsGuidelines
          ? '/collective/guidelines/'
          : data.needsProfile
            ? '/collective/portal/?welcome=1'
            : '/collective/start-here/';
        return;
      }
      setMessage(data.error || 'Sign-in failed. Please try again.');
    } catch {
      setMessage('Could not reach the server. Please try again.');
    } finally {
      signinBtn.disabled = false;
      signinBtn.textContent = 'Sign in';
    }
  });

  // Magic link — also the "forgot password" path.
  linkBtn.addEventListener('click', async () => {
    setMessage('');
    if (!emailInput.reportValidity()) return;

    linkBtn.disabled = true;
    linkBtn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/community/auth-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value }),
      });
      const data = await res.json();

      if (res.ok) {
        setMessage(data.message || 'Check your email for a sign-in link.', true);
      } else {
        setMessage(data.error || 'Something went wrong. Please try again.');
      }
    } catch {
      setMessage('Could not reach the server. Please try again.');
    } finally {
      linkBtn.disabled = false;
      linkBtn.textContent = 'Email me a sign-in link';
    }
  });
</script>

<style>
  .login-wrap {
    max-width: 460px;
  }

  .login-card {
    background: var(--color-white);
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  label {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-xs);
  }

  input {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    margin-bottom: var(--space-lg);
  }

  input:focus {
    outline: 2px solid var(--color-lavender-dark);
    outline-offset: 1px;
  }

  button {
    background: var(--color-purple);
    color: var(--color-white);
    border: none;
    padding: 0.95rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .label-hint {
    color: var(--color-text-light);
    text-transform: none;
    font-weight: 400;
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
    color: var(--color-text-light);
    font-size: var(--text-sm);
  }

  .login-divider::before,
  .login-divider::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--color-border);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-purple);
    border: 1px solid var(--color-purple);
  }

  .login-hint {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .login-message {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }

  .login-message--ok {
    color: var(--color-sage-dark);
  }

  .login-message--error {
    color: var(--color-terracotta-dark);
  }

  .login-alt {
    margin-top: var(--space-xl);
    text-align: center;
    color: var(--color-text-light);
    font-size: var(--text-sm);
  }

  .login-alt a {
    color: var(--color-purple);
  }
</style>
