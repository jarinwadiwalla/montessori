---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PortalNav from '../../components/collective/PortalNav.astro';

// The curated shelf: resources the site itself publishes.
//
// Only entries that actually have a file are shown. There used to be
// "Coming soon" placeholders here for entries without one, which meant the
// shelf advertised things members couldn't open. An entry appears the day
// it has a downloadUrl and not before.
const resources = (await getCollection('resources'))
  .filter((r) => {
    const url = r.data.downloadUrl || '';
    return url.startsWith('/') || url.startsWith('http');
  })
  .sort((a, b) => (a.data.title > b.data.title ? 1 : -1));

// Must stay in step with TYPES in functions/lib/community-files.js.
const ACCEPT = '.pdf,.jpg,.jpeg,.png,.gif,.webp,.docx,.doc,.pptx,.ppt,.xlsx,.xls';
---

<PageLayout
  title="Resources"
  description="Documents and materials shared by Collective members."
  noindex
>
  <div class="container resources-page">
    <p class="loading" id="loading">Loading…</p>

    <div id="main" hidden>
      <PortalNav active="resources" />

      <header class="portal-page-head">
        <h1>Resources</h1>
        <p>Guides from us, and a shared library the whole Collective fills.</p>
      </header>

      {resources.length > 0 && (
        <section class="res-section">
          <h2 class="res-heading">From the Collective</h2>
          <div class="resource-list">
            {resources.map((r) => (
              <article class="resource-card">
                <h3>{r.data.title}</h3>
                <p>{r.data.description}</p>
                <a class="res-btn" href={r.data.downloadUrl} target="_blank" rel="noopener">Open</a>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="res-section drive">
        <!-- Toolbar: breadcrumb on the left, actions on the right. The
             breadcrumb is what tells you whether you're looking at the
             shelves or inside one of them. -->
        <div class="drive-bar">
          <nav class="crumbs" id="crumbs" aria-label="Folder path"></nav>
          <div class="drive-actions" id="drive-actions"></div>
        </div>

        <p class="res-error" id="folders-error" role="alert" hidden></p>

        <!-- Grid of folders -->
        <div class="folder-grid" id="folder-grid"></div>

        <!-- Inside one folder -->
        <div class="file-table" id="file-table" hidden>
          <div class="file-head">
            <span class="col-name">Name</span>
            <span class="col-owner">Uploaded by</span>
            <span class="col-date">Date</span>
            <span class="col-size">Size</span>
            <span class="col-act"></span>
          </div>
          <div id="file-rows"></div>
          <p class="drive-empty" id="folder-empty" hidden>
            Nothing in here yet. Use <strong>Upload</strong> to add the first document.
          </p>
        </div>

        <p class="drive-note">
          Anything you upload is visible to every member, and to nobody else.
          Please only share what's yours to share — see the
          <a href="/collective/guidelines/">guidelines</a>.
        </p>
      </section>

      <p class="resources-note">
        Looking for something that isn't here? Ask on the
        <a href="/collective/portal/">board</a> — chances are someone has it.
      </p>
    </div>
  </div>

  <input type="file" id="file-input" accept={ACCEPT} hidden />
</PageLayout>

<script>
  const $ = (id: string) => document.getElementById(id)!;

  let folders: any[] = [];
  let openFolderId = '';   // '' means the folder grid

  const KIND_LABEL: Record<string, string> = {
    pdf: 'PDF',
    image: 'IMG',
    doc: 'DOC',
    slides: 'PPT',
    sheet: 'XLS',
  };

  function el(tag: string, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text; // never innerHTML
    return n;
  }

  function icon(paths: string, cls: string) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('class', cls);
    svg.setAttribute('aria-hidden', 'true');
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('d', paths);
    svg.appendChild(p);
    return svg;
  }

  const FOLDER_PATH =
    'M4 5h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z';

  function fileSize(bytes: number) {
    if (!bytes) return '—';
    if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
    return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
  }

  function shortDate(iso: string) {
    return new Date(iso).toLocaleDateString(undefined, {
      day: 'numeric', month: 'short', year: 'numeric',
    });
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      headers: { 'Content-Type': 'application/json' },
      ...options,
    });
    let data: any = {};
    try { data = await res.json(); } catch {}
    return { ok: res.ok, data };
  }

  function showError(msg: string) {
    const box = $('folders-error');
    box.textContent = msg;
    box.hidden = !msg;
  }

  const current = () => folders.find((f) => f.id === openFolderId);

  // --- chrome ---------------------------------------------------

  function renderBar() {
    const crumbs = $('crumbs');
    const actions = $('drive-actions');
    crumbs.textContent = '';
    actions.textContent = '';

    const root = el('button', 'crumb', 'Shared folders');
    root.setAttribute('type', 'button');

    if (!openFolderId) {
      root.classList.add('is-current');
      crumbs.appendChild(root);

      const add = el('button', 'res-action res-action--primary', 'New folder');
      add.setAttribute('type', 'button');
      add.addEventListener('click', newFolder);
      actions.appendChild(add);
      return;
    }

    root.addEventListener('click', () => openGrid());
    crumbs.appendChild(root);
    crumbs.appendChild(el('span', 'crumb-sep', '/'));

    const f = current();
    crumbs.appendChild(el('span', 'crumb is-current', f?.name || 'Folder'));

    const upload = el('button', 'res-action res-action--primary', 'Upload');
    upload.setAttribute('type', 'button');
    upload.addEventListener('click', () => ($('file-input') as HTMLInputElement).click());
    actions.appendChild(upload);

    if (f?.can_edit) {
      const rename = el('button', 'res-action', 'Rename');
      rename.setAttribute('type', 'button');
      rename.addEventListener('click', () => renameFolder(f));
      actions.appendChild(rename);

      const del = el('button', 'res-action res-action--quiet', 'Delete folder');
      del.setAttribute('type', 'button');
      del.addEventListener('click', () => deleteFolder(f));
      actions.appendChild(del);
    }
  }

  // --- grid of folders ------------------------------------------

  function openGrid() {
    openFolderId = '';
    $('folder-grid').hidden = false;
    $('file-table').hidden = true;
    renderBar();
    renderGrid();
  }

  function renderGrid() {
    const grid = $('folder-grid');
    grid.textContent = '';

    for (const f of folders) {
      const tile = el('button', 'folder-tile');
      tile.setAttribute('type', 'button');

      // Title first, then the folder, then the count beneath it.
      tile.appendChild(el('span', 'tile-name', f.name));
      tile.appendChild(icon(FOLDER_PATH, 'folder-icon'));
      const n = f.documents.length;
      tile.appendChild(
        el('span', 'tile-count', n === 1 ? '1 document' : `${n} documents`)
      );

      tile.addEventListener('click', () => openFolder(f.id));
      grid.appendChild(tile);
    }
  }

  // --- inside a folder ------------------------------------------

  function openFolder(id: string) {
    openFolderId = id;
    $('folder-grid').hidden = true;
    $('file-table').hidden = false;
    renderBar();
    renderFiles();
  }

  function renderFiles() {
    const f = current();
    const rows = $('file-rows');
    rows.textContent = '';

    const docs = f?.documents || [];
    $('folder-empty').hidden = docs.length > 0;

    for (const d of docs) rows.appendChild(renderRow(d));
  }

  function renderRow(d: any) {
    const row = el('div', 'file-row');

    // Name cell: type chip + title
    const name = el('div', 'col-name');
    name.appendChild(el('span', `kind-chip kind-chip--${d.kind}`, KIND_LABEL[d.kind] || 'FILE'));
    const label = el('span', 'file-name', d.title);
    name.appendChild(label);
    row.appendChild(name);

    row.appendChild(el('span', 'col-owner', d.uploader_name));
    row.appendChild(el('span', 'col-date', shortDate(d.created_at)));
    row.appendChild(el('span', 'col-size', fileSize(d.size)));

    const act = el('div', 'col-act');

    if (d.previewable) {
      const preview = el('button', 'res-action', 'Preview');
      preview.setAttribute('type', 'button');
      preview.addEventListener('click', () => {
        window.open(d.url, '_blank', 'noopener,width=1000,height=800');
      });
      act.appendChild(preview);
      // Double-clicking the row opens it too, the way a file manager does.
      row.addEventListener('dblclick', () => {
        window.open(d.url, '_blank', 'noopener,width=1000,height=800');
      });
    }

    const download = el('a', 'res-action', 'Download') as HTMLAnchorElement;
    download.href = `${d.url}?download=1`;
    act.appendChild(download);

    if (d.can_delete) {
      const del = el('button', 'res-action res-action--quiet', 'Delete');
      del.setAttribute('type', 'button');
      del.addEventListener('click', () => deleteDoc(d));
      act.appendChild(del);
    }

    row.appendChild(act);
    return row;
  }

  // --- data + actions -------------------------------------------

  async function loadFolders(keepOpen = true) {
    const { ok, data } = await api('/api/community/folders');
    if (!ok) {
      showError(data.error || 'The folders could not be loaded.');
      return;
    }
    folders = data.folders;

    // If the folder we were inside has gone, fall back to the grid.
    if (keepOpen && openFolderId && current()) {
      openFolder(openFolderId);
    } else {
      openGrid();
    }
  }

  async function newFolder() {
    const name = window.prompt('Name the folder');
    if (!name) return;
    const { ok, data } = await api('/api/community/folders', {
      method: 'POST',
      body: JSON.stringify({ name }),
    });
    if (!ok) return showError(data.error || 'That folder could not be created.');
    showError('');
    loadFolders();
  }

  async function renameFolder(f: any) {
    const name = window.prompt('Rename the folder', f.name);
    if (!name || name === f.name) return;
    const { ok, data } = await api('/api/community/folders', {
      method: 'PUT',
      body: JSON.stringify({ id: f.id, name }),
    });
    if (!ok) return showError(data.error || 'That folder could not be renamed.');
    showError('');
    loadFolders();
  }

  async function deleteFolder(f: any) {
    if (!window.confirm(`Delete the folder "${f.name}"?`)) return;
    const { ok, data } = await api('/api/community/folders', {
      method: 'DELETE',
      body: JSON.stringify({ id: f.id }),
    });
    if (!ok) return showError(data.error || 'That folder could not be deleted.');
    showError('');
    openFolderId = '';
    loadFolders(false);
  }

  async function deleteDoc(d: any) {
    if (!window.confirm(`Remove "${d.title}"? This cannot be undone.`)) return;
    const { ok, data } = await api('/api/community/documents', {
      method: 'DELETE',
      body: JSON.stringify({ id: d.id }),
    });
    if (!ok) return showError(data.error || 'That document could not be removed.');
    showError('');
    loadFolders();
  }

  async function handleFile(e: Event) {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file || !openFolderId) return;

    showError(`Uploading ${file.name}…`);

    const form = new FormData();
    form.append('file', file);
    form.append('folder_id', openFolderId);

    let data: any = {};
    let ok = false;
    try {
      // No Content-Type header: the browser sets the multipart boundary.
      const res = await fetch('/api/community/documents', { method: 'POST', body: form });
      ok = res.ok;
      try { data = await res.json(); } catch {}
    } catch {
      /* handled below */
    }

    input.value = '';
    if (!ok) return showError(data.error || 'That upload did not work.');
    showError('');
    loadFolders();
  }

  // --- boot -----------------------------------------------------

  async function boot() {
    const me = await (await fetch('/api/community/me')).json();
    if (!me.signedIn) {
      window.location.href = '/collective/login/';
      return;
    }
    if (me.lapsed) {
      window.location.href = '/collective/portal/';
      return;
    }

    $('loading').hidden = true;
    $('main').hidden = false;
    $('me-name').textContent = me.member.name || 'Member';
    const av = document.getElementById('me-avatar') as HTMLImageElement;
    if (me.member.avatar_url) {
      av.src = me.member.avatar_url;
      av.hidden = false;
    }

    $('signout-btn').addEventListener('click', async () => {
      await fetch('/api/community/logout', { method: 'POST' });
      window.location.href = '/collective/';
    });

    $('file-input').addEventListener('change', handleFile);

    loadFolders(false);
  }

  boot();
</script>

<style>
  .resources-page { max-width: 1040px; }

  .loading {
    text-align: center;
    color: var(--color-text-light);
    padding: var(--space-2xl) 0;
  }

  .res-section { margin-bottom: var(--space-2xl); }

  .res-heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-md);
  }

  /* --- curated shelf --- */

  .resource-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .resource-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .resource-card h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .resource-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .res-btn {
    align-self: flex-start;
    border: 1px solid var(--color-terracotta);
    color: var(--color-terracotta-dark);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .res-btn:hover { background: var(--color-cream); }

  /* --- drive: toolbar --- */

  .drive-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .crumb {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text-light);
    cursor: pointer;
  }

  button.crumb:hover { color: var(--color-terracotta-dark); }

  .crumb.is-current {
    color: var(--color-earth-dark);
    cursor: default;
  }

  .crumb-sep { color: var(--color-cream-dark); font-size: var(--text-xl); }

  .drive-actions { display: flex; gap: var(--space-xs); flex-wrap: wrap; }

  .res-action {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font-family: inherit;
    font-size: var(--text-xs);
    color: var(--color-text-light);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .res-action:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta-dark);
  }

  .res-action--primary {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta-dark);
  }

  .res-action--quiet:hover {
    border-color: var(--color-earth-light);
    color: var(--color-earth);
  }

  .res-error {
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--color-cream);
    color: var(--color-terracotta-dark);
    font-size: var(--text-sm);
  }

  /* --- drive: folder tiles --- */

  .folder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-sm);
  }

  .folder-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    font-family: inherit;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .folder-tile:hover {
    background: var(--color-cream);
    border-color: var(--color-terracotta);
  }

  .folder-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    fill: var(--color-terracotta);
  }

  .tile-name {
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--color-text);
    /* Always two lines tall, clipped at two. Reserving the space means the
       folder icon and count sit on the same line across the whole row —
       otherwise a one-line name lifts them 16px above their neighbours. */
    min-height: 2.6em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-count {
    font-size: 11px;
    color: var(--color-text-light);
  }

  /* --- drive: file table --- */

  .file-table {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    overflow: hidden;
  }

  .file-head,
  .file-row {
    display: grid;
    /* The action column is a fixed width, not auto: with auto, a row
       holding three buttons sizes its column wider than a row holding
       one, and every column to its left shifts. Columns must line up
       down the table. */
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr) 110px 80px 232px;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-lg);
  }

  .file-head {
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
  }

  .file-row {
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .file-row:last-child { border-bottom: none; }
  .file-row:hover { background: var(--color-cream); }

  .col-name {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  .file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .col-owner,
  .col-date,
  .col-size {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .col-act { display: flex; gap: var(--space-xs); justify-content: flex-end; }

  .kind-chip {
    flex-shrink: 0;
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    font-size: 10px;
    letter-spacing: 0.06em;
    background: var(--color-cream-dark);
    color: var(--color-earth);
  }

  .kind-chip--pdf { background: var(--color-terracotta); color: var(--color-white); }
  .kind-chip--image { background: var(--color-sage-light); color: var(--color-earth-dark); }
  .kind-chip--doc { background: var(--color-earth-light); color: var(--color-white); }
  .kind-chip--slides { background: var(--color-terracotta-light); color: var(--color-earth-dark); }
  .kind-chip--sheet { background: var(--color-sage); color: var(--color-white); }

  .drive-empty {
    margin: 0;
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .drive-note,
  .resources-note {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
  }

  .drive-note { margin-top: var(--space-md); }

  /* Columns that stop earning their space on a narrow screen. */
  @media (max-width: 760px) {
    .file-head { display: none; }

    .file-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
      padding: var(--space-md) var(--space-lg);
    }

    .col-date, .col-size { display: none; }
    .col-act { justify-content: flex-start; }
  }
</style>
