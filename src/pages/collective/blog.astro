---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PortalNav from '../../components/collective/PortalNav.astro';

// The site's blog, gathered into the portal so members don't have to go
// looking for it. The posts themselves stay on the public blog — they're
// written to be found by search engines, and duplicating them behind the
// login would compete with the pages doing that work. This is a shelf
// pointing at them, newest first, and it fills itself whenever a post is
// published from Guru.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<PageLayout
  title="MFA Blog"
  description="Blog posts from Montessori for Adolescents, for Collective members."
  noindex
>
  <div class="container blog-page">
    <p class="loading" id="loading">Loading…</p>

    <div id="main" hidden>
      <PortalNav active="blog" />

      <header class="portal-page-head">
        <h1>MFA Blog</h1>
        <p>Reflections from work with adolescents, newest first.</p>
      </header>

      {posts.length === 0 ? (
        <p class="blog-empty">No posts yet.</p>
      ) : (
        <div class="post-list">
          {posts.map((p) => (
            <article class="post-row">
              {p.data.image && (
                <img class="post-thumb" src={p.data.image} alt="" width="160" height="110" loading="lazy" />
              )}
              <div class="post-text">
                <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
                <p class="post-meta">{fmt(p.data.publishDate)} · {p.data.author}</p>
                <p class="post-desc">{p.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      )}

      <p class="blog-note">
        Posts open on the public blog, so they're easy to share with someone
        outside the Collective.
      </p>
    </div>
  </div>
</PageLayout>

<script>
  const $ = (id: string) => document.getElementById(id)!;

  async function boot() {
    const me = await (await fetch('/api/community/me')).json();
    if (!me.signedIn) {
      window.location.href = '/collective/login/';
      return;
    }
    if (me.lapsed) {
      window.location.href = '/collective/portal/';
      return;
    }

    $('loading').hidden = true;
    $('main').hidden = false;
    $('me-name').textContent = me.member.name || 'Member';
    const av = document.getElementById('me-avatar') as HTMLImageElement;
    if (me.member.avatar_url) {
      av.src = me.member.avatar_url;
      av.hidden = false;
    }

    $('signout-btn').addEventListener('click', async () => {
      await fetch('/api/community/logout', { method: 'POST' });
      window.location.href = '/collective/';
    });
  }

  boot();
</script>

<style>
  .blog-page { max-width: 1040px; }

  .loading,
  .blog-empty {
    text-align: center;
    color: var(--color-text-light);
    padding: var(--space-2xl) 0;
  }

  .post-list {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    overflow: hidden;
  }

  .post-row {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .post-row:last-child { border-bottom: none; }
  .post-row:hover { background: var(--color-cream); }

  .post-thumb {
    width: 160px;
    height: 110px;
    object-fit: cover;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .post-text { min-width: 0; }

  .post-row h2 {
    margin: 0 0 0.2rem;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .post-row h2 a {
    color: var(--color-earth-dark);
    text-decoration: none;
  }

  .post-row h2 a:hover { color: var(--color-terracotta-dark); }

  .post-meta {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .post-desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
  }

  .blog-note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  @media (max-width: 640px) {
    .post-row { flex-direction: column; gap: var(--space-sm); }
    .post-thumb { width: 100%; height: 160px; }
  }
</style>
