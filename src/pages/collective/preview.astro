---
// A private look at the Collective landing page before it opens.
//
// /collective/ serves Coming Soon while OPEN is false, which means the real
// landing page — the one people will actually be sold on — can't be seen
// anywhere. This route renders it so it can be read and revised ahead of
// launch, without touching what the public sees.
//
// noindex, absent from the sitemap (the allow-list in astro.config.mjs only
// admits /collective/ and /collective/guidelines/), and disallowed in
// robots.txt. Delete this file once the Collective is open — /collective/
// will be showing the same thing.
import PageLayout from '../../layouts/PageLayout.astro';
import LandingContent from '../../components/collective/LandingContent.astro';
---

<PageLayout
  title="Preview — Montessori Adolescent Collective"
  description="Private preview of the Collective landing page."
  heroTitle="The Montessori Adolescent Collective"
  heroSubtitle="A group to connect with adolescent practitioners worldwide."
  heroImage="/images/collective/collective-hero.jpg"
  heroImagePosition="center 32%"
  noindex
>
  <div class="preview-flag">
    <p>
      <strong>Preview only.</strong> This is what <code>/collective/</code> will
      show once the Collective opens. The public page is still Coming Soon —
      nothing here is live.
    </p>
  </div>

  <LandingContent />
</PageLayout>

<style>
  .preview-flag {
    max-width: var(--max-width);
    margin: 0 auto var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border: 1px dashed var(--color-terracotta);
    border-radius: var(--radius-lg);
    background: var(--color-cream);
  }

  .preview-flag p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-earth-dark);
    line-height: var(--leading-relaxed);
  }

  .preview-flag code {
    font-size: 0.9em;
    background: var(--color-cream-dark);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }
</style>
