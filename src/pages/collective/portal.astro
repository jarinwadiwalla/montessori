---
import PageLayout from '../../layouts/PageLayout.astro';
import PortalNav from '../../components/collective/PortalNav.astro';
---

<PageLayout
  title="The Collective"
  description="The Montessori Adolescent Collective member portal."
  noindex
>
  <div class="container portal" id="portal">
    <p class="portal-loading" id="loading">Loading…</p>

    <!-- Shown when dues are unpaid -->
    <section class="lapsed" id="lapsed" hidden>
      <h2>Your membership is on hold</h2>
      <p>
        We weren't able to collect your dues, so the Collective is paused
        rather than closed. Nothing you've posted has been deleted.
      </p>
      <p class="lapsed-note">
        Usually this is just an expired card. Updating it puts everything back
        straight away.
      </p>
      <button id="lapsed-billing" type="button">Update payment details</button>
      <p class="lapsed-help">
        Something else going on? <a href="/contact/">Get in touch</a> — we'd
        rather sort it out than lose you.
      </p>
    </section>

    <!-- Profile setup, shown on first sign-in -->
    <section class="profile-setup" id="profile-setup" hidden>
      <h2>Set up your profile</h2>
      <p class="setup-note">
        This is what other members see. Your email address is never shown.
      </p>
      <label for="profile-name">Display name</label>
      <input id="profile-name" type="text" maxlength="60" placeholder="How you'd like to be known" />

      <label for="profile-country">Country</label>
      <select id="profile-country">
        <option value="">Choose your country…</option>
      </select>
      <p class="setup-note">Shown as a flag by your name, so members can see where everyone is.</p>

      <label for="profile-location">City or region <span>(optional)</span></label>
      <input id="profile-location" type="text" maxlength="80" placeholder="Ubud, Bali" />

      <label for="profile-bio">A line about your work <span>(optional)</span></label>
      <textarea id="profile-bio" maxlength="400" rows="2" placeholder="Guide, 12–18 environment, Bali"></textarea>

      <label class="checkbox-row">
        <input id="profile-exchange" type="checkbox" />
        <span>
          I'm open to exchanges and pen pal programmes
          <small>Shows a badge on your directory listing so others can find you.</small>
        </span>
      </label>

      <label for="profile-avatar">Profile picture <span>(optional)</span></label>
      <input id="profile-avatar" type="file" accept="image/*" />
      <img class="avatar-preview" id="avatar-preview" alt="" hidden />

      <label for="profile-password" id="profile-password-label">
        Password <span>(optional)</span>
      </label>
      <input
        id="profile-password"
        type="password"
        autocomplete="new-password"
        maxlength="200"
        placeholder="At least 8 characters"
      />
      <p class="setup-note" id="profile-password-note">
        With a password you can sign in directly, without waiting for an emailed
        link. Skip it and the email link keeps working as always.
      </p>

      <div class="setup-actions">
        <button id="profile-save">Save and continue</button>
        <button id="profile-cancel" type="button" class="ghost" hidden>Cancel</button>
      </div>
      <p class="form-error" id="profile-error" role="alert"></p>
    </section>

    <!-- Main portal -->
    <div id="portal-main" hidden>
      <PortalNav active="board" />

      <!-- Space header, shown when the feed is filtered to one space -->
      <section class="space-head" id="space-head" hidden>
        <h2 id="space-title"></h2>
        <p id="space-desc"></p>
      </section>

      <!-- Composer -->
      <section class="composer">
        <textarea
          id="composer-body"
          rows="3"
          maxlength="5000"
          placeholder="Share something you're working on, or ask a question… type @name to notify someone"
        ></textarea>

        <div class="composer-attachments" id="composer-attachments"></div>

        <div class="composer-tools">
          <label class="tool-btn">
            Attach image or PDF
            <input type="file" id="file-input" accept="image/*,application/pdf" multiple hidden />
          </label>
          <button class="tool-btn" id="add-video-btn" type="button">Add video link</button>
          <button class="post-btn" id="post-btn" type="button">Post</button>
        </div>
        <p class="form-error" id="composer-error" role="alert"></p>
      </section>

      <!-- Feed -->
      <section class="feed" id="feed"></section>
      <button class="load-more" id="load-more" hidden>Load older posts</button>
      <p class="feed-empty" id="feed-empty" hidden>
        Nothing here yet. Be the first to post something.
      </p>
    </div>
  </div>
</PageLayout>

<script>
  type Member = { id: string; name: string; avatar_url: string; bio?: string; role?: string };

  let me: Member | null = null;
  let hasPassword = false;

  // Which space the board is showing. '' = the home feed (all spaces).
  const SPACES: Record<string, { title: string; desc: string; adminOnly?: boolean }> = {
    'say-hello': {
      title: 'Say hello',
      desc: 'Introduce yourself — who you are, where you work, and what brought you to the third plane.',
    },
    announcements: {
      title: 'Announcements',
      desc: 'News from the Collective team.',
      adminOnly: true,
    },
  };
  const currentSpace = (() => {
    const s = new URLSearchParams(window.location.search).get('space') || '';
    return s in SPACES ? s : '';
  })();
  const portalPath = currentSpace
    ? `/collective/portal/?space=${currentSpace}`
    : '/collective/portal/';

  function flagEmoji(cc: string) {
    if (!/^[A-Z]{2}$/.test(cc || '')) return '';
    return String.fromCodePoint(...[...cc].map((c) => 0x1f1a5 + c.charCodeAt(0)));
  }

  // Country picker: ISO codes only; names and flags are generated by the
  // browser, so no 250-line country list has to live in this file.
  (() => {
    const codes = 'AD AE AF AG AL AM AO AR AT AU AZ BA BB BD BE BF BG BH BI BJ BN BO BR BS BT BW BY BZ CA CD CF CG CH CI CL CM CN CO CR CU CV CY CZ DE DJ DK DM DO DZ EC EE EG ER ES ET FI FJ FM FR GA GB GD GE GH GM GN GQ GR GT GW GY HN HR HT HU ID IE IL IN IQ IR IS IT JM JO JP KE KG KH KI KM KN KP KR KW KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MG MH MK ML MM MN MR MT MU MV MW MX MY MZ NA NE NG NI NL NO NP NR NZ OM PA PE PG PH PK PL PS PT PW PY QA RO RS RU RW SA SB SC SD SE SG SI SK SL SM SN SO SR SS ST SV SY SZ TD TG TH TJ TL TM TN TO TR TT TV TW TZ UA UG US UY UZ VC VE VN VU WS YE ZA ZM ZW'.split(' ');
    const names = new Intl.DisplayNames(['en'], { type: 'region' });
    const select = document.getElementById('profile-country') as HTMLSelectElement;
    codes
      .map((c) => ({ code: c, name: names.of(c) || c }))
      .sort((a, b) => a.name.localeCompare(b.name))
      .forEach(({ code, name }) => {
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = `${flagEmoji(code)} ${name}`;
        select.appendChild(opt);
      });
  })();
  let page = 1;
  let pendingAttachments: any[] = [];
  // Handles that actually belong to someone. Until this loads, nothing is
  // highlighted — better to under-promise than to imply a mention landed.
  let knownHandles = new Set<string>();

  const $ = (id: string) => document.getElementById(id)!;

  // ---- helpers ------------------------------------------------

  function timeAgo(iso: string) {
    const then = new Date(iso).getTime();
    const mins = Math.floor((Date.now() - then) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `${days}d ago`;
    return new Date(iso).toLocaleDateString();
  }

  function el(tag: string, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text; // never innerHTML
    return node;
  }


  // Render body text with @mentions picked out. Every piece is added as a
  // text node or via textContent, so member-written text still can't inject
  // markup — the highlight is built from the matched handle, not from HTML.
  function withMentions(className: string, text: string) {
    const node = document.createElement('p');
    node.className = className;
    const re = /(^|[^\w@.])@([a-z0-9]{2,30})\b/gi;
    let last = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(text))) {
      const at = m.index + m[1].length;
      if (at > last) node.appendChild(document.createTextNode(text.slice(last, at)));
      const handle = m[2].toLowerCase();
      const end = at + 1 + m[2].length;
      if (knownHandles.has(handle)) {
        const span = document.createElement('span');
        span.className = 'mention';
        span.textContent = '@' + m[2];
        node.appendChild(span);
      } else {
        // Not a member — leave it as ordinary text so it doesn't look
        // like someone was notified when they weren't.
        node.appendChild(document.createTextNode(text.slice(at, end)));
      }
      last = end;
    }
    if (last < text.length) node.appendChild(document.createTextNode(text.slice(last)));
    return node;
  }

  function avatarFor(m: { name: string; avatar_url: string }) {
    if (m.avatar_url) {
      const img = document.createElement('img');
      img.className = 'avatar';
      img.src = m.avatar_url;
      img.alt = '';
      img.width = 40;
      img.height = 40;
      return img;
    }
    const initials = (m.name || 'M').trim().charAt(0).toUpperCase();
    return el('span', 'avatar avatar--initial', initials);
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      headers: { 'Content-Type': 'application/json' },
      ...options,
    });
    let data: any = {};
    try { data = await res.json(); } catch {}
    return { ok: res.ok, status: res.status, data };
  }

  // ---- boot ---------------------------------------------------

  async function boot() {
    const { data } = await api('/api/community/me');

    if (!data.signedIn) {
      window.location.href = '/collective/login/';
      return;
    }

    me = data.member;
    hasPassword = !!data.hasPassword;
    $('loading').hidden = true;

    if (data.lapsed) {
      showLapsed();
      return;
    }

    // First sign-in gate: guidelines before anything else.
    if (data.needsGuidelines) {
      window.location.href = '/collective/guidelines/';
      return;
    }

    // Set by the "Edit profile" link immediately before navigating here.
    // Read once and cleared, so a refresh returns to the board and no URL
    // can reopen the editor.
    const wantsEdit = sessionStorage.getItem('apc_edit_profile') === '1';
    sessionStorage.removeItem('apc_edit_profile');

    if (data.needsProfile || wantsEdit) {
      showProfileSetup(data.needsProfile);
    } else {
      showPortal();
      await loadHandles();
      loadFeed(true);
    }
  }

  async function loadHandles() {
    const { ok, data } = await api('/api/community/handles');
    if (ok && Array.isArray(data.handles)) {
      knownHandles = new Set(data.handles.map((h: string) => h.toLowerCase()));
    }
  }

  function showLapsed() {
    $('lapsed').hidden = false;
    $('profile-setup').hidden = true;
    $('portal-main').hidden = true;
  }

  $('lapsed-billing').addEventListener('click', async () => {
    const btn = $('lapsed-billing') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/community/billing', { method: 'POST' });
      const data = await res.json();
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      window.alert(data.error || 'Could not open the billing page.');
    } catch {
      window.alert('Could not reach the server. Please try again.');
    } finally {
      btn.disabled = false;
    }
  });

  let wasFirstSetup = false;

  function showProfileSetup(isFirstSetup = false) {
    wasFirstSetup = isFirstSetup;
    $('profile-setup').hidden = false;
    $('portal-main').hidden = true;

    // Drop ?edit=1 from the address bar straight away. Leaving it there
    // means a refresh — or the browser autocompleting the URL later —
    // reopens the editor, which feels like being stuck in it.
    if (window.location.search) {
      window.history.replaceState({}, '', portalPath);
    }

    // Someone who already has a name is editing, not setting up, so give
    // them a way out without saving. A brand-new member needs a name, so
    // they don't get one. (me.name can't be used for this test — the server
    // substitutes "Member" for a blank name, so it is never falsy.)
    $('profile-cancel').hidden = isFirstSetup;
    (document.getElementById('profile-name') as HTMLInputElement).value = isFirstSetup
      ? ''
      : me?.name || '';
    (document.getElementById('profile-bio') as HTMLTextAreaElement).value = me?.bio || '';
    (document.getElementById('profile-location') as HTMLInputElement).value = me?.location || '';
    (document.getElementById('profile-country') as HTMLSelectElement).value =
      (me as any)?.country || '';
    (document.getElementById('profile-exchange') as HTMLInputElement).checked =
      !!me?.open_to_exchange;
    if (me?.avatar_url) {
      const preview = document.getElementById('avatar-preview') as HTMLImageElement;
      preview.src = me.avatar_url;
      preview.hidden = false;
    }

    const pwInput = document.getElementById('profile-password') as HTMLInputElement;
    pwInput.value = '';
    pwInput.placeholder = hasPassword
      ? 'Leave blank to keep your current password'
      : 'At least 8 characters';
    $('profile-password-note').textContent = hasPassword
      ? 'You have a password. Type a new one to change it, or leave this blank.'
      : 'With a password you can sign in directly, without waiting for an emailed link. Skip it and the email link keeps working as always.';
  }

  function applySpaceUI() {
    const info = currentSpace ? SPACES[currentSpace] : null;
    $('space-head').hidden = !info;
    if (info) {
      $('space-title').textContent = info.title;
      $('space-desc').textContent = info.desc;
      const composer = document.querySelector('.composer') as HTMLElement;
      if (info.adminOnly && me?.role !== 'admin') {
        composer.hidden = true;
      } else if (currentSpace === 'say-hello') {
        (document.getElementById('composer-body') as HTMLTextAreaElement).placeholder =
          'Introduce yourself to the Collective…';
      } else if (currentSpace === 'announcements') {
        (document.getElementById('composer-body') as HTMLTextAreaElement).placeholder =
          'Share an announcement with all members…';
      }
    }
  }

  function showPortal() {
    $('profile-setup').hidden = true;
    $('portal-main').hidden = false;
    applySpaceUI();
    // drop ?edit=1 so a refresh doesn't reopen the editor
    if (window.location.search) {
      window.history.replaceState({}, '', portalPath);
    }
    $('me-name').textContent = me?.name || 'Member';
    const avatar = document.getElementById('me-avatar') as HTMLImageElement;
    if (me?.avatar_url) {
      avatar.src = me.avatar_url;
      avatar.hidden = false;
    } else {
      avatar.hidden = true;
    }
  }

  // ---- profile ------------------------------------------------

  let stagedAvatarUrl: string | null = null;

  (document.getElementById('profile-avatar') as HTMLInputElement).addEventListener(
    'change',
    async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;

      const error = $('profile-error');
      error.textContent = 'Uploading…';

      const form = new FormData();
      form.append('file', file);
      const res = await fetch('/api/community/upload', { method: 'POST', body: form });
      const data = await res.json();

      if (!res.ok) {
        error.textContent = data.error || 'That image could not be uploaded.';
        return;
      }
      stagedAvatarUrl = data.url;
      const preview = document.getElementById('avatar-preview') as HTMLImageElement;
      preview.src = data.url;
      preview.hidden = false;
      error.textContent = '';
    }
  );

  $('profile-save').addEventListener('click', async () => {
    const name = (document.getElementById('profile-name') as HTMLInputElement).value.trim();
    const bio = (document.getElementById('profile-bio') as HTMLTextAreaElement).value.trim();
    const error = $('profile-error');

    if (!name) {
      error.textContent = 'Please add a display name.';
      return;
    }

    const { ok, data } = await api('/api/community/me', {
      method: 'PUT',
      body: JSON.stringify({
        name,
        bio,
        location: (document.getElementById('profile-location') as HTMLInputElement).value.trim(),
        country: (document.getElementById('profile-country') as HTMLSelectElement).value,
        open_to_exchange: (document.getElementById('profile-exchange') as HTMLInputElement).checked,
        avatar_url: stagedAvatarUrl ?? me?.avatar_url ?? '',
      }),
    });

    if (!ok) {
      error.textContent = data.error || 'Could not save your profile.';
      return;
    }

    // The password rides along with the profile save, but only when the
    // member typed one — an empty field means "no change".
    const pwInput = document.getElementById('profile-password') as HTMLInputElement;
    if (pwInput.value) {
      const pw = await api('/api/community/password', {
        method: 'PUT',
        body: JSON.stringify({ password: pwInput.value }),
      });
      if (!pw.ok) {
        error.textContent = pw.data.error || 'Your profile was saved, but that password could not be set.';
        return;
      }
      hasPassword = true;
      pwInput.value = '';
    }

    me = data.member;
    stagedAvatarUrl = null;

    // A brand-new member has just finished setting up — welcome them in
    // properly rather than dropping them into an empty feed.
    if (wasFirstSetup) {
      window.location.href = '/collective/start-here/';
      return;
    }
    showPortal();
    loadFeed(true);
  });

  // Leave the editor without saving. The feed may not have loaded yet,
  // because boot() skips it when it opens the editor straight away.
  $('profile-cancel').addEventListener('click', () => {
    stagedAvatarUrl = null;
    showPortal();
    loadFeed(true);
  });

  attachMentions(document.getElementById('composer-body') as HTMLTextAreaElement);

  $('signout-btn').addEventListener('click', async () => {
    await fetch('/api/community/logout', { method: 'POST' });
    window.location.href = '/collective/';
  });

  // ---- composer -----------------------------------------------

  function renderPendingAttachments() {
    const wrap = $('composer-attachments');
    wrap.textContent = '';
    pendingAttachments.forEach((a, i) => {
      const chip = el('span', 'attachment-chip');
      chip.appendChild(
        el('span', '', a.kind === 'video' ? 'Video link' : a.filename || a.kind)
      );
      const remove = el('button', 'chip-remove', '×');
      remove.setAttribute('aria-label', 'Remove attachment');
      remove.addEventListener('click', () => {
        pendingAttachments.splice(i, 1);
        renderPendingAttachments();
      });
      chip.appendChild(remove);
      wrap.appendChild(chip);
    });
  }

  (document.getElementById('file-input') as HTMLInputElement).addEventListener(
    'change',
    async (e) => {
      const input = e.target as HTMLInputElement;
      const files = Array.from(input.files || []);
      const error = $('composer-error');
      error.textContent = '';

      for (const file of files) {
        if (pendingAttachments.length >= 6) {
          error.textContent = 'You can attach up to 6 items.';
          break;
        }
        error.textContent = `Uploading ${file.name}…`;
        const form = new FormData();
        form.append('file', file);
        const res = await fetch('/api/community/upload', { method: 'POST', body: form });
        const data = await res.json();

        if (!res.ok) {
          error.textContent = data.error || `Could not upload ${file.name}.`;
          continue;
        }
        pendingAttachments.push({
          kind: data.kind,
          url: data.url,
          filename: data.filename,
          size: data.size,
          r2_key: data.r2_key,
        });
        error.textContent = '';
      }
      input.value = '';
      renderPendingAttachments();
    }
  );

  $('add-video-btn').addEventListener('click', () => {
    const url = window.prompt('Paste a YouTube or Vimeo link:');
    if (!url) return;
    if (pendingAttachments.length >= 6) {
      $('composer-error').textContent = 'You can attach up to 6 items.';
      return;
    }
    pendingAttachments.push({ kind: 'video', url: url.trim() });
    renderPendingAttachments();
  });

  $('post-btn').addEventListener('click', async () => {
    const body = (document.getElementById('composer-body') as HTMLTextAreaElement).value.trim();
    const error = $('composer-error');
    const button = $('post-btn') as HTMLButtonElement;

    if (!body && pendingAttachments.length === 0) {
      error.textContent = 'Add a message or an attachment before posting.';
      return;
    }

    button.disabled = true;
    const { ok, data } = await api('/api/community/posts', {
      method: 'POST',
      body: JSON.stringify({
        body,
        attachments: pendingAttachments,
        space: currentSpace || 'general',
      }),
    });
    button.disabled = false;

    if (!ok) {
      error.textContent = data.error || 'Could not post.';
      return;
    }

    (document.getElementById('composer-body') as HTMLTextAreaElement).value = '';
    pendingAttachments = [];
    renderPendingAttachments();
    error.textContent = '';
    page = 1;
    loadFeed(true);
  });

  // ---- feed ---------------------------------------------------

  async function loadFeed(reset = false) {
    if (reset) {
      page = 1;
      $('feed').textContent = '';
    }

    const { ok, data } = await api(
      `/api/community/posts?page=${page}${currentSpace ? `&space=${currentSpace}` : ''}`
    );
    if (!ok) return;

    const feed = $('feed');
    for (const post of data.posts) {
      feed.appendChild(renderPost(post));
    }

    $('feed-empty').hidden = !(reset && data.posts.length === 0);
    ($('load-more') as HTMLButtonElement).hidden = !data.hasMore;
  }

  $('load-more').addEventListener('click', () => {
    page += 1;
    loadFeed(false);
  });

  function renderPost(post: any) {
    const article = el('article', post.pinned ? 'post is-pinned' : 'post');
    article.dataset.postId = post.id;

    if (post.pinned) {
      article.appendChild(el('span', 'pin-flag', 'Pinned'));
    }

    const head = el('header', 'post-head');
    head.appendChild(avatarFor(post.author));
    const meta = el('div', 'post-meta');
    const author = el('span', 'post-author', post.author.name);
    const flag = flagEmoji(post.author.country || '');
    if (flag) author.appendChild(el('span', 'post-flag', ` ${flag}`));
    meta.appendChild(author);
    const time = el('span', 'post-time', timeAgo(post.created_at));
    // On the home feed, show which space a post came from.
    if (!currentSpace && post.space && post.space !== 'general' && SPACES[post.space]) {
      time.appendChild(el('span', 'post-space', SPACES[post.space].title));
    }
    meta.appendChild(time);
    head.appendChild(meta);
    article.appendChild(head);

    if (post.body) {
      article.appendChild(withMentions('post-body', post.body));
    }

    if (post.attachments?.length) {
      const wrap = el('div', 'post-attachments');
      for (const a of post.attachments) {
        wrap.appendChild(renderAttachment(a));
      }
      article.appendChild(wrap);
    }

    // Actions
    const actions = el('div', 'post-actions');

    const commentToggle = el(
      'button',
      'action-btn',
      post.comment_count ? `Comments (${post.comment_count})` : 'Comment'
    );
    actions.appendChild(commentToggle);

    // No per-post report button — anything amiss goes straight to the
    // team (see Start here). Admins can still delete anything.

    if (post.can_pin) {
      const pin = el('button', 'action-btn', post.pinned ? 'Unpin' : 'Pin to top');
      pin.addEventListener('click', async () => {
        (pin as HTMLButtonElement).disabled = true;
        const { ok } = await api('/api/community/posts', {
          method: 'PUT',
          body: JSON.stringify({ id: post.id, action: post.pinned ? 'unpin' : 'pin' }),
        });
        // Reload rather than reorder by hand: a pin changes where the post
        // sits in the list, and moving one card without the rest looks broken.
        if (ok) loadFeed(true);
        else (pin as HTMLButtonElement).disabled = false;
      });
      actions.appendChild(pin);
    }

    if (post.can_delete) {
      const del = el('button', 'action-btn action-btn--danger', 'Delete');
      del.addEventListener('click', async () => {
        if (!window.confirm('Delete this post? This cannot be undone.')) return;
        const { ok } = await api('/api/community/posts', {
          method: 'DELETE',
          body: JSON.stringify({ id: post.id }),
        });
        if (ok) article.remove();
      });
      actions.appendChild(del);
    }

    article.appendChild(actions);

    const commentsWrap = el('div', 'comments');
    commentsWrap.hidden = true;
    article.appendChild(commentsWrap);

    let loaded = false;
    commentToggle.addEventListener('click', async () => {
      commentsWrap.hidden = !commentsWrap.hidden;
      if (!loaded && !commentsWrap.hidden) {
        loaded = true;
        await loadComments(post.id, commentsWrap);
      }
    });

    return article;
  }

  function renderAttachment(a: any) {
    if (a.kind === 'image') {
      const link = document.createElement('a');
      link.href = a.url;
      link.target = '_blank';
      link.rel = 'noopener';
      const img = document.createElement('img');
      img.className = 'attachment-image';
      img.src = a.url;
      img.alt = a.filename || '';
      img.loading = 'lazy';
      link.appendChild(img);
      return link;
    }

    if (a.kind === 'pdf') {
      const link = document.createElement('a');
      link.className = 'attachment-file';
      link.href = a.url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = `📄 ${a.filename || 'Document'}`;
      return link;
    }

    // video — src is an embed URL the server already validated
    const frame = el('div', 'attachment-video');
    const iframe = document.createElement('iframe');
    iframe.src = a.url;
    iframe.loading = 'lazy';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('title', 'Shared video');
    frame.appendChild(iframe);
    return frame;
  }

  // ---- @mention autocomplete -----------------------------------
  //
  // Typing "@" then a few letters offers matching members and inserts the
  // real handle. Mentions are the only thing that notifies anyone here, so
  // a mistyped handle silently reaches nobody — this makes that hard to do
  // by accident.

  let _mentionPeople: any[] | null = null;

  async function mentionPeople() {
    if (_mentionPeople) return _mentionPeople;
    const { ok, data } = await api('/api/community/members');
    // Members without a handle can't be mentioned, so leave them out.
    _mentionPeople = ok ? (data.members || []).filter((m: any) => m.handle) : [];
    return _mentionPeople;
  }

  /** The @word being typed at the caret, or null. */
  function mentionToken(field: HTMLTextAreaElement) {
    const upto = field.value.slice(0, field.selectionStart ?? 0);
    const m = upto.match(/(^|\s)@([a-z0-9_]*)$/i);
    if (!m) return null;
    return { query: m[2].toLowerCase(), start: upto.length - m[2].length - 1 };
  }

  function attachMentions(field: HTMLTextAreaElement | null) {
    if (!field) return;

    // The list is positioned against a wrapper so it can sit under the
    // field without depending on where the field is on screen.
    const holder = el('div', 'mention-holder');
    field.parentNode!.insertBefore(holder, field);
    holder.appendChild(field);

    const list = el('div', 'mention-list');
    list.hidden = true;
    holder.appendChild(list);

    let matches: any[] = [];
    let active = 0;

    const close = () => { list.hidden = true; matches = []; active = 0; };

    function paint() {
      list.textContent = '';
      matches.forEach((m, i) => {
        const row = el('button', `mention-row${i === active ? ' is-active' : ''}`);
        row.setAttribute('type', 'button');
        if (m.avatar_url) {
          const img = el('img', 'mention-avatar') as HTMLImageElement;
          img.src = m.avatar_url;
          img.alt = '';
          row.appendChild(img);
        } else {
          row.appendChild(el('span', 'mention-avatar mention-avatar--blank'));
        }
        const txt = el('span', 'mention-text');
        txt.appendChild(el('span', 'mention-name', m.name));
        txt.appendChild(el('span', 'mention-handle', '@' + m.handle));
        row.appendChild(txt);
        // mousedown, not click: the field blurs first on click and the
        // caret position we need is gone by then.
        row.addEventListener('mousedown', (e) => { e.preventDefault(); choose(m); });
        list.appendChild(row);
      });
      list.hidden = matches.length === 0;
    }

    function choose(m: any) {
      const tok = mentionToken(field);
      if (!tok) return close();
      const before = field.value.slice(0, tok.start);
      const after = field.value.slice(field.selectionStart ?? 0);
      field.value = `${before}@${m.handle} ${after}`;
      const caret = before.length + m.handle.length + 2;
      field.setSelectionRange(caret, caret);
      field.focus();
      close();
    }

    field.addEventListener('input', async () => {
      const tok = mentionToken(field);
      if (!tok) return close();
      const people = await mentionPeople();
      matches = people
        .filter((m: any) =>
          !tok.query ||
          m.handle.toLowerCase().startsWith(tok.query) ||
          m.name.toLowerCase().includes(tok.query))
        .slice(0, 6);
      active = 0;
      paint();
    });

    field.addEventListener('keydown', (e) => {
      if (list.hidden || !matches.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % matches.length; paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + matches.length) % matches.length; paint(); }
      else if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); choose(matches[active]); }
      else if (e.key === 'Escape') { close(); }
    });

    field.addEventListener('blur', () => setTimeout(close, 120));
  }

  // ---- comments -----------------------------------------------

  async function loadComments(postId: string, wrap: HTMLElement) {
    wrap.textContent = '';
    const { ok, data } = await api(`/api/community/comments?post_id=${encodeURIComponent(postId)}`);
    if (!ok) return;

    const list = el('div', 'comment-list');
    for (const c of data.comments) {
      list.appendChild(renderComment(c));
    }
    wrap.appendChild(list);

    const form = el('div', 'comment-form');
    const input = document.createElement('textarea');
    input.rows = 2;
    input.maxLength = 3000;
    input.placeholder = 'Write a reply…';
    const send = el('button', 'comment-send', 'Reply');
    const err = el('p', 'form-error');
    attachMentions(input);

    send.addEventListener('click', async () => {
      const body = input.value.trim();
      if (!body) return;
      (send as HTMLButtonElement).disabled = true;
      const { ok, data } = await api('/api/community/comments', {
        method: 'POST',
        body: JSON.stringify({ post_id: postId, body }),
      });
      (send as HTMLButtonElement).disabled = false;

      if (!ok) {
        err.textContent = data.error || 'Could not post your reply.';
        return;
      }
      err.textContent = '';
      input.value = '';
      list.appendChild(renderComment(data.comment));
    });

    form.appendChild(input);
    form.appendChild(send);
    form.appendChild(err);
    wrap.appendChild(form);
  }

  function renderComment(c: any) {
    const node = el('div', 'comment');
    node.appendChild(avatarFor(c.author));

    const main = el('div', 'comment-main');
    const head = el('div', 'comment-head');
    const cflag = flagEmoji(c.author.country || '');
    head.appendChild(el('span', 'comment-author', c.author.name + (cflag ? ` ${cflag}` : '')));
    head.appendChild(el('span', 'comment-time', timeAgo(c.created_at)));
    main.appendChild(head);
    main.appendChild(withMentions('comment-body', c.body));

    const actions = el('div', 'comment-actions');

    if (c.can_delete) {
      const del = el('button', 'action-btn action-btn--danger', 'Delete');
      del.addEventListener('click', async () => {
        if (!window.confirm('Delete this comment?')) return;
        const { ok } = await api('/api/community/comments', {
          method: 'DELETE',
          body: JSON.stringify({ id: c.id }),
        });
        if (ok) node.remove();
      });
      actions.appendChild(del);
    }

    main.appendChild(actions);
    node.appendChild(main);
    return node;
  }

  // Reporting: rather than a Report button on every post, members bring
  // anything amiss to the team directly (Start here explains how). The
  // /api/community/report endpoint and the Guru reports list still exist
  // if a report flow is ever wanted again.

  boot();
</script>

