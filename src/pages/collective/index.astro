---
import PageLayout from '../../layouts/PageLayout.astro';

// Membership dues. Paste your two Stripe Payment Links here once they
// exist — see COMMUNITY-PORTAL-SETUP.md, step 2.
const monthlyPrice = 5;
const annualPrice = 50; // 12 months for the price of 10
const monthlyLink = '';
const annualLink = '';

const annualFull = monthlyPrice * 12;
const annualSaving = annualFull - annualPrice;
---

<PageLayout
  title="Montessori Adolescent Collective"
  description="A small, private community for Montessori adolescent practitioners — share your work, ask hard questions, and think alongside people who understand the third plane."
  heroTitle="The Montessori Adolescent Collective"
  heroSubtitle="A private place to think alongside people who do this work."
  heroImage="/images/webinars/market-day-group.jpg"
>
  <div class="container collective">
    <section class="intro">
      <img
        src="/images/collective/logo-dark.png"
        alt="The Montessori Adolescent Collective"
        class="collective-logo"
        width="996"
        height="172"
      />
      <p class="tagline">
        A collaborative online community for all things third plane of development.
      </p>
      <p class="est">Est. 2026</p>
      <p class="lede">
        Working with adolescents can be isolating. Most of us are the only person
        in our setting doing it, improvising against a philosophy that was never
        fully written down. The Collective is a small, private space to share what
        you are actually trying, ask the questions you'd rather not ask publicly,
        and hear from people who have run into the same walls.
      </p>
    </section>

    <section class="what">
      <h2>What's inside</h2>
      <div class="what-grid">
        <div class="what-item">
          <h3>Communication board</h3>
          <p>
            One common room rather than a maze of channels. Post a question, a
            plan, a photograph of your space, or a document you're working on —
            and get responses from practitioners, not strangers.
          </p>
        </div>
        <div class="what-item">
          <h3>Monthly gatherings</h3>
          <p>
            We meet as a group each month to think out loud together — bring the
            thing you're stuck on. Dates and joining links live in the Events
            section, with times given for the timezones our members are in.
          </p>
        </div>
        <div class="what-item">
          <h3>Guest presentations</h3>
          <p>
            Sessions with practitioners and specialists working at the edges of
            adolescent work — inside and outside Montessori.
          </p>
        </div>
        <div class="what-item">
          <h3>Resource sharing</h3>
          <p>
            Attach images and PDFs to a post, or link a video. Work plans,
            schedules, land project notes, budgets — the practical artefacts that
            rarely make it into books.
          </p>
        </div>
        <div class="what-item">
          <h3>Exchange &amp; pen pal programmes</h3>
          <p>
            Find the members open to connecting their community with yours, from
            student pen pals to guide-to-guide exchanges. Say you're open to it on
            your profile and you'll appear in the directory.
          </p>
        </div>
        <div class="what-item">
          <h3>In-person retreats</h3>
          <p>
            Time together away from screens. Retreats are announced in Events with
            the details and how to book a place.
          </p>
        </div>
      </div>

      <p class="what-note">
        Everything here is members-only. Nothing posted is visible to the public
        web or to search engines, and your email address is never shown to other
        members.
      </p>
    </section>

    <section class="join">
      <p class="join-eyebrow">Membership dues</p>

      <div class="plans">
        <div class="plan">
          <p class="plan-name">Monthly</p>
          <p class="plan-price">${monthlyPrice}<span>/month</span></p>
          <p class="plan-note">Cancel any time, from inside the Collective.</p>
          {monthlyLink ? (
            <a href={monthlyLink} class="btn-join">Join monthly</a>
          ) : (
            <p class="join-pending">Opening shortly</p>
          )}
        </div>

        <div class="plan plan--featured">
          <p class="plan-badge">Save ${annualSaving}</p>
          <p class="plan-name">Yearly</p>
          <p class="plan-price">${annualPrice}<span>/year</span></p>
          <p class="plan-note">
            Twelve months for the price of ten, paid once a year.
          </p>
          {annualLink ? (
            <a href={annualLink} class="btn-join">Join yearly</a>
          ) : (
            <p class="join-pending">Opening shortly</p>
          )}
        </div>
      </div>

      <p class="join-fine">
        Dues keep the Collective running and stay deliberately low. You can
        switch between monthly and yearly, or cancel, at any time — cancelling
        leaves your access running until the period you've paid for ends.
      </p>
      <p class="join-fine">
        By joining you agree to our <a href="/collective/guidelines/">community guidelines</a>.
      </p>
    </section>

    <section class="already">
      <p>
        Already a member? <a href="/collective/login/">Sign in</a> — there's no
        password, we'll email you a link.
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .collective {
    max-width: 820px;
  }

  .collective-logo {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto var(--space-lg);
  }

  .tagline {
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-purple);
    line-height: var(--leading-relaxed);
  }

  .est {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--text-xs);
    color: var(--color-terracotta-dark);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .lede {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .what-note {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-white);
    border-left: 3px solid var(--color-terracotta);
    border-radius: var(--radius-md);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    font-size: var(--text-sm);
  }

  .what {
    margin-top: var(--space-3xl);
  }

  .what h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-purple);
    margin-bottom: var(--space-xl);
  }

  .what-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  .what-item h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-purple);
    margin-bottom: var(--space-xs);
  }

  .what-item p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .join {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl);
    background: var(--color-lavender);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .join-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-xs);
    color: var(--color-purple-light);
    margin-bottom: var(--space-lg);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    text-align: center;
  }

  .plan {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan--featured {
    outline: 2px solid var(--color-purple);
  }

  .plan-badge {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-terracotta);
    color: var(--color-white);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .plan-name {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .plan-price {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    color: var(--color-purple);
    margin: var(--space-xs) 0;
  }

  .plan-price span {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-purple-light);
  }

  .plan-note {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
    flex: 1;
  }

  .btn-join {
    display: inline-block;
    background: var(--color-purple);
    color: var(--color-white);
    padding: 1rem 2.5rem;
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-sm);
  }

  .join-pending {
    display: inline-block;
    padding: 1rem 2rem;
    border: 1px dashed var(--color-purple-light);
    border-radius: 999px;
    color: var(--color-purple-light);
  }

  .join-fine {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-purple-light);
  }

  .join-fine a,
  .already a {
    color: var(--color-purple);
  }

  .already {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--color-text-light);
  }
</style>
