---
import PageLayout from '../../layouts/PageLayout.astro';
import LandingContent from '../../components/collective/LandingContent.astro';

// The Collective isn't open to the public yet, so this page collects a
// waitlist instead. Flip to true and the full landing page comes back
// exactly as it was — it's preserved in LandingContent.astro, nothing was
// deleted.
const OPEN = false;

const title = OPEN
  ? 'Montessori Adolescent Collective'
  : 'Coming Soon — Montessori Adolescent Collective';

const description = OPEN
  ? 'A small, private community for Montessori adolescent practitioners — share your work, ask hard questions, and think alongside people who understand the third plane.'
  : 'The Montessori Adolescent Collective is opening soon. Add your email to the waitlist and we\'ll let you know when it does.';
---

<PageLayout
  title={title}
  description={description}
  heroTitle="The Montessori Adolescent Collective"
  heroSubtitle="A group to connect with adolescent practitioners worldwide."
  heroImage="/images/webinars/market-day-group.jpg"
>
  {OPEN ? (
    <LandingContent />
  ) : (
    <div class="container soon">
      <img
        src="/images/collective/logo-dark.png"
        alt="The Montessori Adolescent Collective"
        class="soon-logo"
        width="996"
        height="172"
      />

      <p class="soon-eyebrow">Coming soon</p>

      <p class="soon-tagline">
        A collaborative online community for all things third plane of development.
      </p>

      <div class="waitlist">
        <h2>Join the waitlist</h2>
        <p class="waitlist-note">
          Add your email and we'll notify you the moment the community opens.
        </p>

        <form id="waitlist-form" novalidate>
          <div class="waitlist-row">
            <label class="sr-only" for="waitlist-email">Your email address</label>
            <input
              type="email"
              id="waitlist-email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
            <button type="submit" id="waitlist-btn">Notify me</button>
          </div>
          <p class="waitlist-fine">
            We'll only use this to tell you about the Collective. Unsubscribe any time.
          </p>
          <p class="waitlist-message" id="waitlist-message" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>
  )}
</PageLayout>

{!OPEN && (
  <script>
    const form = document.getElementById('waitlist-form') as HTMLFormElement;
    const input = document.getElementById('waitlist-email') as HTMLInputElement;
    const button = document.getElementById('waitlist-btn') as HTMLButtonElement;
    const message = document.getElementById('waitlist-message') as HTMLParagraphElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.textContent = '';
      message.className = 'waitlist-message';

      const email = input.value.trim();
      if (!email || !email.includes('@')) {
        message.textContent = 'Please enter a valid email address.';
        message.className = 'waitlist-message is-error';
        return;
      }

      button.disabled = true;
      button.textContent = 'Adding…';

      try {
        const res = await fetch('/api/community/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        if (res.ok) {
          message.textContent = data.message || "You're on the list.";
          message.className = 'waitlist-message is-ok';
          form.reset();
        } else {
          message.textContent = data.error || 'Something went wrong. Please try again.';
          message.className = 'waitlist-message is-error';
        }
      } catch {
        message.textContent = 'Could not reach the server. Please try again.';
        message.className = 'waitlist-message is-error';
      } finally {
        button.disabled = false;
        button.textContent = 'Notify me';
      }
    });
  </script>
)}

<style>
  .soon {
    max-width: 640px;
    text-align: center;
  }

  .soon-logo {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto var(--space-lg);
  }

  .soon-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--text-xs);
    color: var(--color-terracotta-dark);
    margin-bottom: var(--space-md);
  }

  .soon-tagline {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-purple);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2xl);
  }

  .waitlist {
    background: var(--color-lavender);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl) var(--space-lg);
  }

  .waitlist h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-purple);
    margin-bottom: var(--space-xs);
  }

  .waitlist-note {
    color: var(--color-purple-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }

  .waitlist-row {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .waitlist-row input {
    flex: 1 1 240px;
    max-width: 320px;
    padding: 0.85rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
  }

  .waitlist-row input:focus {
    outline: 2px solid var(--color-purple);
    outline-offset: 1px;
  }

  .waitlist-row button {
    background: var(--color-purple);
    color: var(--color-white);
    border: none;
    padding: 0.85rem 1.8rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
  }

  .waitlist-row button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .waitlist-fine {
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-purple-light);
  }

  .waitlist-message {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    min-height: 1.2em;
  }

  .waitlist-message.is-ok {
    color: var(--color-sage-dark);
  }

  .waitlist-message.is-error {
    color: var(--color-terracotta-dark);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
