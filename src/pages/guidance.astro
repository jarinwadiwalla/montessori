---
import PageLayout from '../layouts/PageLayout.astro';
import ArchPanels from '../components/shared/ArchPanels.astro';
import Button from '../components/shared/Button.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';
import PhotoCarousel from '../components/shared/PhotoCarousel.astro';
---

<PageLayout
  title="Adolescent Program Consulting"
  description="Support for building Montessori adolescent programs, practical guidance to bring your adolescent community to life."
  heroTitle="Education and Support for Adolescent Guides"
  heroImage="/images/ground-up.jpg"
  heroImagePosition="center 15%"
>
  <div class="container">
    <ArchPanels items={['Webinars', 'Downloadable Resources', '1:1 Partnership']} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <p>
        We provide practical, virtual or on-site guidance to help you build a living adolescent community,
        based on Montessori principles. We help you see your vision with the daily flow, the rhythms and
        rituals, and the deep preparation of the adult who will walk alongside these young people.
        Whether we're working together over video calls or in person, we're right there with you
        every step of the way.
      </p>
    </section>
  </div>

  <div class="carousel-section">
    <PhotoCarousel autoplay={true} photos={[
      { src: '/images/guidance-photo-1.jpg', alt: 'Montessori guidance' },
      { src: '/images/guidance-photo-2.jpg', alt: 'Montessori guidance' },
      { src: '/images/guidance-photo-5.jpg', alt: 'Montessori guidance' },
      { src: '/images/guidance-photo-6.jpg', alt: 'Montessori guidance' },
      { src: '/images/guidance-photo-7.jpg', alt: 'Montessori guidance' },
      { src: '/images/guidance-photo-9.jpg', alt: 'Montessori guidance' },
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <h2>Who This Is For</h2>
      <ul class="page-list">
        <li>Communities with established primary programs ready to extend into the adolescent years</li>
        <li>Guides who have completed an orientation to adolescence and are seeking the practical next steps</li>
        <li>Organizations exploring Erdkinder or land-based models of adolescent education</li>
        <li>Anyone called to start a Montessori or alternative adolescent program</li>
      </ul>
    </section>


  </div>

  <section class="ready-banner">
    <div class="container ready-inner">
      <p class="ready-eyebrow">Take the next step</p>
      <h2 class="ready-title">Ready to Start?</h2>
      <p class="ready-sub">Every great program begins with a conversation. We'd love to hear about your vision.</p>
      <a href="/contact/" class="ready-cta">Get in Touch</a>
    </div>
  </section>

  <QuoteBanner
    text="The land is where the child's spirit finds its true nourishment."
    author="Maria Montessori"
    source="From Childhood to Adolescence"
  />
</PageLayout>

<style>
  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
    color: var(--color-earth);
  }

  .page-section p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .page-list {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    padding-left: var(--space-xl);
    margin-block: var(--space-md);
  }

  .page-list li {
    margin-bottom: var(--space-sm);
  }

  .page-list li::marker {
    color: var(--color-terracotta);
  }






  .cta-actions {
    margin-top: var(--space-lg);
    display: flex;
    justify-content: center;
  }

  .carousel-section {
    margin-block: var(--space-3xl);
  }

  /* Ready to Start gradient banner */
  .ready-banner {
    background: linear-gradient(
      135deg,
      #190c28 0%,
      #2e1445 45%,
      #3d1f5a 100%
    );
    padding-block: var(--space-4xl);
    margin-top: var(--space-3xl);
  }

  .ready-inner {
    animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ready-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.55);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ready-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .ready-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 300;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
  }

  .ready-sub {
    font-size: var(--text-base);
    color: rgba(250, 247, 242, 0.6);
    font-weight: 300;
    font-style: italic;
    max-width: 480px;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
    letter-spacing: 0.02em;
  }

  .ready-cta {
    display: inline-block;
    padding: 0.65rem 2rem;
    border: 0.5px solid rgba(208, 144, 91, 0.7);
    color: #d0905b;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.25s, border-color 0.25s, color 0.25s;
  }

  .ready-cta:hover {
    background: rgba(208, 144, 91, 0.12);
    border-color: #d0905b;
    color: #e8a878;
  }
</style>
