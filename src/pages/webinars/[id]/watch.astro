---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const webinars = await getCollection(
    'webinars',
    ({ data }) => !data.hidden && data.recordingAvailable
  );
  return webinars.map((webinar) => ({
    params: { id: webinar.id },
    props: { webinar },
  }));
}

// This builds only the frame. The player is put in, for buyers only, by
// functions/webinars/[id]/watch.js, which answers this address before the
// static file does. The video's address is not in this repo or this build.
const { webinar } = Astro.props;
---

<PageLayout
  title="Your Recording"
  description="Watch your Montessori for Adolescents webinar recording."
  heroTitle="Thank You — Enjoy the Recording"
  heroSubtitle="Your purchase is complete. The full session is ready to watch below."
  noindex
>
  <div class="container watch-wrap">
    <h2 class="watch-title">{webinar.data.title}</h2>

    <!--recording-player-->

    <p class="watch-note">
      This is your personal viewing page — please keep the link to yourself.
      Trouble playing the video? <a href="/contact/">Contact us</a> and we’ll help.
    </p>
  </div>
</PageLayout>

<style>
  .watch-wrap {
    max-width: 900px;
    margin-inline: auto;
    padding-block: var(--space-3xl);
  }

  .watch-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-earth-dark);
    margin-bottom: var(--space-xl);
  }

  /* The player and the "being prepared" notice are put in by the function,
     so they never carry this component's scope attribute: reach them with
     :global(), anchored to an element that does. */
  .watch-wrap :global(.video-frame) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 24px 60px -24px rgba(63, 38, 91, 0.4);
    background: #000;
  }

  .watch-wrap :global(.video-frame iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .watch-wrap :global(.watch-pending) {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-purple);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    padding: var(--space-2xl);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .watch-note {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-normal);
  }

  .watch-wrap :global(.watch-pending a),
  .watch-note a {
    color: var(--color-terracotta-dark);
    text-decoration: underline;
  }
</style>
