---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const webinars = await getCollection('webinars', ({ data }) => !data.hidden);
  return webinars.map((webinar) => ({
    params: { id: webinar.id },
    props: { webinar },
  }));
}

const { webinar } = Astro.props;
const { Content } = await render(webinar);

const team = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order
);

const dateDisplay = webinar.data.eventDate
  ? webinar.data.eventDate.toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : 'Date to be announced';

const isRecording = webinar.data.recordingAvailable;
const price = isRecording
  ? webinar.data.recordingPrice ?? webinar.data.price
  : webinar.data.price;
const buyLink = isRecording
  ? webinar.data.stripeRecordingLink ?? ''
  : webinar.data.stripePaymentLink;
const purchaseOpen = buyLink.startsWith('http');
const buyLabel = isRecording ? 'Get the Recording' : 'Register Now';
const soonLabel = isRecording ? 'Recording Available Soon' : 'Registration Opening Soon';

// Mirror the promo card: set "and Q&A Session" on its own accented line
const qaSuffix = ' and Q&A Session';
const hasQaSuffix = webinar.data.title.endsWith(qaSuffix);
const titleMain = hasQaSuffix ? webinar.data.title.slice(0, -qaSuffix.length) : webinar.data.title;

const heroImageSrc = webinar.data.heroImage ?? webinar.data.image;

const galleryPhotos = [
  { src: '/images/landing-photo-10.jpg', alt: 'Adolescents working together in a Montessori community' },
  { src: '/images/webinars/market-day-candid.jpg', alt: 'Adolescents selling their produce at a farmers market' },
  { src: '/images/guidance-photo-4.jpg', alt: 'Meaningful work in the Montessori adolescent environment' },
];

const eventJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: webinar.data.title,
  description: webinar.data.description,
  ...(webinar.data.eventStartISO
    ? { startDate: webinar.data.eventStartISO }
    : webinar.data.eventDate && {
        startDate: webinar.data.eventDate.toISOString().slice(0, 10),
      }),
  ...(webinar.data.eventEndISO && { endDate: webinar.data.eventEndISO }),
  ...(webinar.data.image && {
    image: new URL(webinar.data.image, Astro.site ?? Astro.url).href,
  }),
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: {
    '@type': 'VirtualLocation',
    url: Astro.url.href,
  },
  organizer: {
    '@type': 'Organization',
    name: 'Montessori for Adolescents',
    url: 'https://montessoriforadolescents.com',
  },
  performer: { '@type': 'Organization', name: 'Montessori for Adolescents' },
  offers: {
    '@type': 'Offer',
    price: price,
    priceCurrency: 'USD',
    url: Astro.url.href,
    availability: 'https://schema.org/InStock',
  },
});
---

<BaseLayout
  title={webinar.data.title}
  description={webinar.data.description}
  image={webinar.data.image}
>
  <script type="application/ld+json" set:html={eventJsonLd} />

  <!-- ===== Hero ===== -->
  <section class="event-hero">
    <div class="hero-glow hero-glow--lavender"></div>
    <div class="hero-glow hero-glow--terracotta"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="event-eyebrow">{isRecording ? 'Webinar Recording · Watch Anytime' : 'Live Webinar · Online'}</p>
        <h1 class="event-title">
          {titleMain}
          {hasQaSuffix && <span class="title-accent">and Q&amp;A Session</span>}
        </h1>

        <div class="hero-meta">
          <span class="meta-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {dateDisplay}
          </span>
          {webinar.data.eventTimeDisplay && (
            <span class="meta-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              {webinar.data.eventTimeDisplay}
            </span>
          )}
          <span class="meta-pill meta-pill--price">${price} USD</span>
        </div>

        <div class="hero-actions">
          <a href="#register" class="btn-primary">{isRecording ? 'Get the Recording' : 'Reserve Your Spot'}</a>
          <a href="#about" class="btn-ghost">What we'll cover</a>
        </div>
      </div>

      {heroImageSrc && (
        <div class="hero-media">
          <img
            src={heroImageSrc}
            alt={webinar.data.title}
            class="hero-image"
            fetchpriority="high"
          />
        </div>
      )}
    </div>
  </section>

  <!-- ===== Body ===== -->
  <div class="container webinar-page">
    <div class="webinar-layout">

      <div class="webinar-main">
        <section class="about-section" id="about">
          <p class="section-eyebrow">About This Session</p>
          <div class="webinar-body">
            <Content />
          </div>
        </section>

        {webinar.data.topics.length > 0 && (
          <section class="topics-section">
            <p class="section-eyebrow">What We'll Cover</p>
            <div class="topics-grid">
              {webinar.data.topics.map((topic, i) => (
                <div class="topic-card">
                  <span class="topic-number">{String(i + 1).padStart(2, '0')}</span>
                  <span class="topic-name">{topic}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="gallery-section">
          <p class="section-eyebrow">Scenes From the Environment</p>
          <div class="gallery-grid">
            {galleryPhotos.map((photo) => (
              <img src={photo.src} alt={photo.alt} class="gallery-photo" loading="lazy" />
            ))}
          </div>
        </section>

        {team.length > 0 && (
          <section class="presenter-section">
            <p class="section-eyebrow">Our Team</p>
            <div class="team-list">
              {team.map((member) => (
                <div class="presenter-card">
                  {member.data.photo && (
                    <img
                      src={member.data.photo}
                      alt={member.data.name}
                      class="presenter-photo"
                      loading="lazy"
                    />
                  )}
                  <div class="presenter-info">
                    <h3 class="presenter-name">{member.data.name}</h3>
                    <p class="presenter-title">
                      {member.data.title}
                      {member.data.location && ` · ${member.data.location}`}
                    </p>
                    <p class="presenter-bio">{member.data.bio}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="webinar-aside" id="register">
        <div class="register-card">
          <p class="register-heading">{isRecording ? 'Watch the Recording' : 'Registration'}</p>

          <dl class="event-details">
            <div class="detail-row">
              <dt>{isRecording ? 'Recorded' : 'Date'}</dt>
              <dd>{dateDisplay}</dd>
            </div>
            {!isRecording && webinar.data.eventTimeDisplay && (
              <div class="detail-row">
                <dt>Time</dt>
                <dd>{webinar.data.eventTimeDisplay}</dd>
              </div>
            )}
            {webinar.data.duration && (
              <div class="detail-row">
                <dt>Length</dt>
                <dd>{webinar.data.duration}</dd>
              </div>
            )}
            <div class="detail-row">
              <dt>{isRecording ? 'Format' : 'Where'}</dt>
              <dd>{isRecording
                ? 'On-demand video — you’ll get the link to watch immediately after checkout'
                : 'Online — the meeting link is emailed to you after registration'}</dd>
            </div>
            <div class="detail-row">
              <dt>Price</dt>
              <dd class="detail-price">${price} USD</dd>
            </div>
          </dl>

          {purchaseOpen ? (
            <a href={buyLink} class="register-btn">
              {buyLabel}
            </a>
          ) : (
            <span class="register-btn register-btn--soon">{soonLabel}</span>
          )}

          <p class="register-note">
            Secure checkout powered by Stripe. Questions?
            <a href="/contact/">Get in touch</a>.
          </p>
        </div>
      </aside>

    </div>

    <!-- ===== Bottom CTA ===== -->
    <section class="cta-band">
      <div class="cta-band-inner">
        <div class="cta-copy">
          <h2 class="cta-title">{isRecording ? 'Watch the full session, anytime' : `Join us live on ${dateDisplay}`}</h2>
          <p class="cta-sub">{isRecording
            ? 'The complete recording — presentation plus the live Q&A.'
            : 'Bring your questions — we\'re saving time at the end for a thorough Q&A.'}</p>
        </div>
        <a href={purchaseOpen ? buyLink : '#register'} class="cta-btn">
          {purchaseOpen ? buyLabel : soonLabel}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .event-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f7f1ea 0%, var(--color-cream) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .hero-glow--lavender {
    width: 480px;
    height: 480px;
    top: -160px;
    right: -80px;
    background: radial-gradient(circle, rgba(228, 210, 248, 0.55), transparent 70%);
  }

  .hero-glow--terracotta {
    width: 420px;
    height: 420px;
    bottom: -180px;
    left: -120px;
    background: radial-gradient(circle, rgba(208, 144, 91, 0.18), transparent 70%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
    padding-block: var(--space-3xl);
  }

  .hero-copy {
    animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .event-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-purple);
    background: rgba(228, 210, 248, 0.5);
    border: 1px solid rgba(63, 38, 91, 0.12);
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: var(--space-lg);
  }

  .event-eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-terracotta);
    flex-shrink: 0;
  }

  .event-title {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-earth-dark);
    margin-bottom: var(--space-lg);
    max-width: 15em;
  }

  .title-accent {
    display: block;
    font-style: italic;
    font-weight: 300;
    font-size: 0.62em;
    color: var(--color-terracotta-dark);
    margin-top: 0.35em;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 1px 3px rgba(92, 74, 58, 0.06);
  }

  .meta-pill svg {
    color: var(--color-terracotta-dark);
    flex-shrink: 0;
  }

  .meta-pill--price {
    background: var(--color-purple);
    border-color: var(--color-purple);
    color: #ffffff;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .btn-primary {
    display: inline-block;
    padding: 0.95rem 2.4rem;
    background: linear-gradient(135deg, var(--color-purple) 0%, var(--color-purple-light) 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 10px 24px -8px rgba(63, 38, 91, 0.45);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .btn-primary:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px rgba(63, 38, 91, 0.55);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.95rem 1.6rem;
    color: var(--color-earth);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid rgba(92, 74, 58, 0.25);
    transition: border-color 0.25s, background-color 0.25s;
  }

  .btn-ghost:hover {
    color: var(--color-earth-dark);
    border-color: rgba(92, 74, 58, 0.5);
    background: rgba(255, 255, 255, 0.6);
  }

  .hero-media {
    position: relative;
    animation: fadeUp 0.9s 0.15s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-media::before {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    background: linear-gradient(135deg, rgba(208, 144, 91, 0.25), rgba(228, 210, 248, 0.45));
    border-radius: 32px;
    z-index: 0;
  }

  .hero-image {
    position: relative;
    z-index: 1;
    width: 100%;
    /* Reserve the space before the photo loads so the page doesn't jump */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: 0 30px 60px -20px rgba(63, 38, 91, 0.35);
  }

  /* ===== Layout ===== */
  .webinar-page {
    padding-block: var(--space-3xl);
  }

  .webinar-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-purple);
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: var(--color-purple);
    flex-shrink: 0;
  }

  .about-section,
  .topics-section,
  .gallery-section {
    margin-bottom: var(--space-2xl);
  }

  .webinar-body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: 62ch;
  }

  .webinar-body :global(p:first-child) {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-xl);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-earth-dark);
  }

  .webinar-body :global(p) {
    margin-bottom: var(--space-md);
  }

  .webinar-body :global(ul) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .webinar-body :global(li) {
    margin-bottom: var(--space-xs);
  }

  /* ===== Topics ===== */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .topic-card {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .topic-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .topic-number {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-terracotta);
    flex-shrink: 0;
  }

  .topic-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-earth-dark);
    line-height: var(--leading-normal);
  }

  /* ===== Gallery ===== */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .gallery-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 28px -12px rgba(92, 74, 58, 0.35);
    transition: transform 0.3s;
  }

  .gallery-photo:hover {
    transform: scale(1.02);
  }

  /* ===== Team ===== */
  .team-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .presenter-card {
    display: flex;
    gap: var(--space-xl);
    align-items: flex-start;
    background: linear-gradient(135deg, #ffffff 0%, #f8f2ec 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
  }

  .presenter-photo {
    width: 104px;
    height: 104px;
    object-fit: cover;
    border-radius: 50%;
    flex-shrink: 0;
    border: 4px solid #ffffff;
    box-shadow: 0 8px 24px -8px rgba(92, 74, 58, 0.4);
  }

  .presenter-name {
    font-size: var(--text-xl);
    font-weight: 400;
    margin-bottom: var(--space-xs);
  }

  .presenter-title {
    font-size: var(--text-sm);
    color: var(--color-terracotta-dark);
    margin-bottom: var(--space-md);
  }

  .presenter-bio {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
  }

  /* ===== Registration card ===== */
  .webinar-aside {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
  }

  .register-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: 0 20px 50px -25px rgba(63, 38, 91, 0.35);
  }

  .register-heading {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-purple);
    margin-bottom: var(--space-lg);
  }

  .event-details {
    margin: 0 0 var(--space-xl);
  }

  .detail-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .detail-row:last-child {
    border-bottom: none;
  }

  .detail-row dt {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-light);
    padding-top: 2px;
  }

  .detail-row dd {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .detail-price {
    font-family: var(--font-heading);
    font-size: var(--text-xl) !important;
    font-weight: 600;
    color: var(--color-earth-dark);
  }

  .register-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.95rem 1.5rem;
    background: linear-gradient(135deg, var(--color-purple) 0%, var(--color-purple-light) 100%);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 10px 24px -8px rgba(63, 38, 91, 0.45);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  a.register-btn:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px rgba(63, 38, 91, 0.55);
  }

  .register-btn--soon {
    background: var(--color-cream-dark);
    color: var(--color-text-light);
    box-shadow: none;
    cursor: default;
  }

  .register-note {
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    line-height: var(--leading-normal);
    text-align: center;
  }

  .register-note a {
    color: var(--color-terracotta-dark);
    text-decoration: underline;
  }

  /* ===== Bottom CTA band ===== */
  .cta-band {
    margin-top: var(--space-3xl);
  }

  .cta-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
    background: linear-gradient(135deg, var(--color-purple) 0%, #55357c 60%, var(--color-purple-light) 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
  }

  .cta-title {
    font-size: var(--text-2xl);
    font-weight: 400;
    color: #ffffff;
    margin-bottom: var(--space-xs);
  }

  .cta-sub {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
    font-style: italic;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.95rem 2.4rem;
    background: #ffffff;
