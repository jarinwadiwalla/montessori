---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
---

<PageLayout
  title="Contact"
  description="Get in touch with Montessori for Adolescents, we'd love to hear about your vision for building a Montessori adolescent program."
  heroTitle="Get in Touch"
  heroImage="/images/Get In Touch.jpg"
  heroSubtitle="Tell us about your vision, request specific resources, or ask us questions!"
>
  <div class="contact-wrapper">
    <img src="/images/8.png" alt="" class="contact-watermark" aria-hidden="true" />
    <div class="container contact-layout">

      <div class="contact-side">
        <p class="contact-eyebrow">Reach Out</p>
        <h2 class="contact-heading">We'd love to hear from you.</h2>
        <p class="contact-desc">
          Whether you're building a program, looking for resources, or simply curious — every great conversation starts with a message.
        </p>
        <div class="contact-details">
          <a href="mailto:montessoriforadolescents@gmail.com" class="contact-email">
            montessoriforadolescents@gmail.com
          </a>
        </div>
      </div>

      <div class="contact-form-wrap">
        <ContactForm />
      </div>

    </div>
  </div>
</PageLayout>

<style>
  .contact-wrapper {
    position: relative;
    padding-block: var(--space-4xl);
  }

  .contact-watermark {
    position: absolute;
    width: 700px;
    max-width: 90%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.04;
    pointer-events: none;
    z-index: 0;
  }

  .contact-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-4xl);
    align-items: start;
    max-width: 960px;
    margin-inline: auto;
  }

  /* Left side */
  .contact-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.85);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contact-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .contact-heading {
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    color: var(--color-earth-dark);
    line-height: 1.3;
    margin-bottom: var(--space-lg);
  }

  .contact-desc {
    font-size: var(--text-base);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
  }

  .contact-email {
    font-size: var(--text-base);
    color: var(--color-earth);
    text-decoration: none;
    border-bottom: 1px solid rgba(208, 144, 91, 0.4);
    padding-bottom: 2px;
    transition: border-color 0.2s, color 0.2s;
  }

  .contact-email:hover {
    color: #d0905b;
    border-color: #d0905b;
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
