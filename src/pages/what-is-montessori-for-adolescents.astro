---
import PageLayout from '../layouts/PageLayout.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';
import PhotoCarousel from '../components/shared/PhotoCarousel.astro';
---

<PageLayout
  title="What is Montessori for Adolescents?"
  description="Montessori for adolescents is education built for the third plane of development, roughly ages twelve to eighteen: meaningful work, real responsibility, and an environment prepared around the adolescent."
  heroTitle="What is Montessori for Adolescents?"
  heroImage="/images/whole-human-hero.jpg"
>
  <div class="container container--narrow">

  </div>

  <div class="container container--narrow">
    <blockquote class="opening-quote">
      <p>A school of experience in the elements of social life.</p>
      <cite>Maria Montessori, <em>From Childhood to Adolescence</em></cite>
    </blockquote>
  </div>

  <div class="container">
    <div class="stage-grid">
      <div class="stage">
        <p class="stage-name">Farm-Based Community Living</p>
      </div>
      <div class="stage">
        <p class="stage-name">A Center for Study and Work</p>
      </div>
      <div class="stage">
        <p class="stage-name">Project Based Academic Integration</p>
      </div>
    </div>
  </div>

  <div class="carousel-section">
    <PhotoCarousel photos={[
      { src: '/images/whole-human-photo-1.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-2.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-3.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-4.jpg', alt: 'Adolescents at work in a Montessori environment' },
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <h2>What adolescents need</h2>
      <div class="dimensions">
        <div class="dimension">
          <h3>Intellectual</h3>
          <p>Critical thinking, curiosity, and the capacity for abstract reasoning that emerges in the third plane.</p>
        </div>
        <div class="dimension">
          <h3>Emotional</h3>
          <p>Self-awareness, resilience, and the ability to navigate the intense emotional landscape of adolescence.</p>
        </div>
        <div class="dimension">
          <h3>Social</h3>
          <p>Belonging, collaboration, and understanding one's role within the community and the wider world.</p>
        </div>
        <div class="dimension">
          <h3>Physical</h3>
          <p>Connection to the body, meaningful physical work, and practices that honor the adolescent's changing form.</p>
        </div>
        <div class="dimension">
          <h3>Moral</h3>
          <p>A developing sense of justice, responsibility, and the courage to act on one's values.</p>
        </div>
      </div>
    </section>

  </div>

  <QuoteBanner
    text="The greatest sign of success for a teacher is to be able to say, 'The children are now working as if I did not exist.'"
    author="Maria Montessori"
  />
</PageLayout>

<style>
  /* The opening quote carries the page, so it is set at display size and
     given the width to breathe. */
  .opening-quote {
    margin: 0 0 var(--space-3xl);
    padding: 0;
    text-align: center;
  }

  .opening-quote p {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    color: var(--color-earth-dark);
    margin: 0;
  }

  .opening-quote cite {
    display: block;
    margin-top: var(--space-lg);
    font-style: normal;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .opening-quote cite em {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
  }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    max-width: 900px;
    margin: 0 auto var(--space-3xl);
  }

  @media (max-width: 780px) {
    .stage-grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* An arch rather than a rectangle: these are read, not clicked, and the
     shape says so before the cursor has to. */
  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 220px;
    background: var(--color-white);
    /* A gentler arch than a full semicircle, which left a large empty dome
       above the text once the ages came out. */
    border-radius: 150px 150px var(--radius-lg) var(--radius-lg);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    box-shadow: var(--shadow-md);
  }


  .stage-name::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    margin: 0 auto var(--space-lg);
    background: var(--color-terracotta);
  }

  .stage-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-earth-dark);
    margin: 0;
  }
  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
    color: var(--color-earth);
  }

  .page-section p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .dimensions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .dimension {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    flex: 0 1 calc(33.333% - var(--space-lg));
    min-width: 220px;
    box-sizing: border-box;
  }

  @media (max-width: 600px) {
    .dimension {
      flex: 0 1 100%;
    }
  }

  .dimension h3 {
    font-size: var(--text-xl);
    color: var(--color-terracotta);
    margin-bottom: var(--space-sm);
  }

  .dimension p {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .carousel-section {
    margin-block: var(--space-3xl);
  }
</style>
