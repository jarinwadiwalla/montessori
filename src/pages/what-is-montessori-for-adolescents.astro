---
import PageLayout from '../layouts/PageLayout.astro';
import ArchPanels from '../components/shared/ArchPanels.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';
import PhotoCarousel from '../components/shared/PhotoCarousel.astro';
import NextSteps from '../components/shared/NextSteps.astro';
---

<PageLayout
  title="What is Montessori for Adolescents?"
  description="Education built for the third plane of development, ages twelve to eighteen: meaningful work, real responsibility, and an environment prepared around them."
  heroTitle="What is Montessori for Adolescents?"
  heroImage="/images/whatis-woodworking.jpg"
  heroImagePosition="center 30%"
>
  <div class="container container--narrow">

  </div>

  <div class="container container--narrow">
    <blockquote class="opening-quote">
      <p>A school of experience in the elements of social life.</p>
      <cite>Maria Montessori, <em>From Childhood to Adolescence</em></cite>
    </blockquote>
  </div>

  <div class="container">
    <ArchPanels items={[
      'Farm-Based Community Living',
      'A Center for Study and Work',
      'Project Based Academic Integration',
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section unique">
      <h2 class="unique-heading">What makes Montessori education unique?</h2>

      <details class="unique-item">
        <summary class="unique-summary">
          <span>Read the full answer</span>
          <svg class="unique-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="unique-answer">
          <p>
            From the earliest years, Montessori students learn in environments designed to feel
            comfortable and home-like. Each community brings together children across a three-year
            age span (ages 3&ndash;6, 6&ndash;9, 9&ndash;12, and so on), so younger students learn
            from older ones and older students grow through mentoring.
          </p>
          <p>
            Within these communities, children practice living together and caring for one another.
            They also begin to direct their own curiosity and manage their own time, choosing work
            they&rsquo;ve been introduced to through lessons and are developmentally ready to take on.
          </p>
          <p>
            This care for one another, for the environment, and for the natural world, along with
            the habit of independent study, carries into the adolescent years on a larger scale.
            Adolescents work alongside the wider community, and they gain more independence from
            their families, often through overnight or residential experiences.
          </p>
          <p>
            The result is young people who believe in their own abilities, because they&rsquo;ve
            spent years doing real work in a real community that depends on them. Their learning has
            been hands-on and autonomy-supportive, and they grow into independent thinkers who are
            aware of and engaged with the world around them.
          </p>
        </div>
      </details>
    </section>
  </div>

  <div class="carousel-section">
    <PhotoCarousel photos={[
      { src: '/images/whole-human-photo-1.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-2.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-3.jpg', alt: 'Adolescents at work in a Montessori environment' },
      { src: '/images/whole-human-photo-4.jpg', alt: 'Adolescents at work in a Montessori environment' },
    ]} />
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <h2 class="needs-heading">Adolescents thrive with this support:</h2>
      <div class="dimensions">
        <div class="dimension">
          <h3>Intellectual</h3>
          <p>Critical thinking, curiosity, and the capacity for abstract reasoning that emerges in the third plane.</p>
        </div>
        <div class="dimension">
          <h3>Emotional</h3>
          <p>Self-awareness, resilience, and the ability to navigate the intense emotional landscape of adolescence.</p>
        </div>
        <div class="dimension">
          <h3>Social</h3>
          <p>Belonging, collaboration, and understanding one's role within the community and the wider world.</p>
        </div>
        <div class="dimension">
          <h3>Physical</h3>
          <p>Connection to the body, meaningful physical work, and practices that honor the adolescent's changing form.</p>
        </div>
        <div class="dimension">
          <h3>Moral</h3>
          <p>A developing sense of justice, responsibility, and the courage to act on one's values.</p>
        </div>
      </div>
    </section>

  </div>

  <QuoteBanner
    text="The greatest sign of success for a teacher is to be able to say, 'The children are now working as if I did not exist.'"
    author="Maria Montessori"
  />

  <NextSteps
    tone="terracotta"
    title="Where to next"
    items={[
      { label: 'Guidance and Support', href: '/guidance/', blurb: 'How we help you build it.' },
      { label: 'School Consulting', href: '/partnership/', blurb: 'Month-to-month guidance for your programme.' },
      { label: 'Resources', href: '/resources/', blurb: 'Webinars and downloadable guides.' },
    ]}
  />

</PageLayout>

<style>
  /* Same disclosure pattern as the homepage FAQ: a native <details> with a
     chevron that turns. One pattern for this on the site, not two. */
  .unique { margin-top: var(--space-2xl); }

  .unique-heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth);
    text-align: center;
    margin-bottom: var(--space-sm);
  }

  .unique-item {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .unique-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-earth-dark);
    transition: color 0.2s;
  }

  .unique-summary::-webkit-details-marker { display: none; }
  .unique-summary::marker { content: ''; }
  .unique-summary:hover { color: #96552B; }

  .unique-icon {
    flex-shrink: 0;
    color: #96552B;
    transition: transform 0.25s;
  }

  .unique-item[open] .unique-icon { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .unique-icon { transition: none; }
  }

  .unique-answer { padding-bottom: var(--space-lg); }

  .unique-answer p {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .unique-answer p:last-child { margin-bottom: 0; }

  /* The opening quote carries the page, so it is set at display size and
     given the width to breathe. */
  .opening-quote {
    margin: 0 0 var(--space-3xl);
    padding: 0;
    text-align: center;
  }

  .opening-quote p {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    color: var(--color-earth-dark);
    margin: 0;
  }

  .opening-quote cite {
    display: block;
    margin-top: var(--space-lg);
    font-style: normal;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-earth);
  }

  .opening-quote cite em {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
  }



  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
    color: var(--color-earth);
  }

  /* Centred over the five boxes, which are themselves centre-justified. */
  .page-section h2.needs-heading {
    text-align: center;
  }

  .page-section p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .dimensions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .dimension {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    flex: 0 1 calc(33.333% - var(--space-lg));
    min-width: 220px;
    box-sizing: border-box;
  }

  @media (max-width: 600px) {
    .dimension {
      flex: 0 1 100%;
    }
  }

  .dimension h3 {
    font-size: var(--text-xl);
    color: var(--color-terracotta);
    margin-bottom: var(--space-sm);
  }

  .dimension p {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .carousel-section {
    margin-block: var(--space-3xl);
  }
</style>
