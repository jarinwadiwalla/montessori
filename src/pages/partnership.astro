---
import PageLayout from '../layouts/PageLayout.astro';
import InterestForm from '../components/shared/InterestForm.astro';

// One offer, month to month.
const plan = {
  name: 'Monthly Partnership',
  included: [
    'Two 60-minute guidance calls, or four 30-minute calls',
    'Written call notes and action items after each session',
    'Custom monthly checklist and planning document',
    'Email support between calls',
    'Membership to the Montessori Adolescent Collective, including access to the online resource library',
    'Cancel any time, for any reason',
  ],
};


const addOnGroups = [
  {
    title: 'Planning and Preparation',
    items: [
      'Custom monthly checklist and planning document',
      'The prepared environment for adolescents: essential pillars, with charts, readings and case studies',
      'Montessori philosophy for the adolescent: guided readings and a reflection packet',
      'Montessori adult preparation documents, for guides and visiting specialists',
    ],
  },
  {
    title: 'Environment Structure',
    items: [
      'How to plan and execute a study and work term',
      'Custom student curriculum map and free curriculum resources list',
      'Complete mathematics curriculum: student maps and self-paced learning',
      'Detailed schedule flows: the first three weeks, the daily flow and the weekly flow, created together',
      'Daily life example guides: meal rituals, responsibilities, meeting agenda and managers',
    ],
  },
  {
    title: 'Administrative',
    items: [
      'Marketing checklist',
      'Student enrollment checklist',
      'Visiting specialists checklist: recruitment of experts',
    ],
  },
];
---

<PageLayout
  title="Partnership"
  description="Monthly Montessori adolescent consulting: guidance calls, planning documents and membership of the Montessori Adolescent Collective. Cancel any time."
>
  <div class="container">
    <header class="page-head">
      <h1>Partnership</h1>
    </header>

    <section class="page-section intro-tight">
      <p class="lede">
        <em>Erdkinder</em> was Maria Montessori's vision for adolescent
        education: real work, real community, a real connection to the land.
        Every consultant holds the AMI 12&ndash;18 Adolescent Diploma and has
        built programs from the ground up.
      </p>
    </section>

    <div class="offer-columns">
    <section class="page-section">
      <article class="offer-card">
        <h2 class="offer-title">{plan.name}</h2>
        <p class="plan-intro">
          Custom side-by-side partnership to help you navigate starting, or
          optimizing your adolescent program, based on your needs right now.
        </p>
        <p class="plan-intro">
          Strategy where you need it most; chosen areas of focus for each week.
        </p>
        <p class="plan-included-label">Every month includes</p>
        <ul class="plan-list">
          {plan.included.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>
    <section class="page-section">
      <h2>Areas of Focus</h2>
      <div class="addon-grid">
        {addOnGroups.map((group) => (
          <div class="addon-group">
            <h3>{group.title}</h3>
            <ul class="page-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
    </div>
  </div>

  <div class="container container--narrow">

  </div>

  <div class="container container--narrow">
  </div>

  <section class="ready-banner">
    <div class="container ready-inner">
      <p class="ready-eyebrow">Ready to begin?</p>
      <h2 class="ready-title">Every Erdkinder starts with a seed.</h2>
      <p class="ready-sub">
        Tell us where you are and what your vision is. We can't wait to bring
        it to life, together!
      </p>
      <InterestForm about="Partnership" variant="dark" />
    </div>
  </section>

</PageLayout>

<style>
  /* --- the offer --- */

  .offer-card {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }


  /* The same short rule the other section headings use. */
  .offer-title::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto 0;
    background: var(--color-terracotta);
  }

  .offer-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-sm);
  }



  .plan-intro {
    max-width: 44rem;
    margin: 0 auto var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-earth);
  }

  .plan-intro + .plan-included-label {
    margin-top: var(--space-lg);
  }

  .plan-included-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .plan-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 30rem;
    text-align: left;
    columns: 1;
  }

  .plan-list li {
    position: relative;
    break-inside: avoid;
    padding-left: 1.2rem;
    margin-bottom: 0.4rem;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }


  .plan-list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.42em;
    width: 0.32rem;
    height: 0.62rem;
    border: solid var(--color-terracotta);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }






  .page-head {
    padding-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    text-align: center;
  }

  .page-head h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin: 0;
  }

  .page-section {
    margin-bottom: var(--space-lg);
  }

  /* Side by side, so the whole offer is visible at once rather than
     stacked into two screens. */
  .offer-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 1040px) {
    .offer-columns { grid-template-columns: minmax(0, 1fr); }
  }

  .intro-tight {
    margin-bottom: var(--space-lg);
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-lg);
  }

  .page-section p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .lede {
    font-size: var(--text-xl);
  }






  /* Sits on its own line with rules above and below, so a price can be
     dropped in later without the layout shifting around it. */








  /* --- add-ons --- */



  .addon-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .addon-group {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .addon-group h3 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.3rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .page-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- closing banner --- */

  .ready-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .ready-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-terracotta-light);
    margin-bottom: var(--space-md);
  }

  .ready-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 300;
    color: var(--color-cream);
    margin-bottom: var(--space-md);
  }

  .ready-sub {
    color: rgba(238, 228, 219, 0.85);
    margin-bottom: var(--space-lg);
  }

</style>
