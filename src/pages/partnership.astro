---
import PageLayout from '../layouts/PageLayout.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';

// One offer, month to month, with a reduced rate for committing further
// ahead. Fill in `price` and the two `save` values when they are settled;
// each falls back to neutral wording until then.
const plan = {
  name: 'Month to month',
  tagline: 'Cancel any time. No contract, no pressure.',
  price: '',
  included: [
    'Four 60-minute guidance calls, one per week',
    'Written call notes and action items after each session',
    'Custom monthly checklist and planning document',
    'Email support between calls',
    'Access to the Montessori for Adolescents online resource library',
    'Cancel any time, for any reason',
  ],
};

const commitments = [
  {
    term: 'Three months',
    save: '',
    blurb: 'The same support, at a lower monthly rate.',
    extras: [
      'One complimentary à la carte add-on',
    ],
  },
  {
    term: 'Six months',
    save: '',
    blurb: 'The lowest monthly rate, for a programme being built from the ground up.',
    extras: [
      'Two complimentary à la carte add-ons',
      'On-site visit available at a reduced rate',
      'A locked-in rate if you continue beyond six months',
    ],
  },
];

const addOnGroups = [
  {
    title: 'Planning and preparation',
    items: [
      'Custom monthly checklist and planning document',
      'The prepared environment for adolescents: essential pillars, with charts, readings and case studies',
      'Montessori philosophy for the adolescent: guided readings and a reflection packet',
      'Montessori adult preparation documents, for guides and visiting specialists',
    ],
  },
  {
    title: 'Environment structure',
    items: [
      'How to plan and execute a study and work term',
      'Custom student curriculum map and free curriculum resources list',
      'Complete mathematics curriculum: student maps and self-paced learning',
      'Detailed schedule flows: the first three weeks, the daily flow and the weekly flow, created together',
      'Daily life example guides: meal rituals, responsibilities, meeting agenda and managers',
    ],
  },
  {
    title: 'Administrative',
    items: [
      'Marketing checklist',
      'Student enrollment checklist',
      'Visiting specialists checklist: recruitment of experts',
      'Website design and development, coordinated by MFA through our design partner BijanTech',
    ],
  },
  {
    title: 'On-site visits',
    items: ['On-site observation, feedback and side-by-side facilitation.'],
  },
];
---

<PageLayout
  title="Partnership"
  description="Three tiers of Montessori adolescent consulting, from a single guidance call to a full three-month engagement building your program side by side."
  heroTitle="Partnership"
  heroImage="/images/guidance-photo-6.jpg"
  heroImagePosition="center 40%"
>
  <div class="container container--narrow">
    <section class="page-section">
      <p class="lede">
        <em>Erdkinder</em>, German for children of the earth, was Maria
        Montessori's vision for adolescent education. She believed young people
        needed more than a classroom: real work, real community, and a real
        connection to the land.
      </p>
      <p>
        Our consulting supports communities ready to bring that vision to life.
        Every consultant holds the AMI 12&ndash;18 Adolescent Diploma and has
        built programs from the ground up.
      </p>
    </section>
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <article class="plan">
        <h2 class="plan-name">{plan.name}</h2>
        <p class="plan-tagline">{plan.tagline}</p>
        <p class="plan-price">{plan.price || 'Pricing on request'}</p>
        <p class="plan-included-label">Every month includes</p>
        <ul class="plan-list">
          {plan.included.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section class="page-section">
      <h2 class="commit-heading">Commit further ahead, pay less</h2>
      <p class="commit-intro">
        The support is the same either way. Committing further ahead simply costs
        less per month, and carries a little extra.
      </p>
      <div class="commit-grid">
        {commitments.map((c) => (
          <div class="commit">
            <p class="commit-term">{c.term}</p>
            <p class="commit-save">{c.save || 'Reduced rate'}</p>
            <p class="commit-blurb">{c.blurb}</p>
            <ul class="commit-list">
              {c.extras.map((e) => <li>{e}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <h2>À la carte add-ons</h2>
      <p class="addon-note">
        A complimentary 30-minute call is offered with add-ons that need
        tailored information.
      </p>
      <div class="addon-grid">
        {addOnGroups.map((group) => (
          <div class="addon-group">
            <h3>{group.title}</h3>
            <ul class="page-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="ready-banner">
    <div class="container ready-inner">
      <p class="ready-eyebrow">Ready to begin?</p>
      <h2 class="ready-title">Every Erdkinder starts with a seed.</h2>
      <p class="ready-sub">
        Tell us where you are and we will tell you which tier fits.
      </p>
      <a href="/contact/" class="ready-cta">Get in touch</a>
    </div>
  </section>

  <QuoteBanner
    text="The greatest sign of success for a teacher is to be able to say, 'The children are now working as if I did not exist.'"
    author="Maria Montessori"
  />
</PageLayout>

<style>
  /* --- the offer --- */

  .plan {
    background: var(--color-white);
    border-top: 3px solid var(--color-terracotta);
    border-radius: 3px 3px var(--radius-xl) var(--radius-xl);
    padding: var(--space-2xl) var(--space-xl);
    box-shadow: var(--shadow-md);
    text-align: center;
  }

  .plan-name {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-xs);
  }

  .plan-tagline {
    font-size: var(--text-lg);
    color: var(--color-earth);
    margin: 0 0 var(--space-lg);
  }

  .plan-price {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    padding: var(--space-md) 0;
    margin: 0 0 var(--space-lg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .plan-included-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .plan-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 34rem;
    text-align: left;
  }

  .plan-list li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .plan-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- commitment rates --- */

  .commit-heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-xs);
  }

  .commit-intro {
    color: var(--color-earth);
    margin-bottom: var(--space-xl);
  }

  .commit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 720px) {
    .commit-grid { grid-template-columns: minmax(0, 1fr); }
  }

  .commit {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .commit-term {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    margin: 0 0 0.2rem;
  }

  .commit-save {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta-dark);
    margin: 0 0 var(--space-md);
  }

  .commit-blurb {
    font-size: var(--text-base);
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .commit-list li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .commit-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-lg);
  }

  .page-section p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .lede {
    font-size: var(--text-xl);
  }

  /* --- tiers --- */



  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: minmax(0, 1fr); }
  }





  /* Sits on its own line with rules above and below, so a price can be
     dropped in later without the layout shifting around it. */








  /* --- add-ons --- */

  .addon-note {
    font-size: var(--text-base);
    color: var(--color-earth);
    margin-bottom: var(--space-xl);
  }

  .addon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  .addon-group h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .page-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- closing banner --- */

  .ready-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-4xl);
    text-align: center;
  }

  .ready-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-terracotta-light);
    margin-bottom: var(--space-md);
  }

  .ready-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 300;
    color: var(--color-cream);
    margin-bottom: var(--space-md);
  }

  .ready-sub {
    color: rgba(238, 228, 219, 0.85);
    margin-bottom: var(--space-xl);
  }

  .ready-cta {
    display: inline-block;
    background: var(--color-cream);
    color: var(--color-earth-dark);
    padding: 0.9rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--text-base);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ready-cta:hover {
    background: var(--color-white);
  }
</style>
