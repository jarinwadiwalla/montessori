---
import PageLayout from '../layouts/PageLayout.astro';
import InterestForm from '../components/shared/InterestForm.astro';

// One offer, month to month.
const plan = {
  name: 'Monthly Partnership',
  included: [
    'Custom side-by-side partnership to help you navigate starting or optimizing your adolescent program, based on your needs right now',
    'Strategy where you need it most; chosen areas of focus for each week',
    '(4) 60-minute guidance calls',
    'Written call notes and action items after each session',
    'Custom monthly checklist and planning document',
    'Email support between calls',
    'Membership to the Montessori Adolescent Collective, including access to the online resource library',
    'Cancel any time, for any reason',
  ],
};


const addOnGroups = [
  {
    title: 'Planning and Preparation',
    items: [
      'Grounding the team in Montessori adolescent philosophy',
      'Designing the prepared environment',
      'Preparing the adults who will hold the environment',
      'Building and supporting your team',
    ],
  },
  {
    title: 'Environment Structure',
    items: [
      'Planning and running a study and work term',
      'Shaping the daily and weekly flow',
      'Curriculum planning and resources',
      'Establishing daily life: meal rituals, responsibilities and community management',
    ],
  },
  {
    title: 'Administrative',
    items: [
      'Marketing your program',
      'Enrolling your first students',
      'Recruiting visiting specialists',
      'Bringing parents with you',
      'Running events and raising funds',
      'Navigating accreditation and GED options',
    ],
  },
];
---

<PageLayout
  title="Partnership"
  heroTitle="Partnership"
  heroImage="/images/sunset-hero.jpg"
  heroImagePosition="center 42%"
  description="Monthly Montessori adolescent consulting: guidance calls, planning documents and membership of the Montessori Adolescent Collective. Cancel any time."
>
  <div class="container">
    <section class="page-section intro-tight">
      <p class="lede">
        <em>Erdkinder</em> (children of the earth) was Maria Montessori's
        vision for adolescent education: real work, real community, a real
        connection to the land. Every consultant holds the AMI 12&ndash;18
        Adolescent Diploma and has built programs from the ground up. We can't
        wait to hear about your vision and help you expand your community!
      </p>
    </section>

    <div class="offer-columns">
    <section class="page-section">
      <article class="offer-card">
        <h2 class="offer-title">{plan.name}</h2>
        <p class="plan-included-label">Every month includes</p>
        <ul class="plan-list">
          {plan.included.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>
    <section class="page-section">
      <h2>Areas of Focus</h2>
      <div class="addon-grid">
        {addOnGroups.map((group) => (
          <div class="addon-group">
            <h3>{group.title}</h3>
            <ul class="page-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
    </div>
  </div>

  <div class="container container--narrow">

  </div>

  <div class="container container--narrow">
  </div>

  <section class="ready-banner">
    <div class="container ready-inner">
      <p class="ready-eyebrow">Ready to begin?</p>
      <h2 class="ready-title">
        Tell us where you are and what your vision is. We can't wait to bring
        it to life, together!
      </h2>
      <InterestForm about="Partnership" variant="dark" />
    </div>
  </section>

</PageLayout>

<style>
  /* --- the offer --- */

  .offer-card {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }


  /* The same short rule the other section headings use. */
  .offer-title::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto 0;
    background: var(--color-terracotta);
  }

  .offer-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-sm);
  }





  .plan-included-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .plan-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 30rem;
    text-align: left;
    columns: 1;
  }

  .plan-list li {
    position: relative;
    break-inside: avoid;
    padding-left: 1.2rem;
    margin-bottom: 0.4rem;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }


  .plan-list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.42em;
    width: 0.32rem;
    height: 0.62rem;
    border: solid var(--color-terracotta);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }







  .page-section {
    margin-bottom: var(--space-lg);
  }

  /* Side by side, so the whole offer is visible at once rather than
     stacked into two screens. */
  .offer-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 1040px) {
    .offer-columns { grid-template-columns: minmax(0, 1fr); }
  }

  .intro-tight {
    margin-bottom: var(--space-lg);
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .page-section p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .lede {
    font-size: var(--text-xl);
  }






  /* Sits on its own line with rules above and below, so a price can be
     dropped in later without the layout shifting around it. */








  /* --- add-ons --- */



  .addon-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .addon-group {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .addon-group h3 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.3rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .page-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- closing banner --- */

  .ready-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .ready-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-terracotta-light);
    margin-bottom: var(--space-md);
  }

  .ready-title {
    max-width: 30ch;
    margin: 0 auto var(--space-lg);
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--color-cream);
  }


</style>
