---
import PageLayout from '../layouts/PageLayout.astro';
import CallScheduler from '../components/shared/CallScheduler.astro';
import ArchPanels from '../components/shared/ArchPanels.astro';

// One offer, month to month.
const siteUrl = 'https://montessoriforadolescents.com';

/* Service schema so "Montessori adolescent consultant" searches can surface
   this page as an offering rather than a generic page. No price: the rate is
   quoted by hand and the repo is public. */
const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Monthly Montessori Adolescent Partnership',
  serviceType: 'Montessori adolescent program consulting',
  description:
    'Month-to-month guidance for schools and guides starting or strengthening a Montessori adolescent programme, delivered by consultants holding the AMI 12\u201318 Adolescent Diploma.',
  url: `${siteUrl}/partnership/`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: 'Worldwide',
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${siteUrl}/partnership/`,
  },
});

const plan = {
  name: 'Monthly Partnership',
  included: [
    'Custom side-by-side partnership to help you navigate starting or optimizing your adolescent program, based on your needs right now',
    'Strategy where you need it most; chosen areas of focus for each week',
    '(4) 60-minute guidance calls',
    'Written call notes and action items after each session',
    'Custom monthly checklist and planning document',
    'Email support between calls',
    'Membership to the <a href="/collective/">Montessori Adolescent Collective</a>, including access to the online resource library',
    'Cancel any time, for any reason',
  ],
};


const addOnGroups = [
  {
    title: 'Environment Preparation',
    items: [
      'Grounding the team in Montessori adolescent philosophy',
      'Designing the prepared environment',
      'Adult preparation',
      'Building and supporting your team',
    ],
  },
  {
    title: 'Planning and Logistics',
    items: [
      'Components of the study and work term',
      'Shaping the daily and weekly flow',
      'Curriculum planning and resources',
      'Establishing daily life: meal rituals, responsibilities and community management',
    ],
  },
  {
    title: 'Administrative',
    items: [
      'Marketing your program',
      'Parent involvement and education',
      'Events and fundraising',
      'Navigating accreditation and GED options',
    ],
  },
];
---

<PageLayout
  title="Partnership"
  heroTitle="Partnership"
  heroImage="/images/sunset-hero.jpg"
  heroImagePosition="center 42%"
  description="Monthly Montessori adolescent consulting: guidance calls, planning documents and membership of the Montessori Adolescent Collective. Cancel any time."
>
  <script type="application/ld+json" set:html={serviceJsonLd} />

  <section class="intro-banner">
    <div class="container">
      <p class="intro-statement">
        No matter where you are at in the process of starting a Center for
        Study and Work for Adolescents, we will help you along the way.
      </p>

      <ArchPanels
        items={[
          'Help finding the right people to support your community.',
          'Confidence in your academic offerings and higher education pathway.',
          'Deep understanding of daily rhythms and community management.',
        ]}
      />
    </div>
  </section>

  <div class="container">

    <div class="offer-columns">
    <section class="page-section">
      <article class="offer-card">
        <h2 class="offer-title">{plan.name}</h2>
        <p class="offer-terms">
          Month&#8209;to&#8209;Month until you are ready to open your Center for
          Study and Work.
        </p>
        <p class="plan-included-label">Every month includes</p>
        <ul class="plan-list">
          {/* set:html so one item can carry a link; the strings are authored
              here, never user input. */}
          {plan.included.map((item) => <li set:html={item} />)}
        </ul>
        <p class="plan-note">We'll talk through pricing on our call.</p>
      </article>
    </section>
    <section class="page-section">
      <h2>Areas of Focus</h2>
      <div class="addon-grid">
        {addOnGroups.map((group) => (
          <div class="addon-group">
            <h3>{group.title}</h3>
            <ul class="page-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
    </div>
  </div>

  <div class="container container--narrow">

  </div>

  <div class="container container--narrow">
  </div>

  <section class="page-section meet">
    <div class="container meet-inner">
      <img
        class="meet-photo"
        src="/images/jarin-headshot.jpg"
        alt="Jarin Wadiwalla"
        width="800" height="800"
        loading="lazy" decoding="async"
      />
      <div class="meet-text">
        <p class="meet-eyebrow">Who you'll be speaking with</p>
        <h2 class="meet-name">Jarin Wadiwalla</h2>
        <p class="meet-role">Director of Montessori for Adolescents</p>
        <p class="meet-bio">
          Jarin has spent the last eight years working in Montessori education,
          drawn to it by a deep recognition that Montessori is a holistic
          practice, one that sees the whole person and honors their natural
          development.
        </p>
        <p class="meet-bio">
          Our team all carry the AMI 12&ndash;18 Adolescent Diploma and have
          worked in adolescent communities around the globe.
        </p>
        <a class="meet-link" href="/our-team/">Meet the whole team &rarr;</a>
      </div>
    </div>
  </section>

  <section class="ready-banner call-section">
    <div class="container">
      <h2 class="call-heading">Book a call</h2>
      <p class="call-lede">
        A free face-to-face conversation to meet one another, and for me to
        hear about your unique situation. Let's see how we can work together!
      </p>
      <CallScheduler about="Partnership" variant="dark" />
    </div>
  </section>

</PageLayout>

<style>
  /* --- who you'll be speaking with --- */

  .meet-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
    max-width: 760px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .meet-inner { flex-direction: column; align-items: center; text-align: center; }
  }

  .meet-photo {
    flex: none;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-terracotta);
  }

  /* Without this the text column refuses to shrink past its content and
     pushes the page into a horizontal scroll on a phone. */
  .meet-text { flex: 1 1 0; min-width: 0; }

  .meet-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin: 0 0 var(--space-xs);
  }

  .meet-name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    margin: 0;
  }

  .meet-role {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin: 0 0 var(--space-md);
  }

  .meet-bio {
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-md);
  }

  .meet-link {
    color: #96552B;
    text-decoration: none;
    font-weight: 600;
  }
  .meet-link:hover { text-decoration: underline; }

  /* --- opening statement --- */

  /* The arch grid ships a 3xl bottom margin for standalone use mid-page.
     Inside the band the section padding already provides that, so cancel it
     or the chocolate runs on well past the arches. */
  .intro-banner :global(.stage-grid) {
    margin-bottom: 0;
  }

  .intro-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-2xl);
    text-align: center;
    /* The hero sits directly above, so pull the page's own top padding back
       and let the two meet cleanly instead of showing a cream seam. */
    margin-top: calc(var(--space-3xl) * -1);
    margin-bottom: var(--space-3xl);
  }

  .intro-statement {
    max-width: 34ch;
    margin: 0 auto var(--space-2xl);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-cream);
  }

  /* --- book a call --- */

  .call-section { margin-top: var(--space-3xl); }

  .call-heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-cream);
    text-align: center;
    margin-bottom: var(--space-sm);
  }

  .call-heading::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto var(--space-lg);
    background: var(--color-terracotta);
  }

  .call-lede {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto var(--space-xl);
    color: var(--color-cream);
    line-height: var(--leading-relaxed);
  }

  /* --- the offer --- */

  .offer-card {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }


  /* The same short rule the other section headings use. */
  .offer-title::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto 0;
    background: var(--color-terracotta);
  }

  .offer-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-sm);
  }





  /* Larger than the list beneath it: the commitment is the thing people
     want to know before they read what is included. */
  /* Qualified with .offer-card on purpose: the `.page-section p` rule above
     is more specific than a bare `.offer-terms`, and silently won the colour. */
  .offer-card .offer-terms {
    max-width: 30ch;
    margin: 0 auto var(--space-lg);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.35;
    /* Not --color-terracotta-dark: it is 3.74:1 on white, short of 4.5 at
       this size. This shade of the same hue is 5.78:1. */
    color: #96552B;
  }

  .offer-card .plan-note {
    margin: var(--space-lg) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .plan-list a {
    color: #96552B;
    text-decoration: underline;
  }

  .plan-included-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .plan-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 30rem;
    text-align: left;
    columns: 1;
  }

  .plan-list li {
    position: relative;
    break-inside: avoid;
    padding-left: 1.2rem;
    margin-bottom: 0.4rem;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }


  .plan-list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.42em;
    width: 0.32rem;
    height: 0.62rem;
    border: solid var(--color-terracotta);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }







  .page-section {
    margin-bottom: var(--space-lg);
  }

  /* Side by side, so the whole offer is visible at once rather than
     stacked into two screens. */
  .offer-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 1040px) {
    .offer-columns { grid-template-columns: minmax(0, 1fr); }
  }


  .page-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .page-section p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }







  /* Sits on its own line with rules above and below, so a price can be
     dropped in later without the layout shifting around it. */








  /* --- add-ons --- */



  .addon-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .addon-group {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .addon-group h3 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.3rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .page-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- closing banner --- */

  .ready-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-2xl);
    text-align: center;
  }


</style>
