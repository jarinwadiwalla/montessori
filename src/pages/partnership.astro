---
import PageLayout from '../layouts/PageLayout.astro';
import QuoteBanner from '../components/shared/QuoteBanner.astro';

// One offer, month to month, with a reduced rate for committing further
// ahead. Fill in the two `save` values when they are settled; each falls
// back to neutral wording until then.
const plan = {
  name: 'Monthly Partnership',
  included: [
    'Two 60-minute guidance calls, or four 30-minute calls',
    'Written call notes and action items after each session',
    'Custom monthly checklist and planning document',
    'Email support between calls',
    'Membership to the Montessori Adolescent Collective, including access to the online resource library',
    'Cancel any time, for any reason',
  ],
};

const commitments = [
  {
    term: 'Three months',
    save: '',
    blurb: 'The same support, at a lower monthly rate.',
    extras: [
      'One complimentary À La Carte Add-On',
    ],
  },
  {
    term: 'Six months',
    save: '',
    blurb: 'The lowest monthly rate, for a programme being built from the ground up.',
    extras: [
      'Two complimentary À La Carte Add-Ons',
      'On-site visit available at a reduced rate',
    ],
  },
];

const addOnGroups = [
  {
    title: 'Planning and Preparation',
    items: [
      'Custom monthly checklist and planning document',
      'The prepared environment for adolescents: essential pillars, with charts, readings and case studies',
      'Montessori philosophy for the adolescent: guided readings and a reflection packet',
      'Montessori adult preparation documents, for guides and visiting specialists',
    ],
  },
  {
    title: 'Environment Structure',
    items: [
      'How to plan and execute a study and work term',
      'Custom student curriculum map and free curriculum resources list',
      'Complete mathematics curriculum: student maps and self-paced learning',
      'Detailed schedule flows: the first three weeks, the daily flow and the weekly flow, created together',
      'Daily life example guides: meal rituals, responsibilities, meeting agenda and managers',
    ],
  },
  {
    title: 'Administrative',
    items: [
      'Marketing checklist',
      'Student enrollment checklist',
      'Visiting specialists checklist: recruitment of experts',
    ],
  },
  {
    title: 'On-Site Visits',
    items: ['On-site observation, feedback and side-by-side facilitation.'],
  },
];
---

<PageLayout
  title="Partnership"
  description="Monthly Montessori adolescent consulting: guidance calls, planning documents and membership of the Montessori Adolescent Collective, cancel any time. Reduced rates for three or six months."
  heroTitle="Partnership"
  heroImage="/images/guidance-photo-6.jpg"
  heroImagePosition="center 40%"
>
  <div class="container container--narrow">
    <section class="page-section">
      <p class="lede">
        <em>Erdkinder</em>, German for children of the earth, was Maria
        Montessori's vision for adolescent education. She believed young people
        needed more than a classroom: real work, real community, and a real
        connection to the land.
      </p>
      <p>
        Our consulting supports communities ready to bring that vision to life.
        Every consultant holds the AMI 12&ndash;18 Adolescent Diploma and has
        built programs from the ground up.
      </p>
    </section>
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <article class="offer-card">
        <h2 class="offer-title">{plan.name}</h2>
        <p class="plan-included-label">Every month includes</p>
        <ul class="plan-list">
          {plan.included.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section class="page-section">
      <article class="offer-card">
        <h2 class="offer-title">Multi-Month Partnership</h2>
        <p class="commit-intro">More Commitment, Less Money, More Goodies!</p>
        <div class="commit-grid">
          {commitments.map((c) => (
            <div class="commit">
              <p class="commit-term">{c.term}</p>
              <p class="commit-save">{c.save || 'Reduced rate'}</p>
              <p class="commit-blurb">{c.blurb}</p>
              <ul class="commit-list">
                {c.extras.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </article>
    </section>
  </div>

  <div class="container container--narrow">
    <section class="page-section">
      <h2>À La Carte Add-Ons</h2>
      <p class="addon-note">
        <strong>Available to anyone</strong>, whether or not you are in a
        Monthly Partnership. A complimentary 30-minute call is offered with
        Add-Ons that need tailored information.
      </p>
      <div class="addon-grid">
        {addOnGroups.map((group) => (
          <div class="addon-group">
            <h3>{group.title}</h3>
            <ul class="page-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="ready-banner">
    <div class="container ready-inner">
      <p class="ready-eyebrow">Ready to begin?</p>
      <h2 class="ready-title">Every Erdkinder starts with a seed.</h2>
      <p class="ready-sub">
        Tell us where you are and what you are building, and we will take it
        from there.
      </p>
      <a href="/contact/" class="ready-cta">Get in touch</a>
    </div>
  </section>

  <QuoteBanner
    text="The greatest sign of success for a teacher is to be able to say, 'The children are now working as if I did not exist.'"
    author="Maria Montessori"
  />
</PageLayout>

<style>
  /* --- the offer --- */

  .offer-card {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-xl);
    padding: var(--space-3xl) var(--space-2xl) var(--space-2xl);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }


  /* The same short rule the other section headings use. */
  .offer-title::after {
    content: '';
    display: block;
    width: 46px;
    height: 1px;
    margin: var(--space-md) auto 0;
    background: var(--color-terracotta);
  }

  .offer-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin: 0 0 var(--space-xl);
  }



  .plan-included-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .plan-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 34rem;
    text-align: left;
  }

  .plan-list li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }


  .plan-list li::before,
  .commit-list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.42em;
    width: 0.32rem;
    height: 0.62rem;
    border: solid var(--color-terracotta);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  /* --- commitment rates --- */


  .commit-intro {
    font-size: var(--text-lg);
    color: var(--color-earth);
    margin: 0 0 var(--space-xl);
  }

  .commit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 720px) {
    .commit-grid { grid-template-columns: minmax(0, 1fr); }
  }

  .commit {
    /* The card around these centres its text; a ticked list has to sit
       left or the ticks float away from what they tick. */
    text-align: left;
    background: var(--color-cream);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .commit:last-child {
    box-shadow: var(--shadow-sm);
  }

  .commit-term {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    margin: 0 0 0.2rem;
  }

  .commit-save {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-terracotta-dark);
    margin: 0 0 var(--space-md);
  }

  .commit-blurb {
    font-size: var(--text-base);
    color: var(--color-earth);
    margin-bottom: var(--space-md);
  }

  .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .commit-list li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }


  .page-section {
    margin-bottom: var(--space-3xl);
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-lg);
  }

  .page-section p {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .lede {
    font-size: var(--text-xl);
  }

  /* --- tiers --- */



  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: minmax(0, 1fr); }
  }





  /* Sits on its own line with rules above and below, so a price can be
     dropped in later without the layout shifting around it. */








  /* --- add-ons --- */

  .addon-note {
    font-size: var(--text-base);
    color: var(--color-earth);
    margin-bottom: var(--space-xl);
  }

  .addon-note strong {
    color: var(--color-earth-dark);
  }

  .addon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  .addon-group {
    background: var(--color-white);
    border: 1px solid var(--color-terracotta);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .addon-group h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-earth-dark);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .page-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .page-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-terracotta);
  }

  /* --- closing banner --- */

  .ready-banner {
    background: var(--color-earth-dark);
    padding-block: var(--space-4xl);
    text-align: center;
  }

  .ready-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-terracotta-light);
    margin-bottom: var(--space-md);
  }

  .ready-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 300;
    color: var(--color-cream);
    margin-bottom: var(--space-md);
  }

  .ready-sub {
    color: rgba(238, 228, 219, 0.85);
    margin-bottom: var(--space-xl);
  }

  .ready-cta {
    display: inline-block;
    background: var(--color-cream);
    color: var(--color-earth-dark);
    padding: 0.9rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--text-base);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ready-cta:hover {
    background: var(--color-white);
  }
</style>
