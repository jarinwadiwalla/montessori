---
import PageLayout from '../layouts/PageLayout.astro';
import PartnerCard from '../components/partners/PartnerCard.astro';
import { getCollection } from 'astro:content';

const partners = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<PageLayout
  title="Global Partners"
  description="Meet the AMI-trained Montessori guides and global partners advancing Montessori for Adolescents education around the world."
  heroTitle="Our Team"
  heroSubtitle="Our experienced team all carry the AMI 12-18 Adolescent Diploma, and have worked in Adolescent communities all around the globe."
>
  <div class="container">
    <div class="partners-grid">
      {partners.map((partner) => (
        <PartnerCard
          name={partner.data.name}
          title={partner.data.title}
          organization={partner.data.organization}
          location={partner.data.location}
          bio={partner.data.bio}
          website={partner.data.website}
          photo={partner.data.photo}
          linkedin={partner.data.linkedin}
          education={partner.data.education}
        />
      ))}
    </div>

  </div>
</PageLayout>

<style>
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    margin-block: var(--space-3xl) var(--space-4xl);
  }

  @media (max-width: 900px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .partners-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
