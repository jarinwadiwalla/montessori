---
import PageLayout from '../layouts/PageLayout.astro';
import ResourceCard from '../components/resources/ResourceCard.astro';
import WebinarCard from '../components/webinars/WebinarCard.astro';
import { getCollection } from 'astro:content';

const resources = (await getCollection('resources'))
  .filter((r) => !r.data.hidden)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const sortedResources = [
  ...resources.filter((r) => r.data.featured),
  ...resources.filter((r) => !r.data.featured),
];

const webinars = (await getCollection('webinars'))
  .filter((w) => !w.data.hidden)
  .sort(
    (a, b) =>
      (a.data.eventDate?.getTime() ?? Number.MAX_SAFE_INTEGER) -
      (b.data.eventDate?.getTime() ?? Number.MAX_SAFE_INTEGER)
  );

// Upcoming = live events still to come; Past = recordings now for sale on demand.
const upcomingWebinars = webinars.filter((w) => !w.data.recordingAvailable);
const pastWebinars = webinars
  .filter((w) => w.data.recordingAvailable)
  .sort(
    (a, b) =>
      (b.data.eventDate?.getTime() ?? 0) - (a.data.eventDate?.getTime() ?? 0)
  );

const formatEventDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<PageLayout
  title="Resources"
  description="Live webinars and downloadable resources from Montessori for Adolescents — guides, worksheets, and toolkits for implementing Montessori education with ages 12–18."
  heroTitle="Resources"
  heroSubtitle="Live webinars, practical guides, and tools to help create your adolescent community."
  heroImage="/images/Website Banner Photos/Resources.jpg"
>
  <div class="container resources-wrap">

    {upcomingWebinars.length > 0 && (
      <section class="webinars-section">
        <p class="section-eyebrow section-eyebrow--webinars">Upcoming Live Webinars</p>
        <div class="webinars-grid">
          {upcomingWebinars.map((webinar) => (
            <WebinarCard
              title={webinar.data.title}
              description={webinar.data.description}
              price={webinar.data.price}
              href={`/webinars/${webinar.id}/`}
              dateDisplay={webinar.data.eventDate ? formatEventDate(webinar.data.eventDate) : undefined}
              timeDisplay={webinar.data.eventTimeDisplay}
              presenter={webinar.data.presenter}
              image={webinar.data.image}
            />
          ))}
        </div>
      </section>
    )}

    {pastWebinars.length > 0 && (
      <section class="webinars-section">
        <p class="section-eyebrow section-eyebrow--webinars">Past Webinars — Watch the Recording</p>
        <div class="webinars-grid">
          {pastWebinars.map((webinar) => (
            <WebinarCard
              title={webinar.data.title}
              description={webinar.data.description}
              price={webinar.data.recordingPrice ?? webinar.data.price}
              href={`/webinars/${webinar.id}/`}
              dateDisplay={webinar.data.eventDate ? `Recorded ${formatEventDate(webinar.data.eventDate)}` : undefined}
              presenter={webinar.data.presenter}
              image={webinar.data.image}
              isRecording={true}
            />
          ))}
        </div>
      </section>
    )}

    {sortedResources.length > 0 && (
      <section class="downloads-section">
        <p class="section-eyebrow">Downloadable Resources</p>
        <div class="resources-grid">
          {sortedResources.map((resource) => (
            <ResourceCard
              title={resource.data.title}
              description={resource.data.description}
              category={resource.data.category}
              downloadUrl={resource.data.downloadUrl}
              publishDate={resource.data.publishDate}
              featured={resource.data.featured}
            />
          ))}
        </div>
      </section>
    )}

  </div>
</PageLayout>

<style>
  .resources-wrap {
    padding-block: var(--space-3xl);
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(208, 144, 91, 0.85);
    margin-bottom: var(--space-xl);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 0.5px;
    background: #d0905b;
    flex-shrink: 0;
  }

  .section-eyebrow--webinars {
    color: var(--color-purple);
    font-size: 12px;
  }

  .section-eyebrow--webinars::before {
    background: var(--color-purple);
  }

  /* Webinars */
  .webinars-section {
    margin-bottom: var(--space-4xl);
  }

  .webinars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .webinars-grid:has(> :only-child) {
    grid-template-columns: minmax(0, 560px);
  }

  /* Downloads */
  .downloads-section {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  @media (max-width: 900px) {
    .resources-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .webinars-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
