---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroEyebrow?: string;
  heroCta?: string;
  heroCtaHref?: string;
  heroImage?: string;
  heroImagePosition?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, heroTitle, heroSubtitle, heroEyebrow, heroCta, heroCtaHref, heroImage, heroImagePosition, image, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex}>
  <PageHero
    title={heroTitle}
    subtitle={heroSubtitle}
    eyebrow={heroEyebrow}
    ctaLabel={heroCta}
    ctaHref={heroCtaHref}
    image={heroImage}
    imagePosition={heroImagePosition}
  />
  <div class="page-content" id="content">
    <slot />
  </div>
</BaseLayout>

<style>
  .page-content {
    padding-block: var(--space-3xl);
  }
</style>
